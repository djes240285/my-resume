---
export type FailureSymptomIcon = 'legacy' | 'perf' | 'chaos' | 'integrate' | 'business';
export type FailureFixIcon = 'stabilize' | 'migrate' | 'redesign' | 'automate' | 'growth';

interface Props {
  variant: 'symptom' | 'fix';
  name: FailureSymptomIcon | FailureFixIcon;
}

const { variant, name } = Astro.props;
const cls = variant === 'symptom' ? 'mission-failures__ico mission-failures__ico--sym' : 'mission-failures__ico mission-failures__ico--fix';
---

<svg class={cls} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
  {
    variant === 'symptom' && name === 'legacy' && (
      <>
        <path
          d="M7 4.5h10a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1v-13a1 1 0 0 1 1-1z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.2"
        />
        <path d="M8.5 8h7M8.5 11h5" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
        <path d="M14.5 15.5l3 3M17.5 15.5l-3 3" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" />
      </>
    )
  }
  {
    variant === 'symptom' && name === 'perf' && (
      <>
        <circle cx="12" cy="13" r="6.5" fill="none" stroke="currentColor" stroke-width="1.15" />
        <path d="M12 13V8.2" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
        <path d="M12 13l3.2 2" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
        <path d="M9 4.5h6" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
      </>
    )
  }
  {
    variant === 'symptom' && name === 'chaos' && (
      <>
        <rect x="4" y="5" width="7" height="7" rx="0.8" fill="none" stroke="currentColor" stroke-width="1.1" />
        <rect x="13" y="5" width="7" height="7" rx="0.8" fill="none" stroke="currentColor" stroke-width="1.1" stroke-dasharray="2.5 2" />
        <rect x="8.5" y="14" width="7" height="5" rx="0.8" fill="none" stroke="currentColor" stroke-width="1.1" />
      </>
    )
  }
  {
    variant === 'symptom' && name === 'integrate' && (
      <>
        <path
          d="M16.5 8.5a4.5 4.5 0 0 0-7.6-3.2M7.5 15.5a4.5 4.5 0 0 0 7.6 3.2"
          fill="none"
          stroke="currentColor"
          stroke-width="1.15"
          stroke-linecap="round"
        />
        <path d="M14 6.5h3v3M10 17.5H7v-3" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" />
      </>
    )
  }
  {
    variant === 'symptom' && name === 'business' && (
      <>
        <path d="M5 18.5h14" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
        <path
          d="M6.5 14.5 L9.5 11 L12 13 L15.5 8.5 L18 6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.15"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path d="M6 18.5V11M10 18.5V9M14 18.5V12.5M18 18.5V6" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
      </>
    )
  }
  {
    variant === 'fix' && name === 'stabilize' && (
      <>
        <circle cx="12" cy="12" r="2.2" fill="none" stroke="currentColor" stroke-width="1.1" />
        <circle cx="12" cy="12" r="6" fill="none" stroke="currentColor" stroke-width="1.1" />
        <path d="M12 4v2M12 18v2M4 12h2M18 12h2" fill="none" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
      </>
    )
  }
  {
    variant === 'fix' && name === 'migrate' && (
      <>
        <rect x="5" y="6" width="14" height="12" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.1" />
        <path d="M8 9.5h8M8 12.5h6M8 15.5h4" fill="none" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
        <path d="M12 3.5v2.5" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
      </>
    )
  }
  {
    variant === 'fix' && name === 'redesign' && (
      <>
        <rect x="4.5" y="5" width="5.5" height="4.5" rx="0.7" fill="none" stroke="currentColor" stroke-width="1.05" />
        <rect x="14" y="5" width="5.5" height="4.5" rx="0.7" fill="none" stroke="currentColor" stroke-width="1.05" />
        <rect x="9.25" y="14.5" width="5.5" height="4.5" rx="0.7" fill="none" stroke="currentColor" stroke-width="1.05" />
        <path d="M7.25 9.5 L9.5 12 M14.75 9.5 L12.5 12 M12 12v2.5" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
      </>
    )
  }
  {
    variant === 'fix' && name === 'automate' && (
      <>
        <path
          d="M8.5 11.5a3.5 3.5 0 1 1 0-7h7a3.5 3.5 0 1 1 0 7h-7z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.1"
        />
        <circle cx="12" cy="8" r="1.1" fill="currentColor" />
        <path d="M9.5 16.5h5M12 14v2.5" fill="none" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
      </>
    )
  }
  {
    variant === 'fix' && name === 'growth' && (
      <>
        <circle cx="12" cy="12" r="6.5" fill="none" stroke="currentColor" stroke-width="1.1" />
        <path d="M8.5 13.5 L11 10.5 L13.5 12 L15.5 8.5" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M14 9h2v2" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
      </>
    )
  }
</svg>
