---
/**
 * Оверлей «видоискатель» — только при hover у родителя .avatar-terminal-group
 */
---

<svg
  class="avatar-terminal-viewfinder"
  viewBox="0 0 320 320"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <style>
      .vf-txt {
        font-family: "JetBrains Mono Variable", ui-monospace, monospace;
      }
    </style>
  </defs>

  <!-- Экран: светлая область с рамкой -->
  <rect
    x="20"
    y="22"
    width="280"
    height="214"
    rx="12"
    ry="12"
    fill="rgba(250, 250, 250, 0.88)"
    stroke="#0f172a"
    stroke-width="2.5"
  />

  <!-- Крупные угловые скобы -->
  <g fill="none" stroke="#0f172a" stroke-width="5" stroke-linecap="square" stroke-linejoin="miter">
    <path d="M 56 22 L 20 22 L 20 58" />
    <path d="M 264 22 L 300 22 L 300 58" />
    <path d="M 56 236 L 20 236 L 20 200" />
    <path d="M 264 236 L 300 236 L 300 200" />
  </g>

  <!-- Таймер -->
  <text class="vf-txt" x="34" y="52" fill="#0f172a" font-size="15" font-weight="600">00:00:00</text>

  <!-- Центральный прицел / зона фокуса -->
  <g fill="none" stroke="#0f172a" stroke-width="2.2" stroke-linecap="square">
    <path d="M 152 128 L 136 128 L 136 112" />
    <path d="M 168 128 L 184 128 L 184 112" />
    <path d="M 152 128 L 136 128 L 136 144" />
    <path d="M 168 128 L 184 128 L 184 144" />
  </g>
  <circle cx="160" cy="128" r="7" fill="none" stroke="#0f172a" stroke-width="1.8" />

  <!-- Нижняя панель OSD -->
  <rect x="20" y="236" width="280" height="62" rx="0" fill="#0a0a0a" />
  <text class="vf-txt" x="160" y="268" fill="#e2e8f0" font-size="11" font-weight="600" text-anchor="middle">
    3 · 2 · 1 · I · 1 · 2 · 3
  </text>
  <!-- Индикатор экспозиции -->
  <path d="M 156 272 L 160 278 L 164 272 Z" fill="#94a3b8" stroke="none" />

  <!-- Батарея -->
  <rect x="34" y="284" width="22" height="10" rx="2" fill="none" stroke="#94a3b8" stroke-width="1.2" />
  <rect x="36" y="286" width="14" height="6" rx="1" fill="#22c55e" />
  <rect x="56" y="287" width="2" height="4" fill="#94a3b8" />

  <!-- Вспышка -->
  <path
    d="M 274 284 L 278 292 L 276 292 L 282 302 L 276 298 L 278 306 L 268 294 L 272 294 L 268 286 Z"
    fill="#f1f5f9"
    stroke="#0f172a"
    stroke-width="0.5"
  />
</svg>
