        },
        {
          title: 'Magento Resuscitation: evolve without sales freeze',
          tag: 'Legacy & Stability',
          problem:
            'A 5-year custom-heavy Magento 1.4 system with high DB risk and a realistic threat of revenue loss during upgrade.',
          action:
            'Audited critical nodes, isolated risky zones, and executed phased migration to Magento 2.4 with compatibility controls.',
          result:
            'The platform moved to a modern contour without interrupting commercial operations, while the team gained a maintainable architecture.',
          tags: ['all', 'migrations', 'enterprise', 'process'],
          score: 999,
          priority: 120,
          hasMedia: false,
          mediaSlides: [],
        },
        {
          title: 'Tech debt to profit: windowcleaner.com',
          tag: 'Profit Architect',
          href: 'https://windowcleaner.com/',
          problem:
            'Chaotic production edits were degrading performance and making delivery unpredictable.',
          action:
            'Built a controlled delivery contour: Docker environment, CI/CD, release discipline, and behavior-driven UX optimization.',
          result:
            'The platform has scaled and remained stable for 5+ years, with release cycles producing measurable commercial impact.',
          tags: ['all', 'ecom', 'process', 'enterprise'],
          score: 998,
          priority: 118,
          hasMedia: false,
          mediaSlides: [],
        },
        {
          title: 'Interface precision: Pixel Perfect + high-load',
          tag: 'AI & Automation',
          problem:
            'High complexity UI (PWA/XenForo/ScandiPWA): 100% fidelity to design while keeping performance under load.',
          action:
            'Implemented a Pixel Perfect layer and custom addons with modular architecture and automated validation routines.',
          result:
            'UI matches Figma exactly, delivery remains fast, and architecture stays growth-ready. Details are presented NDA-safe.',
          tags: ['all', 'process', 'enterprise'],
          score: 997,
          priority: 116,
          hasMedia: false,
          mediaSlides: [],
          ndaSafe: true,
        },
      ];

const curatedShowcase = [...featuredLayer, ...showcase].map((card) => {
  const titleLc = card.title.toLowerCase();
  const raw = `${card.title} ${card.problem} ${card.action} ${card.result}`.toLowerCase();
  const rescue = card.rescue ?? ((card.tags.includes('migrations') || card.tags.includes('enterprise')));
  const aiEnhanced =
    card.aiEnhanced ??
    /(ai|automation|agent|pwa|graphql|xenforo|scandipwa|pixel perfect)/.test(raw);
  const status = card.status ?? (rescue ? 'stabilized' : 'delivery');
  const challenges = card.challenges ?? inferChallenges(lang, titleLc, card.problem, card.action);
  const slug = card.slug ?? caseSlug(card.title);
  const stack = card.stack ?? inferStack(titleLc, card.tags, lang);
  return { ...card, slug, stack, rescue, aiEnhanced, status, challenges };
});
---

<main class="portfolio-page" data-portfolio-root data-portfolio-mode="legacy">
  <header class="">
    <p class="text-xs font-bold uppercase tracking-widest text-cyan-300">
      {labels.section}
    </p>
    <h1 class="retro-heading-soft mt-2 text-3xl font-bold tracking-tight text-slate-100 sm:text-4xl">{p.title}</h1>
    <p class="mt-3 max-w-3xl text-pretty text-base leading-relaxed text-slate-300">{p.lead}</p>
  </header>

  <section class="mt-10">
    <h2 class="retro-heading-soft text-sm font-bold uppercase tracking-wider text-cyan-300">{p.introTitle}</h2>
    <p class="mt-3 max-w-prose leading-relaxed text-slate-300">{p.introBody}</p>
  </section>

  <section class="mt-8 rounded-lg border border-cyan-500/25 bg-slate-900/95 p-4 sm:p-5" data-layer-switch>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="retro-heading-soft text-sm font-bold uppercase tracking-wider text-cyan-300">
        {labels.expertiseTitle}
      </h2>
      <div class="flex flex-wrap gap-2">
        <button type="button" class="rounded border border-cyan-500/45 bg-cyan-500/10 px-2.5 py-1 text-xs font-mono text-cyan-200" data-layer-mode-btn="legacy">
          {labels.modeLegacy}
        </button>
        <button type="button" class="rounded border border-slate-700 px-2.5 py-1 text-xs font-mono text-slate-300 hover:border-cyan-500/45" data-layer-mode-btn="profit">
          {labels.modeProfit}
        </button>
        <button type="button" class="rounded border border-slate-700 px-2.5 py-1 text-xs font-mono text-slate-300 hover:border-cyan-500/45" data-layer-mode-btn="ai">
          {labels.modeAi}
        </button>
      </div>
    </div>
    <p class="mt-3 text-sm text-slate-300" data-layer-mode-panel="legacy">
      {labels.modeLegacyDesc}
    </p>
    <p class="mt-3 hidden text-sm text-slate-300" data-layer-mode-panel="profit">
      {labels.modeProfitDesc}
    </p>
    <p class="mt-3 hidden text-sm text-slate-300" data-layer-mode-panel="ai">
      {labels.modeAiDesc}
    </p>
    <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
      <div class="rounded border border-slate-800 bg-slate-950/70 p-3 text-xs text-slate-300">
        <p class="font-mono uppercase tracking-wide text-cyan-300">{labels.packageLegacyTitle}</p>
        <p class="mt-1">{labels.packageLegacyBody}</p>
      </div>
      <div class="rounded border border-slate-800 bg-slate-950/70 p-3 text-xs text-slate-300">
        <p class="font-mono uppercase tracking-wide text-cyan-300">{labels.packageProfitTitle}</p>
        <p class="mt-1">{labels.packageProfitBody}</p>
      </div>
      <div class="rounded border border-slate-800 bg-slate-950/70 p-3 text-xs text-slate-300">
        <p class="font-mono uppercase tracking-wide text-cyan-300">{labels.packageInterfaceTitle}</p>
        <p class="mt-1">{labels.packageInterfaceBody}</p>
      </div>
    </div>
  </section>

  <section class="mt-10">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">{labels.filtersTitle}:</span>
      <button class="rounded border border-cyan-500/45 bg-cyan-500/10 px-2.5 py-1 text-xs font-mono text-cyan-200" data-case-filter-btn="all">{labels.all}</button>
      <button class="rounded border border-slate-700 px-2.5 py-1 text-xs font-mono text-slate-300 hover:border-cyan-500/45" data-case-filter-btn="ecom">{labels.ecom}</button>
      <button class="rounded border border-slate-700 px-2.5 py-1 text-xs font-mono text-slate-300 hover:border-cyan-500/45" data-case-filter-btn="enterprise">{labels.enterprise}</button>
      <button class="rounded border border-slate-700 px-2.5 py-1 text-xs font-mono text-slate-300 hover:border-cyan-500/45" data-case-filter-btn="migrations">{labels.migrations}</button>
      <button class="rounded border border-slate-700 px-2.5 py-1 text-xs font-mono text-slate-300 hover:border-cyan-500/45" data-case-filter-btn="process">{labels.process}</button>
    </div>
    <p
      class="mode-story mt-3 rounded border border-violet-500/30 bg-violet-500/10 px-3 py-2 text-xs leading-relaxed text-violet-100"
      data-mode-story
      data-story-legacy={labels.storyLegacy}
      data-story-profit={labels.storyProfit}
      data-story-ai={labels.storyAi}
    >
      {labels.storyLegacy}
    </p>
  </section>

  <section class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[3fr_1.2fr]">
    <div class="space-y-4">
      {curatedShowcase.map((card) => (
        <article
          id={`case-${card.slug}`}
          class="case-card case-card--incident case-card--postmortem retro-panel-soft lift-2026"
          data-case-card
          data-case-tags={card.tags.join(',')}
          style="order:0"
        >
          <div class="case-card__veil" aria-hidden="true"></div>
          <div class="case-card__veil case-card__veil--bloom" aria-hidden="true"></div>

          <p class="case-incident__label">{labels.postMortemLabel}</p>

          <header class="case-card__hero">
            <h3
              class="case-card__title"
              data-case-title
              data-title-base={card.title}
              data-title-legacy={narrativeTitle(card, 'legacy', lang)}
              data-title-profit={narrativeTitle(card, 'profit', lang)}
              data-title-ai={narrativeTitle(card, 'ai', lang)}
            >
              {card.title}
            </h3>
            <div class="case-card__badges">
              {card.rescue ? <span class="case-badge case-badge--rescue">{labels.badgeRescue}</span> : null}
              {card.aiEnhanced ? <span class="case-badge case-badge--ai">{labels.badgeAiEnhanced}</span> : null}
              {card.status === 'stabilized' ? (
                <span class="case-badge case-badge--stable">{labels.badgeStabilized}</span>
              ) : null}
              {card.ndaSafe ? <span class="case-badge case-badge--nda">{labels.ndaBadge}</span> : null}
              <span class="case-badge case-badge--period">
                {labels.periodLabel}: {card.tag}
              </span>
            </div>
          </header>

          <div class="case-card__grid">
            <div class="case-card__main">
              <dl class="case-incident__layers">
                <div class="case-layer">
                  <dt>
                    <span class="case-layer__tag">[{labels.layerTarget}]</span>
                  </dt>
                  <dd class="case-layer__body">
                    {card.title}
                    {card.tag ? <span class="case-incident__meta"> · {card.tag}</span> : null}
                  </dd>
                </div>
                <div class="case-layer">
                  <dt>
                    <span class="case-layer__tag">[{labels.layerDiagnosis}]</span>
                  </dt>
                  <dd class="case-layer__body">{card.problem}</dd>
                </div>
                <div class="case-layer">
                  <dt>
                    <span class="case-layer__tag">[{labels.layerOperation}]</span>
                  </dt>
                  <dd class="case-layer__body">{card.action}</dd>
                </div>
                <div class="case-layer">
                  <dt>
                    <span class="case-layer__tag">[{labels.layerMetrics}]</span>
                  </dt>
                  <dd class="case-layer__body case-layer__body--metrics">{card.result}</dd>
                </div>
                <div class="case-layer">
                  <dt>
                    <span class="case-layer__tag">[{labels.layerStack}]</span>
                  </dt>
                  <dd class="case-layer__body case-layer__body--stack">{card.stack}</dd>
                </div>
              </dl>

              {card.challenges?.length ? (
                <div class="case-incident-log">
                  <div class="case-incident-log__chrome">
                    <span class="case-incident-log__lights" aria-hidden="true">
                      <i></i><i></i><i></i>
                    </span>
                    <span class="case-incident-log__head">{labels.challengeTitle}</span>
                  </div>
                  <ul class="case-incident-log__list">
                    {card.challenges.slice(0, 2).map((c) => (
                      <li class="case-incident-log__entry">
                        <div class="case-incident-log__row case-incident-log__row--broken">
                          <span class="case-incident-log__marker" aria-hidden="true"></span>
                          <div>
                            <span class="case-incident-log__label">{labels.challengeBroken}:</span>
                            <p class="case-incident-log__text">{c.broken}</p>
                          </div>
                        </div>
                        <div class="case-incident-log__row case-incident-log__row--fixed">
                          <span class="case-incident-log__marker case-incident-log__marker--arrow" aria-hidden="true">→</span>
                          <div>
                            <span class="case-incident-log__label">{labels.challengeFixed}:</span>
                            <p class="case-incident-log__text">{c.fixed}</p>
                          </div>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : null}

              <footer class="case-card__footer">
                {card.href ? (
                  <a
                    href={card.href}
                    target="_blank"
                    rel="noreferrer noopener"
                    class="case-card__cta"
                    data-case-cta
                    data-cta-base={labels.openCase}
                    data-cta-legacy={labels.ctaLegacy}
                    data-cta-profit={labels.ctaProfit}
                    data-cta-ai={labels.ctaAi}
                    data-cta-glyph-legacy={labels.ctaLegacyGlyph}
                    data-cta-glyph-profit={labels.ctaProfitGlyph}
                    data-cta-glyph-ai={labels.ctaAiGlyph}
                  >
                    <span class="case-cta__glyph" data-case-cta-glyph>{labels.ctaLegacyGlyph}</span>
                    <span data-case-cta-text>{labels.openCase}</span>
                  </a>
                ) : (
                  <span class="case-card__cta case-card__cta--muted">{labels.openDetails}</span>
                )}
              </footer>
            </div>

            <div class="case-card__viz">
              {card.hasMedia ? (
                <div class="case-media case-media--mockup" data-case-media>
                  <div class="case-media__mockup-bar" aria-hidden="true">
                    <span></span><span></span><span></span>
                  </div>
                  <img
                    src={card.mediaSlides[0]}
                    alt={card.title}
                    loading="lazy"
                    decoding="async"
                    class="case-media__img"
                    data-case-media-img
                    data-case-media-index="0"
                  />
                  <div class="case-media__controls">
                    <button type="button" class="case-media__btn" data-case-media-prev>{labels.prevSlide}</button>
                    <button type="button" class="case-media__btn" data-case-media-next>{labels.nextSlide}</button>
                  </div>
                  <div class="case-media__slides" hidden>{card.mediaSlides.join('|')}</div>
                </div>
              ) : (
                <CaseInfraSchema slug={card.slug} title={labels.schemaTitle} />
              )}
            </div>
          </div>

          <span class="case-card__corner" aria-hidden="true">✦</span>
        </article>
      ))}
    </div>
    <aside class="rounded-lg border border-cyan-500/25 bg-slate-900/95 p-0 shadow-sm">
      <div class="flex items-center justify-between border-b border-cyan-500/20 bg-slate-950/80 px-4 py-2">
        <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-cyan-300">{labels.workStyle}</h2>
        <span class="font-mono text-[11px] text-emerald-300">{labels.runbookTitle}</span>
      </div>
      <div class="p-4">
        <div class="mb-3 rounded border border-emerald-500/30 bg-emerald-500/8 px-2.5 py-2">
          <p class="font-mono text-[11px] uppercase tracking-wide text-emerald-300">
            {labels.metricsTrustTitle}
          </p>
          <ul class="mt-1 space-y-1 text-[12px] leading-relaxed text-slate-300">
            {labels.metricsTrustItems.map((item) => (
              <li>• {item}</li>
            ))}
          </ul>
        </div>
        <p class="text-sm leading-relaxed text-slate-300">{labels.workStyleLead}</p>
        <ol class="mt-3 space-y-2">
          {labels.steps.map((s) => (
            <li class="rounded border border-slate-800 bg-slate-950/70 px-2.5 py-2 font-mono text-xs text-slate-200">
              <p>
                <span class="mr-2 text-cyan-300">$</span>{s.cmd}
                <span class="ml-2 text-[10px] font-semibold tracking-wide text-emerald-300/95">
                  {s.status === 'done' ? labels.statusDone : s.status === 'progress' ? labels.statusProgress : labels.statusReady}
                </span>
              </p>
              <p class="mt-1.5 font-sans text-[12px] leading-relaxed text-slate-300">{s.outcome}</p>
            </li>
          ))}
        </ol>
        <div class="mt-3 rounded border border-amber-500/30 bg-amber-500/8 px-2.5 py-2">
          <p class="font-mono text-[11px] uppercase tracking-wide text-amber-300">{labels.noFitTitle}</p>
          <p class="mt-1 text-[12px] leading-relaxed text-slate-300">{labels.noFitBody}</p>
        </div>
      </div>
    </aside>
  </section>

  <section class="portfolio-diagnostic mt-12" aria-labelledby="portfolio-diagnostic-title">
    <p class="portfolio-diagnostic__prompt font-mono text-sm text-emerald-400/90" aria-hidden="true">
      &gt; {labels.diagnosticTitle}
    </p>
    <h2 id="portfolio-diagnostic-title" class="sr-only">{labels.diagnosticTitle}</h2>
    <p class="portfolio-diagnostic__body mt-3 max-w-2xl text-pretty text-base leading-relaxed text-slate-300">
      {labels.diagnosticBody}
    </p>
    <a
      class="portfolio-diagnostic__cta mission-btn mission-btn--primary mt-5"
      href={`mailto:${cv.contact.emails[0]}?subject=${encodeURIComponent(labels.mailSubject)}`}
    >
      {labels.diagnosticCta}
    </a>
  </section>

  <p class="mt-10 text-center">
    <a href={siteMissionHref(lang)} class="mr-4 text-sm text-slate-500 hover:text-cyan-300">
      {labels.backToMission}
    </a>
    {
      SITE_SHOW_RESUME ? (
        <a
          href={`/${lang}/`}
          class="lift-2026 inline-flex items-center justify-center rounded-full border border-slate-700 bg-slate-900 px-6 py-3 text-sm font-semibold text-slate-100 shadow transition hover:border-cyan-400 hover:text-cyan-300"
        >
          {p.ctaResume}
        </a>
      ) : null
    }
  </p>
</main>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var btns = Array.from(document.querySelectorAll('[data-case-filter-btn]'));
    var cards = Array.from(document.querySelectorAll('[data-case-card]'));
    if (!btns.length || !cards.length) return;

    function applyFilter(filter: 'all' | 'ecom' | 'enterprise' | 'migrations' | 'process') {
      cards.forEach(function (card) {
        var tags = (card.getAttribute('data-case-tags') || '').split(',');
        var show = filter === 'all' || tags.indexOf(filter) >= 0;
        card.classList.toggle('case-card--hidden', !show);
      });
      btns.forEach(function (btn) {
        var on = btn.getAttribute('data-case-filter-btn') === filter;
        btn.classList.toggle('border-cyan-500/45', on);
        btn.classList.toggle('bg-cyan-500/10', on);
        btn.classList.toggle('text-cyan-200', on);
        if (!on) {
          btn.classList.remove('border-cyan-500/45', 'bg-cyan-500/10', 'text-cyan-200');
          btn.classList.add('border-slate-700', 'text-slate-300');
        } else {
          btn.classList.remove('border-slate-700', 'text-slate-300');
        }
      });
    }

    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        applyFilter((btn.getAttribute('data-case-filter-btn') || 'all') as 'all' | 'ecom' | 'enterprise' | 'migrations' | 'process');
      });
    });
    cards.forEach(function (card) {
      card.classList.remove('case-card--hidden');
    });
    applyFilter('all');

    var modeBtns = Array.from(document.querySelectorAll('[data-layer-mode-btn]'));
    var panels = Array.from(document.querySelectorAll('[data-layer-mode-panel]'));
    var portfolioRoot = document.querySelector('[data-portfolio-root]');
    function applyMode(mode: 'legacy' | 'profit' | 'ai') {
      if (portfolioRoot instanceof HTMLElement) {
        portfolioRoot.setAttribute('data-portfolio-mode', mode);
      }
      modeBtns.forEach(function (btn) {
        var on = btn.getAttribute('data-layer-mode-btn') === mode;
        btn.classList.toggle('border-cyan-500/45', on);
        btn.classList.toggle('bg-cyan-500/10', on);
        btn.classList.toggle('text-cyan-200', on);
        if (!on) {
          btn.classList.remove('border-cyan-500/45', 'bg-cyan-500/10', 'text-cyan-200');
          btn.classList.add('border-slate-700', 'text-slate-300');
        } else {
          btn.classList.remove('border-slate-700', 'text-slate-300');
        }
      });
      panels.forEach(function (panel) {
        var show = panel.getAttribute('data-layer-mode-panel') === mode;
        panel.classList.toggle('hidden', !show);
      });
      var story = document.querySelector('[data-mode-story]');
      if (story instanceof HTMLElement) {
        var key = mode === 'legacy' ? 'data-story-legacy' : mode === 'profit' ? 'data-story-profit' : 'data-story-ai';
        var nextStory = story.getAttribute(key);
        if (nextStory) story.textContent = nextStory;
      }

      function getOrder(tags: string[]) {
        if (mode === 'legacy') {
          if (tags.indexOf('migrations') >= 0) return 0;
          if (tags.indexOf('enterprise') >= 0) return 1;
          if (tags.indexOf('process') >= 0) return 2;
          return 3;
        }
        if (mode === 'profit') {
          if (tags.indexOf('ecom') >= 0) return 0;
          if (tags.indexOf('process') >= 0) return 1;
          if (tags.indexOf('enterprise') >= 0) return 2;
          return 3;
        }
        if (tags.indexOf('process') >= 0) return 0;
        if (tags.indexOf('enterprise') >= 0) return 1;
        if (tags.indexOf('migrations') >= 0) return 2;
        return 3;
      }

      cards.forEach(function (card) {
        var tags = (card.getAttribute('data-case-tags') || '').split(',');
        var order = getOrder(tags);
        (card as HTMLElement).style.order = String(order);
        var title = card.querySelector('[data-case-title]');
        if (title instanceof HTMLElement) {
          var attr = mode === 'legacy' ? 'data-title-legacy' : mode === 'profit' ? 'data-title-profit' : 'data-title-ai';
          var nextTitle = title.getAttribute(attr) || title.getAttribute('data-title-base');
          if (nextTitle) title.textContent = nextTitle;
        }
        var cta = card.querySelector('[data-case-cta]');
        if (cta instanceof HTMLElement) {
          var ctaAttr = mode === 'legacy' ? 'data-cta-legacy' : mode === 'profit' ? 'data-cta-profit' : 'data-cta-ai';
          var nextCta = cta.getAttribute(ctaAttr) || cta.getAttribute('data-cta-base');
          var ctaText = cta.querySelector('[data-case-cta-text]');
          if (nextCta && ctaText instanceof HTMLElement) ctaText.textContent = nextCta;
          var glyphAttr =
            mode === 'legacy' ? 'data-cta-glyph-legacy' : mode === 'profit' ? 'data-cta-glyph-profit' : 'data-cta-glyph-ai';
          var nextGlyph = cta.getAttribute(glyphAttr);
          var ctaGlyph = cta.querySelector('[data-case-cta-glyph]');
          if (nextGlyph && ctaGlyph instanceof HTMLElement) ctaGlyph.textContent = nextGlyph;
        }
      });

      var preferredFilter: 'all' | 'ecom' | 'enterprise' | 'migrations' | 'process' = 'all';
      if (mode === 'legacy') preferredFilter = 'migrations';
      if (mode === 'profit') preferredFilter = 'ecom';
      if (mode === 'ai') preferredFilter = 'process';
      applyFilter(preferredFilter);
    }
    modeBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        applyMode((btn.getAttribute('data-layer-mode-btn') || 'legacy') as 'legacy' | 'profit' | 'ai');
      });
    });

    /** Deep-link #case-*: режим legacy включает фильтр migrations и скрывает часть карточек. */
    function scrollToCaseHash() {
      var raw = window.location.hash;
      if (!raw || raw.charAt(0) !== '#') return;
      var id = raw.slice(1);
      if (id.indexOf('case-') !== 0) return;
      var el = document.getElementById(id);
      if (!(el instanceof HTMLElement) || !el.classList.contains('case-card')) return;

      applyFilter('all');
      el.classList.remove('case-card--hidden');

      var reduce =
        typeof window.matchMedia !== 'undefined' &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function go() {
        el.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : 'smooth' });
      }
      requestAnimationFrame(function () {
        requestAnimationFrame(go);
      });
    }

    applyMode('legacy');
    scrollToCaseHash();
    window.addEventListener('hashchange', scrollToCaseHash);

    var mediaBlocks = Array.from(document.querySelectorAll('[data-case-media]'));
    mediaBlocks.forEach(function (block) {
      var img = block.querySelector('[data-case-media-img]');
      var raw = block.querySelector('.case-media__slides');
      var prev = block.querySelector('[data-case-media-prev]');
      var next = block.querySelector('[data-case-media-next]');
      if (!(img instanceof HTMLImageElement) || !(raw instanceof HTMLElement) || !(prev instanceof HTMLButtonElement) || !(next instanceof HTMLButtonElement)) return;
      var imageEl = img;
      var slides = (raw.textContent || '').split('|').filter(Boolean);
      if (slides.length < 2) {
        prev.setAttribute('disabled', '');
        next.setAttribute('disabled', '');
        return;
      }
      var idx = Number(imageEl.getAttribute('data-case-media-index') || '0');
      function paint() {
        imageEl.src = slides[idx] || slides[0];
        imageEl.setAttribute('data-case-media-index', String(idx));
      }
      prev.addEventListener('click', function () {
        idx = (idx - 1 + slides.length) % slides.length;
        paint();
      });
      next.addEventListener('click', function () {
        idx = (idx + 1) % slides.length;
        paint();
      });
    });
  });
</script>
