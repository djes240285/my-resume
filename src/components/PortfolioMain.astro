---
import type { Lang } from '../i18n/cv-data';
import { getCv } from '../i18n/cv-data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = getCv(lang).portfolio;
---

<main class="mx-auto max-w-5xl px-4 pb-16 pt-8 sm:px-6 sm:pt-12">
  <header class="reveal-2026 border-b border-slate-800 pb-10">
    <p class="text-xs font-bold uppercase tracking-widest text-cyan-300">
      {lang === 'ru' ? 'Раздел сайта' : 'Site section'}
    </p>
    <h1 class="retro-heading-soft mt-2 text-3xl font-bold tracking-tight text-slate-100 sm:text-4xl">{p.title}</h1>
    <p class="mt-4 max-w-2xl text-pretty text-base leading-relaxed text-slate-300">{p.lead}</p>
  </header>

  <section class="reveal-2026 mt-12 border-t border-slate-800 pt-10" style="--reveal-delay: 70ms">
    <h2 class="retro-heading-soft text-sm font-bold uppercase tracking-wider text-cyan-300">{p.introTitle}</h2>
    <p class="mt-3 max-w-prose leading-relaxed text-slate-300">{p.introBody}</p>
  </section>

  <section class="reveal-2026 mt-12" style="--reveal-delay: 110ms">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {p.cards.map((card) => (
        <article class="retro-panel-soft lift-2026 flex flex-col rounded-lg border border-slate-800 bg-slate-900 p-5 shadow-sm">
          <span class="text-xs font-semibold uppercase tracking-wide text-emerald-300">{card.tag}</span>
          <h3 class="mt-2 text-lg font-bold text-slate-100">{card.title}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-300">{card.body}</p>
          {card.href && (
            <a
              href={card.href}
              target="_blank"
              rel="noreferrer noopener"
              class="mt-4 inline-flex text-sm font-semibold text-cyan-300 underline decoration-slate-500 underline-offset-4 hover:text-cyan-200"
            >
              {lang === 'ru' ? 'Открыть кейс' : 'Open case'}
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  <p class="mt-12 text-center">
    <a
      href={`/${lang}/`}
      class="lift-2026 inline-flex items-center justify-center rounded-full border border-slate-700 bg-slate-900 px-6 py-3 text-sm font-semibold text-slate-100 shadow transition hover:border-cyan-400 hover:text-cyan-300"
    >
      {p.ctaResume}
    </a>
  </p>
</main>
