---
import type { Lang } from '../i18n/cv-data';
import { getCv } from '../i18n/cv-data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = getCv(lang).portfolio;
---

<main class="mx-auto max-w-5xl px-4 pb-16 pt-8 sm:px-6 sm:pt-12">
  <header class="reveal-2026 border-b border-slate-200 pb-10">
    <p class="text-xs font-bold uppercase tracking-widest text-navy-800">
      {lang === 'ru' ? 'Раздел сайта' : 'Site section'}
    </p>
    <h1 class="retro-heading-soft mt-2 text-3xl font-bold tracking-tight text-navy-900 sm:text-4xl">{p.title}</h1>
    <p class="mt-4 max-w-2xl text-pretty text-base leading-relaxed text-slate-600">{p.lead}</p>
  </header>

  <section class="reveal-2026 mt-12 border-t border-slate-200 pt-10" style="--reveal-delay: 70ms">
    <h2 class="retro-heading-soft text-sm font-bold uppercase tracking-wider text-navy-900">{p.introTitle}</h2>
    <p class="mt-3 max-w-prose leading-relaxed text-slate-700">{p.introBody}</p>
  </section>

  <section class="reveal-2026 mt-12" style="--reveal-delay: 110ms">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {p.cards.map((card) => (
        <article class="retro-panel-soft lift-2026 flex flex-col rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <span class="text-xs font-semibold uppercase tracking-wide text-navy-800">{card.tag}</span>
          <h3 class="mt-2 text-lg font-bold text-navy-900">{card.title}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{card.body}</p>
          {card.href && (
            <a
              href={card.href}
              target="_blank"
              rel="noreferrer noopener"
              class="mt-4 inline-flex text-sm font-semibold text-navy-900 underline decoration-slate-300 underline-offset-4 hover:decoration-navy-800"
            >
              {lang === 'ru' ? 'Открыть кейс' : 'Open case'}
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  <p class="mt-12 text-center">
    <a
      href={`/${lang}/`}
      class="lift-2026 inline-flex items-center justify-center rounded-full bg-navy-900 px-6 py-3 text-sm font-semibold text-white shadow transition hover:bg-navy-800"
    >
      {p.ctaResume}
    </a>
  </p>
</main>
