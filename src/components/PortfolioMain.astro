function formatExternalSiteCta(
  href: string,
  lang: Lang
): { text: string; ariaLabel: string; title: string } {
  try {
    const host = new URL(href).hostname.replace(/^www\./i, '');
    if (lang === 'ru') {
      return {
        text: `Открыть сайт ${host} ↗`,
        ariaLabel: `Открыть сайт ${host} в новой вкладке`,
        title: 'Живой сайт проекта · новая вкладка',
      };
    }
    return {
      text: `Open ${host} ↗`,
      ariaLabel: `Open ${host} in a new tab`,
      title: 'Live project site · new tab',
    };
  } catch {
    return lang === 'ru'
      ? {
          text: 'Открыть сайт ↗',
          ariaLabel: 'Открыть сайт в новой вкладке',
          title: 'Новая вкладка',
        }
      : {
          text: 'Open site ↗',
          ariaLabel: 'Open site in a new tab',
          title: 'New tab',
        };
  }
}
