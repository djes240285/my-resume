      const inferred = inferPortfolioMeta(card.title, `${card.problem} ${card.action}`, '');
      const tags = card.tags.length > 1 ? card.tags : inferred.tags;
      const portfolioModes = card.portfolioModes ?? inferred.modes;
      const rescue = card.rescue ?? inferred.rescue;
      const aiEnhanced = card.aiEnhanced ?? inferred.aiEnhanced;
      const status = card.status ?? (rescue ? 'stabilized' : 'delivery');
      const challenges = card.challenges ?? inferChallenges(lang, titleLc, card.problem, card.action);
      const slug = card.slug ?? caseSlug(card.title);
