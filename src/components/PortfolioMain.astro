          {
            broken: 'Three separate apps duplicated data and broke process consistency.',
            fixed: 'A unified integration contour with synchronized flows and ownership boundaries was built.',
          },
          {
            broken: 'High manual workload and slow change approvals.',
            fixed: 'Critical workflows were automated to speed up safe feature rollout.',
          },
        ];
  }
  return lang === 'ru'
    ? [
        { broken: problem, fixed: action },
        {
          broken: 'Нужна была прозрачность рисков и предсказуемость релизов.',
            fixed: 'Добавлен пошаговый контур поставки с контролем качества и устойчивости.',
        },
      ]
    : [
        { broken: problem, fixed: action },
        {
          broken: 'Risk visibility and predictable releases were missing.',
          fixed: 'A phased delivery contour with quality and stability controls was introduced.',
        },
      ];
}

function narrativeTitle(
  card: ShowcaseCard,
  mode: 'legacy' | 'profit' | 'ai',
  lang: Lang
): string {
  if (mode === 'legacy') {
    return lang === 'ru' ? `Реанимация системы: ${card.title}` : `System rescue: ${card.title}`;
  }
  if (mode === 'profit') {
    return lang === 'ru' ? `Экономика результата: ${card.title}` : `Result economics: ${card.title}`;
  }
  return lang === 'ru' ? `ИИ-контур: ${card.title}` : `AI-accelerated delivery: ${card.title}`;
}

