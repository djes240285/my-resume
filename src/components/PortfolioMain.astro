      } else {
        problem =
          'Closed contours without public URLs (energy, fitness, education)—one résumé line instead of separate links.';
        action =
          'See 102 PES, Gagarin, medical call center, and related partner cases above: monitoring, admin tooling, integrations.';
        result =
          'Not a standalone project—a summary of NDA work; details live in the named cases and on request.';
      }
    }

    const portfolioMeta = inferPortfolioMeta(project.name, project.detail, group.context ?? '');

    const score =
      (project.log ? 3 : 0) +
      (link ? 2 : 0) +
      (project.detail.length > 130 ? 2 : 1) +
      (group.context ? 1 : 0);
    const previewSlides = link ? PORTFOLIO_PREVIEWS[normalizeUrl(link)] ?? [] : [];
    const hasMedia = previewSlides.length > 0 && score >= 4;
    const mediaSlides = hasMedia ? previewSlides : [];

    const priority = (() => {
      if (nameLc.includes('windowcleaner')) return 100;
      if (nameLc.includes('крымресурс') || nameLc.includes('krymresurs')) return 95;
      if (nameLc.includes('доставка-зпр') || nameLc.includes('dostavka-zpr')) return 92;
      if (nameLc.includes('sechat')) return 90;
      if (nameLc.includes('mozgovnet')) return 86;
      if (nameLc.includes('gratisiskolan')) return 83;
      if (nameLc.includes('biznesmashin')) return 80;
      return 50;
    })();

    return {
      title: project.name,
      tag: group.period,
      slug: caseSlug(project.name),
      href: link,
      problem,
      action,
      result,
      stack: inferStack(nameLc, portfolioMeta.tags, lang),
      tags: portfolioMeta.tags,
      portfolioModes: portfolioMeta.modes,
      score,
      priority,
      hasMedia,
      mediaSlides,
      aiEnhanced: portfolioMeta.aiEnhanced,
      rescue: portfolioMeta.rescue,
    };
  })
);

const fallbackCases = p.cards.map((card) => {
  const tags = ['all', 'process'];

  const problem = lang === 'ru' ? `Нужно: ${card.tag}` : `Need: ${card.tag}`;
  const action = card.body;
