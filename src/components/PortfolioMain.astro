type ShowcaseCard = {
  title: string;
  tag: string;
  slug?: string;
  href?: string;
  problem: string;
  action: string;
  result: string;
  stack?: string;
  tags: string[];
  score: number;
  priority: number;
  hasMedia: boolean;
  mediaSlides: string[];
  ndaSafe?: boolean;
  rescue?: boolean;
  aiEnhanced?: boolean;
  status?: 'stabilized' | 'delivery';
  challenges?: Array<{ broken: string; fixed: string }>;
};

function inferStack(nameLc: string, tags: string[], lang: Lang): string {
  const ru = lang === 'ru';
  if (nameLc.includes('windowcleaner')) {
    return 'Magento 1/2, PHP, MySQL, Redis, Docker, CI/CD';
  }
  if (nameLc.includes('крымресурс') || nameLc.includes('krymresurs')) {
    return ru
      ? 'PHP, Laravel, интеграции, документооборот, API'
      : 'PHP, Laravel, integrations, document workflows, API';
  }
  if (nameLc.includes('доставка') || nameLc.includes('dostavka')) {
    return 'Laravel, PHP, CDEK API, MySQL';
  }
  if (nameLc.includes('sechat')) {
    return ru ? 'Laravel, WebSockets, Redis, очереди, DevOps' : 'Laravel, WebSockets, Redis, queues, DevOps';
  }
  if (nameLc.includes('gratisiskolan')) {
    return 'Magento 2.4, PHP, custom modules';
  }
  if (nameLc.includes('verkter')) {
    return 'Magento 2.4, PWA, React, GraphQL';
  }
  if (nameLc.includes('mozgovnet')) {
    return ru ? 'PHP, платежи, API, легаси' : 'PHP, payments, API, legacy';
  }
  if (tags.includes('migrations')) {
    return ru ? 'Magento, PHP, миграции, CI/CD' : 'Magento, PHP, migrations, CI/CD';
  }
  if (tags.includes('ecom')) {
    return ru ? 'PHP, e-commerce, интеграции' : 'PHP, e-commerce, integrations';
  }
  return ru ? 'PHP, Laravel/Magento, API, CI/CD' : 'PHP, Laravel/Magento, API, CI/CD';
}

function normalizeUrl(input: string): string {
  try {
    const u = new URL(input);
    u.hash = '';
    if (u.pathname !== '/' && u.pathname.endsWith('/')) u.pathname = u.pathname.slice(0, -1);
    return u.toString();
  } catch {
    return input;
  }
}

function inferChallenges(
  lang: Lang,
