/** Один кейс на slug и на публичный host (featured + cv-data). */
function dedupeShowcaseCards(cards: ShowcaseCard[]): ShowcaseCard[] {
  const slugSeen = new Set<string>();
  const hostSeen = new Set<string>();
  const out: ShowcaseCard[] = [];

  for (const card of cards) {
    const slug = (card.slug ?? caseSlug(card.title)).toLowerCase();
    let host = '';
    if (card.href) {
      try {
        host = new URL(card.href).hostname.replace(/^www\./i, '').toLowerCase();
      } catch {
        /* ignore */
      }
    }
    if (slugSeen.has(slug) || (host && hostSeen.has(host))) continue;
    slugSeen.add(slug);
    if (host) hostSeen.add(host);
    out.push(card);
  }
  return out;
}

function narrativeTitle(
  card: ShowcaseCard,
  mode: 'legacy' | 'profit' | 'ai',
  lang: Lang
): string {
  if (mode === 'legacy') {
    if (card.rescue) {
      return lang === 'ru' ? `Реанимация системы: ${card.title}` : `System rescue: ${card.title}`;
    }
    if (card.tags.includes('migrations')) {
      return lang === 'ru' ? `Миграция платформы: ${card.title}` : `Platform migration: ${card.title}`;
    }
    return card.title;
  }
  if (mode === 'profit') {
    return lang === 'ru' ? `Экономика результата: ${card.title}` : `Result economics: ${card.title}`;
  }
  return lang === 'ru' ? `ИИ-контур: ${card.title}` : `AI-accelerated delivery: ${card.title}`;
}

