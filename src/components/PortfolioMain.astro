function inferStack(nameLc: string, tags: string[], lang: Lang): string {
  const ru = lang === 'ru';
  if (nameLc.includes('windowcleaner')) {
    return 'Magento 1/2, PHP, MySQL, Redis';
  }
  if (nameLc.includes('102 пэс') || nameLc.includes('102 pes')) {
    return ru
      ? 'Laravel, PHP, MySQL, API, корпоративные кабинеты'
      : 'Laravel, PHP, MySQL, API, corporate portals';
  }
  if (nameLc.includes('кпск') || nameLc.includes('kpsk')) {
    return ru
      ? 'PHP (самописный), Apache, MySQL, API, страховая витрина'
      : 'Custom PHP, Apache, MySQL, API, insurance storefront';
  }
  if (nameLc.includes('гагарин') || nameLc.includes('gagarin')) {
    return ru ? 'Laravel, Statamic, PHP, интеграции' : 'Laravel, Statamic, PHP, integrations';
  }
  if (
    nameLc.includes('музыкальный') ||
    nameLc.includes('кко') ||
    nameLc.includes('muzteatr') ||
    nameLc.includes('kko')
  ) {
    return ru ? 'WordPress, PHP, MySQL' : 'WordPress, PHP, MySQL';
  }
  if (nameLc.includes('dnforum') || nameLc.includes('xenforo')) {
    return ru ? 'XenForo, PHP, MySQL' : 'XenForo, PHP, MySQL';
  }
  if (nameLc.includes('biznesmashin')) {
    return ru ? '1С-Битрикс, PHP, MySQL, Apache' : '1C-Bitrix, PHP, MySQL, Apache';
  }
  if (nameLc.includes('колл-центр') || nameLc.includes('call center')) {
    return ru ? 'Laravel, PHP, MySQL, API' : 'Laravel, PHP, MySQL, API';
  }
  if (nameLc.includes('крымресурс') || nameLc.includes('krymresurs')) {
    return ru
      ? 'ERP, Laravel, PHP, MySQL, Redis, React/Vue, интеграции'
      : 'ERP, Laravel, PHP, MySQL, Redis, React/Vue, integrations';
  }
  if (nameLc.includes('доставка') || nameLc.includes('dostavka')) {
    return 'Laravel, PHP, CDEK API, MySQL';
  }
  if (nameLc.includes('sechat')) {
    return ru ? 'Laravel, WebSockets, Redis, очереди, DevOps' : 'Laravel, WebSockets, Redis, queues, DevOps';
  }
  if (nameLc.includes('gratisiskolan')) {
    return 'Magento 2.4, PHP, custom modules';
  }
  if (nameLc.includes('verkter')) {
    return 'Magento 2.4, PWA, React, GraphQL';
  }
  if (nameLc.includes('mozgovnet')) {
    return ru ? 'PHP, платежи, API, легаси' : 'PHP, payments, API, legacy';
  }
  if (tags.includes('migrations') && /(magento|m1|m2|windowcleaner|gratisiskolan|verkter)/.test(nameLc)) {
    return ru ? 'Magento, PHP, миграции' : 'Magento, PHP, migrations';
  }
  if (tags.includes('ecom')) {
    return ru ? 'PHP, e-commerce, интеграции' : 'PHP, e-commerce, integrations';
  }
  return ru ? 'PHP, Laravel, API' : 'PHP, Laravel, API';
}

function normalizeUrl(input: string): string {
  try {
    const u = new URL(input);
    u.hash = '';
    if (u.pathname !== '/' && u.pathname.endsWith('/')) u.pathname = u.pathname.slice(0, -1);
    return u.toString();
  } catch {
    return input;
  }
}

