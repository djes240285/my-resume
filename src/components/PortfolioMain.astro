---
import type { Lang } from '../i18n/cv-data';
import { getCv } from '../i18n/cv-data';
import { resolveProjectCaseLinks } from '../lib/resolve-project-case-links';
import { PORTFOLIO_PREVIEWS } from '../config/portfolio-previews';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const cv = getCv(lang);
const p = cv.portfolio;
const projectGroups = await resolveProjectCaseLinks(cv.sections.experience.projectGroups);
const labels =
  lang === 'ru'
    ? {
        section: 'Раздел сайта',
        heroLine: 'Кейсы в формате: проблема -> решение -> результат.',
        filtersTitle: 'Фокус',
        all: 'Все',
        ecom: 'E-com',
        enterprise: 'Enterprise',
        migrations: 'Миграции',
        process: 'Процесс',
        cardProblem: 'Проблема',
        cardAction: 'Что сделал',
        cardResult: 'Результат',
        openCase: 'Открыть кейс',
        openDetails: 'Развернуть кейс',
        workStyle: 'Инженерный стандарт: от хаоса к системе',
        workStyleLead:
          'Прозрачный протокол, который снижает риск для продакшена и делает результат предсказуемым.',
        runbookTitle: 'PROJECT_RUNBOOK.SH',
        statusDone: 'COMPLETED',
        statusProgress: 'IN_PROGRESS',
        statusReady: 'READY',
        noFitTitle: 'Как принимаю проект в работу',
        noFitBody:
          'Любой проект начинаю с оценки ТЗ, ограничений и реалистичности сроков/бюджета. Если вижу, что могу дать качественный и безопасный результат — беру в работу. Если нет, честно говорю об этом и предлагаю более реалистичный путь.',
        steps: [
          {
            cmd: '[STEP 01] AUDIT_SYSTEM --scope "риски, техдолг, узкие места"',
            outcome:
              'Ценность: продакшен защищён от «правок на живую», у вас есть понятная карта рисков и приоритетов.',
            status: 'done',
          },
          {
            cmd: '[STEP 02] STABILIZATION --mode "итеративное оздоровление"',
            outcome:
              'Ценность: система улучшается без остановки бизнес-процессов — эволюция вместо дорогой революции.',
            status: 'progress',
          },
          {
            cmd: '[STEP 03] SCALE_AUTOMATION --target "CI/CD, мониторинг, поддерживаемость"',
            outcome:
              'Ценность: получаете не «разовую правку», а управляемый цифровой актив, который можно безопасно развивать.',
            status: 'ready',
          },
        ],
        periodLabel: 'Период',
        prevSlide: 'Назад',
        nextSlide: 'Вперёд',
      }
    : {
        section: 'Site section',
        heroLine: 'Cases in format: problem -> solution -> outcome.',
        filtersTitle: 'Focus',
        all: 'All',
        ecom: 'E-com',
        enterprise: 'Enterprise',
        migrations: 'Migrations',
        process: 'Process',
        cardProblem: 'Problem',
        cardAction: 'What I did',
        cardResult: 'Outcome',
        openCase: 'Open case',
        openDetails: 'View case',
        workStyle: 'Engineering standard: from chaos to system',
        workStyleLead:
          'A transparent protocol that reduces production risk and makes delivery predictable.',
        runbookTitle: 'PROJECT_RUNBOOK.SH',
        statusDone: 'COMPLETED',
        statusProgress: 'IN_PROGRESS',
        statusReady: 'READY',
        noFitTitle: 'How I accept projects',
        noFitBody:
          'I start every engagement with a clear review of scope, constraints, and budget/timeline realism. If I can deliver a safe, high-quality outcome, I commit. If not, I say it directly and suggest a more realistic path.',
        steps: [
          {
            cmd: '[STEP 01] AUDIT_SYSTEM --scope "risks, tech debt, bottlenecks"',
            outcome:
              'Value: production is protected from risky hot edits, with a clear risk map and first priorities.',
            status: 'done',
          },
          {
            cmd: '[STEP 02] STABILIZATION --mode "iterative recovery"',
            outcome:
              'Value: the system improves without stopping business workflows — evolution over costly revolution.',
            status: 'progress',
          },
          {
            cmd: '[STEP 03] SCALE_AUTOMATION --target "CI/CD, monitoring, maintainability"',
            outcome:
              'Value: you get a manageable digital asset, not a one-off patch, with safe paths for future growth.',
            status: 'ready',
          },
        ],
        periodLabel: 'Period',
        prevSlide: 'Prev',
        nextSlide: 'Next',
      };

type ShowcaseCard = {
  title: string;
  tag: string;
  href?: string;
  problem: string;
  action: string;
  result: string;
  tags: string[];
  score: number;
  priority: number;
  hasMedia: boolean;
  mediaSlides: string[];
};

function normalizeUrl(input: string): string {
  try {
    const u = new URL(input);
    u.hash = '';
    if (u.pathname !== '/' && u.pathname.endsWith('/')) u.pathname = u.pathname.slice(0, -1);
    return u.toString();
  } catch {
    return input;
  }
}

const cases: ShowcaseCard[] = projectGroups.flatMap((group) =>
  group.projects.map((project) => {
    const link =
      project.resolvedLinks?.find((l) => l.show && l.kind !== 'partner')?.href ??
      project.resolvedLinks?.find((l) => l.show)?.href;
    const text = `${project.name} ${group.context ?? ''} ${project.detail}`.toLowerCase();
    let problem =
      project.log?.status ??
      (group.context
        ? group.context
        : lang === 'ru'
          ? 'Нужен стабильный рабочий контур без потери темпа разработки.'
          : 'Need a stable production contour without losing delivery speed.');
    let action = project.log?.action ?? project.detail;
    let result =
      project.log?.result ??
      (lang === 'ru'
        ? 'Результат: проект доведён до рабочего состояния и интегрирован в текущий контур.'
        : 'Outcome: delivered into a working state and integrated into the current delivery contour.');

    const nameLc = project.name.toLowerCase();
    if (nameLc.includes('доставка-зпр') || nameLc.includes('dostavka-zpr')) {
      if (lang === 'ru') {
        problem =
          'Клиенту нужен был не лендинг, а прикладной one-page сервис оформления доставки между территориями через CDEK. Стандартный расчёт «из коробки» не подходил под двустороннюю логику маршрутов.';
        action =
          'Реализовал собственный калькулятор направлений «город -> материк» и «материк -> конкретный город», интегрировал API-поток оформления заказов и добавил сохранение инвойсов для отслеживания.';
        result =
          'Оформление и расчёт стали выполняться в одном контуре: корректная стоимость, формирование заказов по API и документированный трекинг отправлений.';
      } else {
        problem =
          'The client needed more than a landing page: a practical one-page CDEK shipping flow between territories. Out-of-the-box calculation logic did not match two-way route requirements.';
        action =
          'Built a custom calculator for “city -> mainland” and “mainland -> target city”, integrated API-based order creation, and added invoice persistence for tracking.';
        result =
          'Shipping flow moved into one operational contour: accurate pricing, API order generation, and traceable shipment documents.';
      }
    }

    if (nameLc.includes('крымресурс') || nameLc.includes('krymresurs')) {
      if (lang === 'ru') {
        problem =
          'У клиента было три приложения для разных организаций с дублями данных, рассинхроном процессов и большим объёмом ручного труда. Легаси-контур мешал согласованию и развитию функционала.';
        action =
          'Собрал интеграционную прослойку и объединил три приложения в единый рабочий контур, настроил синхронизацию данных и наполнения, параллельно развивая новую платформу техсопровождения и документооборота.';
        result =
          'Сократили ручной труд и ускорили согласования, новый функционал внедряется быстрее. Проект находится на финальном этапе миграции в единый защищённый контур без дублей данных.';
      } else {
        problem =
          'The client had three organization-specific apps with duplicated data, process drift, and heavy manual work. Legacy architecture was slowing down coordination and feature growth.';
        action =
          'Built an integration layer to unify the three apps into one operational contour, synchronized data/content flows, and advanced a new platform for technical operations and document workflows.';
        result =
          'Manual workload and coordination delays were reduced, while feature delivery became faster. The migration is now near completion into a single secure contour without data duplication.';
      }
    }

    if (nameLc.includes('windowcleaner')) {
      if (lang === 'ru') {
        problem =
          'Проект стабильно развивался, но ключевая задача была в другом: системно усилить продажи и рыночную долю без потери качества операционного контура.';
        action =
          'В связке с владельцем (Крис) прошли методичный путь развития: сопровождение Magento 1.x, подготовка и миграция на 2.x, запуск 5 нишевых площадок, а также плотная работа с тепловыми картами и UX-деталями checkout/каталога для упрощения пользовательского пути.';
        result =
          'По совокупности релизов получили прирост продаж примерно на 40% относительно прошлых периодов. Контур остался устойчивым даже в сложные периоды безопасности и высокой нагрузки.';
      } else {
        problem =
          'The store was already operating steadily, but the real goal was to increase sales and market share in a systematic way without losing operational stability.';
        action =
          'Working closely with the owner (Chris), we evolved Magento 1.x, migrated to 2.x, launched 5 niche storefronts, and used heatmap-driven UX improvements to simplify customer flow across catalog and checkout.';
        result =
          'Across release cycles, sales grew by roughly 40% versus previous periods, while the platform remained stable through high-load and security-sensitive phases.';
      }
    }

    if (nameLc.includes('gratisiskolan')) {
      if (lang === 'ru') {
        problem =
          'Проекту требовалось одновременно развивать функциональность и интерфейс под новые задачи, не останавливая рабочий контур.';
        action =
          'Параллельно с доработками и изменениями UI выполнил обновление до актуального контура Magento 2.4, включая адаптацию расширений и кастомных модулей к рабочему коду.';
        result =
          'Система сохранила стабильность в процессе обновления, получила новый функционал и обновлённый интерфейс, а кодовая база стала более актуальной и поддерживаемой.';
      } else {
        problem =
          'The project needed ongoing feature/UI evolution while keeping the production contour stable during platform updates.';
        action =
          'Delivered feature and UI improvements in parallel with Magento 2.4 modernization, including extension and custom module adaptation to production code.';
        result =
          'The system stayed stable through the upgrade, gained new functionality and UI updates, and moved to a more maintainable and up-to-date codebase.';
      }
    }

    if (nameLc.includes('sechat')) {
      if (lang === 'ru') {
        problem =
          'Клиент взял за основу существующий social-подход, но требовалось полностью переосмыслить продукт под своё видение: аудитории, UX-сценарии и коммерческую модель.';
        action =
          'Переработал платформу на Laravel, внедрил WebSockets и очередь сообщений для realtime-контуров, настроил DevOps-мониторинг, усилил anti-spam защиту, добавил AI-сегменты общения (в т.ч. для вовлечения, когда пользователю скучно), а также сценарии работы без регистрации и под разные типы пользователей.';
        result =
          'Проект стабильно работал под нагрузкой, был доведён до продающего состояния с поступательной монетизацией и успешно продан как готовый продукт.';
      } else {
        problem =
          'The client started from a social-network baseline, but the product required a full redesign around their own audience model, UX flows, and commercial direction.';
        action =
          'Reworked the platform on Laravel, introduced WebSockets and queue-based realtime messaging, set up DevOps monitoring, strengthened anti-spam controls, added AI-assisted conversation segments for engagement, and delivered both no-registration and multi-user-type flows.';
        result =
          'The product stayed stable under load, reached commercial readiness with staged monetization, and was successfully sold as a finished solution.';
      }
    }

    if (nameLc.includes('mozgovnet')) {
      if (lang === 'ru') {
        problem =
          'Клиент приобрёл проект в нерабочем состоянии: легаси-код, сломанные сценарии и расхождение с ожидаемым ТЗ.';
        action =
          'Быстро провёл разбор легаси, восстановил критичные потоки, внедрил платёжную интеграцию и донастроил бизнес-логику под реальный сценарий клиента.';
        result =
          'Проект переведён в рабочий контур в сжатые сроки: ключевые функции и платежи заработали стабильно, качество изменений сохранили на уровне, пригодном для дальнейшего развития.';
      } else {
        problem =
          'The client acquired the project in a non-working state: legacy-heavy code, broken core flows, and a gap between actual behavior and expected scope.';
        action =
          'Performed a fast legacy audit, restored critical flows, integrated payments, and aligned business logic with the client’s actual operating model.';
        result =
          'The project was moved into a stable working contour under tight timelines, with core functions and payment flow restored and code quality kept suitable for further evolution.';
      }
    }

    if (nameLc.includes('biznesmashin')) {
      if (lang === 'ru') {
        problem =
          'Проекту требовалась не разовая переделка, а регулярная коммерческая поддержка: обновление ассортимента, рекламных блоков и витрины под текущие задачи бизнеса.';
        action =
          'Выполнял периодические ТЗ-доработки: обновлял карточки и категории под изменения линейки грузовой техники, перерабатывал лендинг-блоки под маркетинговые кампании и вносил элементы ребрендинга.';
        result =
          'Магазин оставался актуальным для продаж и рекламы, а контур поддержки работал стабильно без накопления критичных изменений в бэклоге.';
      } else {
        problem =
          'The project needed continuous commercial support rather than a one-off redesign: product line updates, promo block changes, and storefront adjustments aligned with business cycles.';
        action =
          'Handled recurring scope updates: refreshed product cards/categories for changing truck inventory, adjusted landing promo blocks for campaigns, and delivered partial rebranding updates.';
        result =
          'The storefront stayed commercially relevant for both sales and marketing, with stable support flow and no critical change debt accumulation.';
      }
    }

    const tags = ['all'];
    if (/(shop|store|e-com|commerce|витрин|магаз|retail|woo|magento|bitrix)/.test(text)) tags.push('ecom');
    if (/(корп|enterprise|portal|докумен|nda|страх|bank|energy|ministry)/.test(text)) tags.push('enterprise');
    if (/(мигра|migration|legacy|upgrade|m1|m2|переход)/.test(text)) tags.push('migrations');
    if (/(seo|структур|архит|процесс|контур|integration|flow|queue|cache)/.test(text)) tags.push('process');

    const score =
      (project.log ? 3 : 0) +
      (link ? 2 : 0) +
      (project.detail.length > 130 ? 2 : 1) +
      (group.context ? 1 : 0);
    const previewSlides = link ? PORTFOLIO_PREVIEWS[normalizeUrl(link)] ?? [] : [];
    const hasMedia = previewSlides.length > 0 && score >= 4;
    const mediaSlides = hasMedia ? previewSlides : [];

    const priority = (() => {
      if (nameLc.includes('windowcleaner')) return 100;
      if (nameLc.includes('крымресурс') || nameLc.includes('krymresurs')) return 95;
      if (nameLc.includes('доставка-зпр') || nameLc.includes('dostavka-zpr')) return 92;
      if (nameLc.includes('sechat')) return 90;
      if (nameLc.includes('mozgovnet')) return 86;
      if (nameLc.includes('gratisiskolan')) return 83;
      if (nameLc.includes('biznesmashin')) return 80;
      return 50;
    })();

    return {
      title: project.name,
      tag: group.period,
      href: link,
      problem,
      action,
      result,
      tags,
      score,
      priority,
      hasMedia,
      mediaSlides,
    };
  })
);

const fallbackCases = p.cards.map((card) => {
  const text = `${card.title} ${card.tag} ${card.body}`.toLowerCase();
  const tags = ['all'];
  if (/(shop|store|e-com|commerce|витрин|магаз|retail|woo|magento)/.test(text)) tags.push('ecom');
  if (/(корп|enterprise|portal|докумен|nda|страх|bank|energy)/.test(text)) tags.push('enterprise');
  if (/(мигра|migration|legacy|upgrade|m1|m2|переход)/.test(text)) tags.push('migrations');
  if (/(seo|структур|архит|процесс|контур|integration|flow)/.test(text)) tags.push('process');

  const problem = lang === 'ru' ? `Нужно: ${card.tag}` : `Need: ${card.tag}`;
  const action = card.body;
  const result =
    lang === 'ru'
      ? 'Итог: рабочий контур с прозрачной зоной ответственности и понятным следующим шагом.'
      : 'Outcome: a working delivery contour with clear ownership and next-step visibility.';
  return {
    ...card,
    tags,
    problem,
    action,
    result,
    title: card.title,
    score: 0,
    priority: 10,
    hasMedia: false,
    mediaSlides: [] as string[],
  };
});

const showcase: ShowcaseCard[] = cases.length ? cases : fallbackCases;
showcase.sort((a, b) => (b.priority ?? 0) - (a.priority ?? 0) || (b.score ?? 0) - (a.score ?? 0));
---

<main class="portfolio-page mx-auto max-w-7xl px-4 pb-16 pt-8 sm:px-6 sm:pt-12">
  <header class="border-b border-slate-800 pb-8">
    <p class="text-xs font-bold uppercase tracking-widest text-cyan-300">
      {labels.section}
    </p>
    <h1 class="retro-heading-soft mt-2 text-3xl font-bold tracking-tight text-slate-100 sm:text-4xl">{p.title}</h1>
    <p class="mt-3 max-w-3xl text-pretty text-base leading-relaxed text-slate-300">{p.lead}</p>
    <p class="mt-2 text-sm font-mono text-emerald-300/90">{labels.heroLine}</p>
  </header>

  <section class="mt-10 border-t border-slate-800 pt-8">
    <h2 class="retro-heading-soft text-sm font-bold uppercase tracking-wider text-cyan-300">{p.introTitle}</h2>
    <p class="mt-3 max-w-prose leading-relaxed text-slate-300">{p.introBody}</p>
  </section>

  <section class="mt-10">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">{labels.filtersTitle}:</span>
      <button class="rounded border border-cyan-500/45 bg-cyan-500/10 px-2.5 py-1 text-xs font-mono text-cyan-200" data-case-filter-btn="all">{labels.all}</button>
      <button class="rounded border border-slate-700 px-2.5 py-1 text-xs font-mono text-slate-300 hover:border-cyan-500/45" data-case-filter-btn="ecom">{labels.ecom}</button>
      <button class="rounded border border-slate-700 px-2.5 py-1 text-xs font-mono text-slate-300 hover:border-cyan-500/45" data-case-filter-btn="enterprise">{labels.enterprise}</button>
      <button class="rounded border border-slate-700 px-2.5 py-1 text-xs font-mono text-slate-300 hover:border-cyan-500/45" data-case-filter-btn="migrations">{labels.migrations}</button>
      <button class="rounded border border-slate-700 px-2.5 py-1 text-xs font-mono text-slate-300 hover:border-cyan-500/45" data-case-filter-btn="process">{labels.process}</button>
    </div>
  </section>

  <section class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[3fr_1.2fr]">
    <div class="space-y-4">
      {showcase.map((card) => (
        <article class="retro-panel-soft lift-2026 rounded-lg border border-slate-800 bg-slate-900/95 p-5 shadow-sm" data-case-card data-case-tags={card.tags.join(',')}>
          {card.hasMedia ? (
            <div class="case-media mb-4" data-case-media>
              <img src={card.mediaSlides[0]} alt={card.title} loading="lazy" decoding="async" class="case-media__img" data-case-media-img data-case-media-index="0" />
              <div class="case-media__controls">
                <button type="button" class="case-media__btn" data-case-media-prev>{labels.prevSlide}</button>
                <button type="button" class="case-media__btn" data-case-media-next>{labels.nextSlide}</button>
              </div>
              <div class="case-media__slides" hidden>{card.mediaSlides.join('|')}</div>
            </div>
          ) : null}
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-lg font-bold text-slate-100">{card.title}</h3>
            <span class="rounded border border-emerald-500/35 bg-emerald-500/8 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-emerald-300">
              {labels.periodLabel}: {card.tag}
            </span>
          </div>
          <dl class="mt-3 space-y-2 text-sm">
            <div>
              <dt class="font-mono text-xs uppercase tracking-wide text-cyan-300">{labels.cardProblem}</dt>
              <dd class="mt-1 text-slate-300">{card.problem}</dd>
            </div>
            <div>
              <dt class="font-mono text-xs uppercase tracking-wide text-cyan-300">{labels.cardAction}</dt>
              <dd class="mt-1 text-slate-300">{card.action}</dd>
            </div>
            <div>
              <dt class="font-mono text-xs uppercase tracking-wide text-cyan-300">{labels.cardResult}</dt>
              <dd class="mt-1 text-slate-400">{card.result}</dd>
            </div>
          </dl>
          {card.href ? (
            <a href={card.href} target="_blank" rel="noreferrer noopener" class="mt-4 inline-flex rounded border border-cyan-500/35 px-3 py-1.5 text-sm font-semibold text-cyan-200 transition hover:border-cyan-400 hover:bg-cyan-500/10">
              {labels.openCase}
            </a>
          ) : (
            <span class="mt-4 inline-flex rounded border border-slate-700 px-3 py-1.5 text-sm font-semibold text-slate-400">{labels.openDetails}</span>
          )}
        </article>
      ))}
    </div>
    <aside class="rounded-lg border border-cyan-500/25 bg-slate-900/95 p-0 shadow-sm">
      <div class="flex items-center justify-between border-b border-cyan-500/20 bg-slate-950/80 px-4 py-2">
        <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-cyan-300">{labels.workStyle}</h2>
        <span class="font-mono text-[11px] text-emerald-300">{labels.runbookTitle}</span>
      </div>
      <div class="p-4">
        <p class="text-sm leading-relaxed text-slate-300">{labels.workStyleLead}</p>
        <ol class="mt-3 space-y-2">
          {labels.steps.map((s) => (
            <li class="rounded border border-slate-800 bg-slate-950/70 px-2.5 py-2 font-mono text-xs text-slate-200">
              <p>
                <span class="mr-2 text-cyan-300">$</span>{s.cmd}
                <span class="ml-2 text-[10px] font-semibold tracking-wide text-emerald-300/95">
                  {s.status === 'done' ? labels.statusDone : s.status === 'progress' ? labels.statusProgress : labels.statusReady}
                </span>
              </p>
              <p class="mt-1.5 font-sans text-[12px] leading-relaxed text-slate-300">{s.outcome}</p>
            </li>
          ))}
        </ol>
        <div class="mt-3 rounded border border-amber-500/30 bg-amber-500/8 px-2.5 py-2">
          <p class="font-mono text-[11px] uppercase tracking-wide text-amber-300">{labels.noFitTitle}</p>
          <p class="mt-1 text-[12px] leading-relaxed text-slate-300">{labels.noFitBody}</p>
        </div>
      </div>
    </aside>
  </section>

  <p class="mt-12 text-center">
    <a
      href={`/${lang}/`}
      class="lift-2026 inline-flex items-center justify-center rounded-full border border-slate-700 bg-slate-900 px-6 py-3 text-sm font-semibold text-slate-100 shadow transition hover:border-cyan-400 hover:text-cyan-300"
    >
      {p.ctaResume}
    </a>
  </p>
</main>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var btns = Array.from(document.querySelectorAll('[data-case-filter-btn]'));
    var cards = Array.from(document.querySelectorAll('[data-case-card]'));
    if (!btns.length || !cards.length) return;

    function applyFilter(filter: 'all' | 'ecom' | 'enterprise' | 'migrations' | 'process') {
      cards.forEach(function (card) {
        var tags = (card.getAttribute('data-case-tags') || '').split(',');
        var show = filter === 'all' || tags.indexOf(filter) >= 0;
        card.classList.toggle('case-card--hidden', !show);
      });
      btns.forEach(function (btn) {
        var on = btn.getAttribute('data-case-filter-btn') === filter;
        btn.classList.toggle('border-cyan-500/45', on);
        btn.classList.toggle('bg-cyan-500/10', on);
        btn.classList.toggle('text-cyan-200', on);
        if (!on) {
          btn.classList.remove('border-cyan-500/45', 'bg-cyan-500/10', 'text-cyan-200');
          btn.classList.add('border-slate-700', 'text-slate-300');
        } else {
          btn.classList.remove('border-slate-700', 'text-slate-300');
        }
      });
    }

    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        applyFilter((btn.getAttribute('data-case-filter-btn') || 'all') as 'all' | 'ecom' | 'enterprise' | 'migrations' | 'process');
      });
    });
    cards.forEach(function (card) {
      card.classList.remove('case-card--hidden');
    });
    applyFilter('all');

    var mediaBlocks = Array.from(document.querySelectorAll('[data-case-media]'));
    mediaBlocks.forEach(function (block) {
      var img = block.querySelector('[data-case-media-img]');
      var raw = block.querySelector('.case-media__slides');
      var prev = block.querySelector('[data-case-media-prev]');
      var next = block.querySelector('[data-case-media-next]');
      if (!(img instanceof HTMLImageElement) || !(raw instanceof HTMLElement) || !(prev instanceof HTMLButtonElement) || !(next instanceof HTMLButtonElement)) return;
      var imageEl = img;
      var slides = (raw.textContent || '').split('|').filter(Boolean);
      if (slides.length < 2) {
        prev.setAttribute('disabled', '');
        next.setAttribute('disabled', '');
        return;
      }
      var idx = Number(imageEl.getAttribute('data-case-media-index') || '0');
      function paint() {
        imageEl.src = slides[idx] || slides[0];
        imageEl.setAttribute('data-case-media-index', String(idx));
      }
      prev.addEventListener('click', function () {
        idx = (idx - 1 + slides.length) % slides.length;
        paint();
      });
      next.addEventListener('click', function () {
        idx = (idx + 1) % slides.length;
        paint();
      });
    });
  });
</script>
