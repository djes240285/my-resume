---
import type { Lang } from '../i18n/cv-data';
import { getCv } from '../i18n/cv-data';
import {
  SITE_SHOW_RESUME,
  siteHomeHref,
  siteMissionHref,
  isResumeRoute,
  isMissionRoute,
} from '../config/site';
import LiveStatusInit from './LiveStatusInit.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getCv(lang);
const path = Astro.url.pathname;
const rest = path.replace(/^\/(ru|en)/, '') || '/';
const suffix = rest === '/' ? '/' : rest;
const homeHref = siteHomeHref(lang);
const missionHref = siteMissionHref(lang);
const resumeActive = isResumeRoute(path, lang);
const missionActive = isMissionRoute(path, lang);
const portfolioActive = path.includes('/portfolio');
---

<header class="terminal-header terminal-header--mission sticky top-0 z-50 border-b border-slate-800/80 bg-slate-950">
  <div class="terminal-header__track" aria-hidden="true" />
  <div
    class="terminal-header__inner mx-auto flex w-full max-w-[min(100%,94rem)] flex-wrap items-center justify-between gap-3 px-4 py-3 sm:gap-4 sm:px-6"
  >
    <div class="terminal-header__left flex min-w-0 flex-1 flex-wrap items-center gap-3 sm:gap-4">
      <a href={homeHref} class="terminal-logo hud-mini terminal-logo--inline">
        <span class="terminal-logo__mark">EZ</span>
      </a>
      <div class="terminal-header-mission-id">
        <p class="terminal-header-mission-id__brand">{t.mission.headerBrand}</p>
        <p class="terminal-header-mission-id__title">{t.mission.headerTitle}</p>
      </div>
      <nav class="terminal-nav flex flex-wrap items-center gap-1 sm:gap-2 text-sm font-medium text-slate-400">
        {
          SITE_SHOW_RESUME ? (
            <a
              href={homeHref}
              class:list={['terminal-nav-link', resumeActive ? 'terminal-nav-link--active' : '']}
            >
              <span class="terminal-nav-link__bracket">[</span>
              {t.navResume}
              <span class="terminal-nav-link__bracket">]</span>
            </a>
          ) : null
        }
        <a
          href={missionHref}
          class:list={['terminal-nav-link', missionActive ? 'terminal-nav-link--active' : '']}
        >
          <span class="terminal-nav-link__bracket">[</span>
          {t.navMission}
          <span class="terminal-nav-link__bracket">]</span>
        </a>
        <a
          href={`/${lang}/portfolio`}
          class:list={['terminal-nav-link', portfolioActive ? 'terminal-nav-link--active' : '']}
        >
          <span class="terminal-nav-link__bracket">[</span>
          {t.navPortfolio}
          <span class="terminal-nav-link__bracket">]</span>
        </a>
      </nav>
    </div>
    <div class="terminal-header__right flex shrink-0 items-center gap-2 sm:gap-3">
      <div
        class="terminal-lang-switch flex items-center gap-0.5 rounded-lg border border-dashed border-emerald-500/35 bg-slate-900/90 px-0.5 py-0.5 text-xs font-semibold text-emerald-200 shadow-[inset_0_0_0_1px_rgba(56,189,248,0.06)]"
      >
        <a
          href={`/ru${suffix === '/' ? '/' : suffix}`}
          class:list={[
            'terminal-lang-pill rounded-md px-2 py-1 transition',
            lang === 'ru' ? 'terminal-lang-pill--on' : 'text-slate-500 hover:text-emerald-200',
          ]}
          data-lang-set="ru"
        >
          RU
        </a>
        <span class="text-slate-600" aria-hidden="true">|</span>
        <a
          href={`/en${suffix === '/' ? '/' : suffix}`}
          class:list={[
            'terminal-lang-pill rounded-md px-2 py-1 transition',
            lang === 'en' ? 'terminal-lang-pill--on' : 'text-slate-500 hover:text-emerald-200',
          ]}
          data-lang-set="en"
        >
          EN
        </a>
      </div>
      <div class="terminal-header-status" role="status" aria-live="polite">
        <span class="terminal-header-status__mark">{t.navStatusMark}</span>
        <span class="terminal-header-status__dot" id="header-live-status-dot" aria-hidden="true" />
        <span class="terminal-header-status__ready" id="header-live-status">—</span>
      </div>
      <LiveStatusInit
        textId="header-live-status"
        dotId="header-live-status-dot"
        messages={t.heroLiveStatus}
        dotClassPrefix="terminal-header-status__dot"
      />
    </div>
  </div>
</header>

<script is:inline>
  document.querySelectorAll('[data-lang-set]').forEach(function (el) {
    el.addEventListener('click', function () {
      var v = el.getAttribute('data-lang-set');
      if (v) document.cookie = 'site_lang=' + v + ';path=/;max-age=31536000;SameSite=Lax';
    });
  });
</script>
