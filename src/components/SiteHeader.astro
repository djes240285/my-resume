---
import type { Lang } from '../i18n/cv-data';
import { getCv } from '../i18n/cv-data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getCv(lang);
const path = Astro.url.pathname;
const rest = path.replace(/^\/(ru|en)/, '') || '/';
const suffix = rest === '/' ? '/' : rest;
---

<header class="terminal-header sticky top-0 z-50 border-b border-slate-800/80 bg-slate-950">
  <div class="terminal-header__track" aria-hidden="true" />
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={`/${lang}/`} class="terminal-logo hud-mini terminal-logo--inline">
      <span class="terminal-logo__mark">EZ</span>
    </a>
    <nav class="terminal-nav flex flex-wrap items-center gap-1 sm:gap-2 text-sm font-medium text-slate-400">
      <a
        href={`/${lang}/`}
        class:list={[
          'terminal-nav-link',
          path === `/${lang}` || path === `/${lang}/` ? 'terminal-nav-link--active' : '',
        ]}
      >
        <span class="terminal-nav-link__bracket">[</span>
        {t.navResume}
        <span class="terminal-nav-link__bracket">]</span>
      </a>
      <a
        href={`/${lang}/mission`}
        class:list={[
          'terminal-nav-link',
          path.includes('/mission') ? 'terminal-nav-link--active' : '',
        ]}
      >
        <span class="terminal-nav-link__bracket">[</span>
        {t.navMission}
        <span class="terminal-nav-link__bracket">]</span>
      </a>
      <a
        href={`/${lang}/portfolio`}
        class:list={[
          'terminal-nav-link',
          path.includes('/portfolio') ? 'terminal-nav-link--active' : '',
        ]}
      >
        <span class="terminal-nav-link__bracket">[</span>
        {t.navPortfolio}
        <span class="terminal-nav-link__bracket">]</span>
      </a>
    </nav>
    <div
      class="terminal-lang-switch flex items-center gap-0.5 rounded-lg border border-dashed border-emerald-500/35 bg-slate-900/90 px-0.5 py-0.5 text-xs font-semibold text-emerald-200 shadow-[inset_0_0_0_1px_rgba(56,189,248,0.06)]"
    >
      <a
        href={`/ru${suffix === '/' ? '/' : suffix}`}
        class:list={[
          'terminal-lang-pill rounded-md px-2 py-1 transition',
          lang === 'ru' ? 'terminal-lang-pill--on' : 'text-slate-500 hover:text-emerald-200',
        ]}
        data-lang-set="ru"
      >
        RU
      </a>
      <span class="text-slate-600" aria-hidden="true">|</span>
      <a
        href={`/en${suffix === '/' ? '/' : suffix}`}
        class:list={[
          'terminal-lang-pill rounded-md px-2 py-1 transition',
          lang === 'en' ? 'terminal-lang-pill--on' : 'text-slate-500 hover:text-emerald-200',
        ]}
        data-lang-set="en"
      >
        EN
      </a>
    </div>
  </div>
</header>

<script is:inline>
  document.querySelectorAll('[data-lang-set]').forEach(function (el) {
    el.addEventListener('click', function () {
      var v = el.getAttribute('data-lang-set');
      if (v) document.cookie = 'site_lang=' + v + ';path=/;max-age=31536000;SameSite=Lax';
    });
  });
</script>
