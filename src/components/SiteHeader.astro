---
import type { Lang } from '../i18n/cv-data';
import { getCv } from '../i18n/cv-data';
import {
  SITE_SHOW_RESUME,
  siteHomeHref,
  siteMissionHref,
  isResumeRoute,
  isMissionRoute,
} from '../config/site';
import LiveStatusInit from './LiveStatusInit.astro';
import A11yPanel from './A11yPanel.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getCv(lang);
const path = Astro.url.pathname;
const rest = path.replace(/^\/(ru|en)/, '') || '/';
const suffix = rest === '/' ? '/' : rest;
const homeHref = siteHomeHref(lang);
const missionHref = siteMissionHref(lang);
const resumeActive = isResumeRoute(path, lang);
const missionActive = isMissionRoute(path, lang);
const portfolioActive = path.includes('/portfolio');
---

<header class="terminal-header terminal-header--mission sticky top-0 z-50 border-b border-slate-800/80 bg-slate-950">
  <div class="terminal-header__track" aria-hidden="true" />
  <div
    class="terminal-header__inner mx-auto w-full max-w-[min(100%,94rem)] px-4 py-3 sm:px-6"
  >
    <a
      href={homeHref}
      class="terminal-header__logo terminal-logo hud-mini terminal-logo--inline shrink-0"
      aria-label={t.a11y.homeLabel}
    >
      <span class="terminal-logo__mark" aria-hidden="true">EZ</span>
    </a>

    <div class="terminal-header-mission-id terminal-header__brand min-w-0">
      <p class="terminal-header-mission-id__brand">{t.mission.headerBrand}</p>
      <p class="terminal-header-mission-id__title">{t.mission.headerTitle}</p>
    </div>

    <div class="terminal-header__tools flex shrink-0 items-center gap-2">
      <A11yPanel lang={lang} />
      <div
        class="terminal-lang-switch flex items-center gap-0.5 rounded-lg border border-dashed border-emerald-500/35 bg-slate-900/90 px-0.5 py-0.5 text-xs font-semibold text-emerald-200 shadow-[inset_0_0_0_1px_rgba(56,189,248,0.06)]"
        role="group"
        aria-label={lang === 'ru' ? 'Язык сайта' : 'Site language'}
      >
        <a
          href={`/ru${suffix === '/' ? '/' : suffix}`}
          class:list={[
            'terminal-lang-pill rounded-md px-2 py-1 transition',
            lang === 'ru' ? 'terminal-lang-pill--on' : 'text-slate-500 hover:text-emerald-200',
          ]}
          data-lang-set="ru"
          hreflang="ru"
        >
          RU
        </a>
        <span class="text-slate-600" aria-hidden="true">|</span>
        <a
          href={`/en${suffix === '/' ? '/' : suffix}`}
          class:list={[
            'terminal-lang-pill rounded-md px-2 py-1 transition',
            lang === 'en' ? 'terminal-lang-pill--on' : 'text-slate-500 hover:text-emerald-200',
          ]}
          data-lang-set="en"
          hreflang="en"
        >
          EN
        </a>
      </div>
      <button
        type="button"
        class="terminal-mobile-menu-btn"
        data-mobile-nav-toggle
        aria-expanded="false"
        aria-controls="terminal-mobile-nav"
        aria-label={t.a11y.menuToggle}
      >
        <span class="terminal-mobile-menu-btn__bars" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span class="terminal-mobile-menu-btn__label">{t.a11y.menuToggle}</span>
      </button>
    </div>

    <div class="terminal-mobile-nav-backdrop" data-mobile-nav-backdrop hidden aria-hidden="true"></div>

    <nav
      id="terminal-mobile-nav"
      class="terminal-nav terminal-header__nav flex min-w-0 flex-wrap items-center gap-1 text-sm font-medium text-slate-400 sm:gap-2"
      aria-label={t.a11y.navLabel}
      data-mobile-nav-panel
    >
      {
        SITE_SHOW_RESUME ? (
          <a
            href={homeHref}
            class:list={['terminal-nav-link', resumeActive ? 'terminal-nav-link--active' : '']}
            {...(resumeActive ? { 'aria-current': 'page' } : {})}
          >
            <span class="terminal-nav-link__bracket">[</span>
            {t.navResume}
            <span class="terminal-nav-link__bracket">]</span>
          </a>
        ) : null
      }
      <a
        href={missionHref}
        class:list={['terminal-nav-link', missionActive ? 'terminal-nav-link--active' : '']}
        {...(missionActive ? { 'aria-current': 'page' } : {})}
      >
        <span class="terminal-nav-link__bracket">[</span>
        {t.navMission}
        <span class="terminal-nav-link__bracket">]</span>
      </a>
      <a
        href={`/${lang}/portfolio`}
        class:list={['terminal-nav-link', portfolioActive ? 'terminal-nav-link--active' : '']}
        {...(portfolioActive ? { 'aria-current': 'page' } : {})}
      >
        <span class="terminal-nav-link__bracket">[</span>
        {t.navPortfolio}
        <span class="terminal-nav-link__bracket">]</span>
      </a>
    </nav>

    <div class="terminal-header-status terminal-header__status shrink-0" role="status" aria-live="polite">
      <span class="terminal-header-status__dot" id="header-live-status-dot" aria-hidden="true" />
      <span class="terminal-header-status__body">
        <span class="terminal-header-status__ready" id="header-live-status">—</span>
        <span class="terminal-header-status__schedule">{t.contactAvailability.headerSchedule}</span>
      </span>
    </div>
    <LiveStatusInit
      textId="header-live-status"
      dotId="header-live-status-dot"
      messages={t.heroLiveStatus}
      legends={t.contactAvailability.statusLegends}
      dotClassPrefix="terminal-header-status__dot"
    />
  </div>
</header>

<script is:inline>
  document.querySelectorAll('[data-lang-set]').forEach(function (el) {
    el.addEventListener('click', function () {
      var v = el.getAttribute('data-lang-set');
      if (v) document.cookie = 'site_lang=' + v + ';path=/;max-age=31536000;SameSite=Lax';
    });
  });

  (function () {
    var toggle = document.querySelector('[data-mobile-nav-toggle]');
    var panel = document.querySelector('[data-mobile-nav-panel]');
    var backdrop = document.querySelector('[data-mobile-nav-backdrop]');
    if (!toggle || !panel) return;

    function isMobileNav() {
      return !!(window.matchMedia && window.matchMedia('(max-width: 767px)').matches);
    }

    function isOpen() {
      return toggle.getAttribute('aria-expanded') === 'true';
    }

    function setOpen(open) {
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open && isMobileNav()) {
        if (backdrop) {
          backdrop.removeAttribute('hidden');
          backdrop.setAttribute('aria-hidden', 'false');
        }
        document.documentElement.classList.add('mobile-nav-open');
      } else {
        if (backdrop) {
          backdrop.setAttribute('hidden', '');
          backdrop.setAttribute('aria-hidden', 'true');
        }
        document.documentElement.classList.remove('mobile-nav-open');
      }
    }

    function syncDesktopNav() {
      if (!isMobileNav()) {
        if (backdrop) {
          backdrop.setAttribute('hidden', '');
          backdrop.setAttribute('aria-hidden', 'true');
        }
        toggle.setAttribute('aria-expanded', 'false');
        document.documentElement.classList.remove('mobile-nav-open');
      }
    }

    syncDesktopNav();
    window.addEventListener('resize', syncDesktopNav);

    toggle.addEventListener('click', function (ev) {
      ev.stopPropagation();
      if (!isMobileNav()) return;
      setOpen(!isOpen());
    });

    if (backdrop) {
      backdrop.addEventListener('click', function () {
        setOpen(false);
      });
    }

    panel.addEventListener('click', function (ev) {
      if (ev.target && ev.target.closest && ev.target.closest('a')) {
        setOpen(false);
      }
    });

    document.addEventListener('click', function (ev) {
      if (!isOpen() || !isMobileNav()) return;
      if (toggle.contains(ev.target) || panel.contains(ev.target)) return;
      setOpen(false);
    });

    document.addEventListener('keydown', function (ev) {
      if (ev.key === 'Escape' && isOpen()) setOpen(false);
    });
  })();
</script>
