---
import { techStackIconUrl } from '../config/tech-stack-icons';
import type { Lang, TechRoadmapLane } from '../i18n/cv-data';

interface Props {
  lanes: TechRoadmapLane[];
  lang: Lang;
}

const { lanes, lang } = Astro.props;

function docAriaLabel(name: string): string {
  return lang === 'ru'
    ? `${name}: документация (открывается в новой вкладке)`
    : `${name}: documentation (opens in new tab)`;
}
---

<ol class="tech-road list-none p-0 m-0">
  {
    lanes.map((lane) => (
      <li class="tech-road__lane">
        <header class="tech-road__lane-head">
          <span class="tech-road__folder-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path
                fill="rgba(250, 204, 21, 0.9)"
                d="M10 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V8a2 2 0 00-2-2h-8l-2-2z"
              />
              <path fill="rgba(202, 138, 4, 0.95)" d="M10 4h10v4H8l2-4z" />
            </svg>
          </span>
          <div class="tech-road__lane-titles">
            <p class="tech-road__title">{lane.title}</p>
            <p class="tech-road__summary">{lane.summary}</p>
          </div>
        </header>
        <ul class="tech-road__files list-none p-0 m-0">
          {lane.files.map((f) => (
            <li class="tech-file-row">
              <div class="tech-file-row__icon-wrap" aria-hidden="true">
                {f.icon ? (
                  <img
                    class="tech-file-row__icon-img"
                    src={techStackIconUrl(f.icon)}
                    alt=""
                    width="22"
                    height="22"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <svg class="tech-file-row__icon-generic" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      fill="rgba(148, 163, 184, 0.85)"
                      d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6zm4 18H6V4h7v5h5v11z"
                    />
                  </svg>
                )}
              </div>
              <div class="tech-file-row__main">
                <div class="tech-file-row__line">
                  {f.docHref ? (
                    <a
                      class="tech-file-row__name tech-file-row__name-link"
                      href={f.docHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={f.docHref}
                      aria-label={docAriaLabel(f.name)}
                    >
                      {f.name}
                    </a>
                  ) : (
                    <span class="tech-file-row__name">{f.name}</span>
                  )}
                  <span class="tech-file-row__ext font-mono">{f.ext}</span>
                </div>
                {f.hint ? <p class="tech-file-row__hint">{f.hint}</p> : null}
              </div>
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>
