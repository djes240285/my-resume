---
import type { Lang } from '../i18n/cv-data';
import type { MissionEngineerPassport as PassportData } from '../i18n/mission-control-data';
import { techStackIconUrl } from '../config/tech-stack-icons';
import { iconsForPassportContour } from '../lib/passport-stack-from-cv';
import MissionContributionGraph from './MissionContributionGraph.astro';

interface Props {
  lang: Lang;
  passport: PassportData;
}

const { passport, lang } = Astro.props;

const ecgPath = 'M0,12 L6,12 L8,5 L11,19 L14,10 L18,12 L26,12 L28,4 L31,18 L34,11 L42,11 L44,7 L47,15 L50,11 L64,11';
---

<div class="mc-passport">
  <header class="mc-passport__head">
    <p class="mc-passport__name retro-heading-soft">{passport.name}</p>
    <p class="mc-passport__role">{passport.role}</p>
  </header>

  <section class="mc-passport__block" aria-labelledby="mc-passport-metrics">
    <h3 id="mc-passport-metrics" class="mc-passport__kicker">{passport.metricsTitle}</h3>
    <dl class="mc-passport__dl">
      {
        passport.metrics.map((row) => (
          <div class:list={['mc-passport__row', row.valueNote && 'mc-passport__row--status']}>
            <dt>{row.label}</dt>
            <dd>
              {row.valueNote ? (
                <>
                  <span class="mc-passport__status-core">{row.value}</span>
                  <span class="mc-passport__status-note"> · {row.valueNote}</span>
                </>
              ) : (
                row.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mc-passport__block" aria-labelledby="mc-passport-stack">
    <h3 id="mc-passport-stack" class="mc-passport__kicker">{passport.stackTitle}</h3>
    <dl class="mc-passport__dl mc-passport__dl--stack">
      {
        passport.stackGroups.map((row) => {
          const icons = iconsForPassportContour(lang, row.contour);
          return (
            <div class="mc-passport__row mc-passport__row--stack">
              <dt>{row.label}</dt>
              <dd>
                {icons.length ? (
                  <span class="mc-passport__stack-icons">
                    {icons.map((slug) => (
                      <img
                        class="mc-passport__stack-icon"
                        src={techStackIconUrl(slug)}
                        alt=""
                        width="24"
                        height="24"
                        loading="lazy"
                        decoding="async"
                      />
                    ))}
                  </span>
                ) : null}
                <span class="sr-only">{row.value}</span>
              </dd>
            </div>
          );
        })
      }
    </dl>
  </section>

  <section class="mc-passport__viz" aria-label={passport.vizAriaLabel}>
    <div class="mc-passport__readouts">
      {
        passport.readouts.map((readout) => (
          <article class:list={['mc-passport__readout', `mc-passport__readout--${readout.tone}`]}>
            <header class="mc-passport__readout-head">
              <span class="mc-passport__readout-code">{readout.code}</span>
              <span class="mc-passport__readout-label">{readout.label}</span>
            </header>
            <p class="mc-passport__readout-headline">{readout.headline}</p>
            <p class="mc-passport__readout-detail">{readout.detail}</p>
          </article>
        ))
      }
    </div>

    <div class="mc-passport__ecg-wrap">
      <svg class="mc-passport__ecg" viewBox="0 0 64 22" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path
          class="mission-ecg__spike"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          d={ecgPath}
        />
      </svg>
    </div>

    <MissionContributionGraph lang={lang} passport={passport} />
  </section>
</div>
