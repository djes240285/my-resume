<script>
  document.addEventListener('DOMContentLoaded', function () {
    var roots = document.querySelectorAll('[data-mc-case-drum="true"]');
    if (!roots.length) return;

    var reduceMotion =
      typeof window.matchMedia !== 'undefined' &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var desktopMq =
      typeof window.matchMedia !== 'undefined'
        ? window.matchMedia('(min-width: 901px)')
        : null;

    function drumEnabled() {
      return desktopMq ? desktopMq.matches : true;
    }

    function resetMobileLayout(viewport, track, root) {
      track.style.transform = 'none';
      track.style.willChange = 'auto';
      track.style.pointerEvents = '';
      viewport.style.height = 'auto';
      viewport.style.maxHeight = 'none';
      viewport.removeAttribute('tabindex');
      viewport.classList.remove('mc-case-log__drum-viewport--dragging');
      root.classList.remove('is-interactive');
    }

    roots.forEach(function (root) {
      var viewport = root.querySelector('.mc-case-log__drum-viewport');
      var track = root.querySelector('.mc-case-log__drum-track');
      var thumb = root.querySelector('[data-mc-case-thumb]');
      var scrollTrack = root.querySelector('.mc-case-log__scrollbar-track');
      var scrollShell = root.querySelector('.mc-case-log__scroll-shell');
      if (!viewport || !track) return;

      var loopHeight = 0;
      var offset = 0;
      var dragging = false;
      var thumbDragging = false;
      var dragStartY = 0;
      var dragStartOffset = 0;
      var dragMoved = false;
      var suppressClick = false;
      var pauseUntil = 0;
      var hoverPaused = false;
      var shellHoverAt = 0;
      var SHELL_HOVER_GRACE_MS = 380;
      var AUTO_PX = 0.24;
      var PAUSE_AFTER_WHEEL_MS = 1800;
      var PAUSE_AFTER_DRAG_MS = 2600;
      var PAUSE_AFTER_LEAVE_MS = 700;

      function syncDrumMode() {
        if (!drumEnabled()) {
          resetMobileLayout(viewport, track, root);
          offset = 0;
          loopHeight = 0;
          return;
        }
        viewport.setAttribute('tabindex', '0');
        track.style.willChange = 'transform';
        measure();
      }

      function measure() {
        if (!drumEnabled()) return;
        var total = track.offsetHeight;
        loopHeight = total > 2 ? total / 2 : 0;

        var sample = track.querySelector('.mc-case-log__row:not(.mc-case-log__row--clone)');
        if (sample) {
          var h = sample.offsetHeight;
          if (h > 0) {
            viewport.style.setProperty('--mc-case-row-h', h + 'px');
          }
        }

        if (scrollTrack) {
          scrollTrack.style.height = viewport.clientHeight + 'px';
        }
        setOffset(offset);
      }

      function setOffset(next) {
        if (loopHeight > 1) {
          offset = ((next % loopHeight) + loopHeight) % loopHeight;
        } else {
          offset = Math.max(0, next);
        }
        track.style.transform = 'translate3d(0,' + -offset + 'px,0)';
        syncScrollbar();
      }

      function userPause(ms) {
        pauseUntil = performance.now() + ms;
        syncScrollbar();
      }

      function isInteractive() {
        return hoverPaused || dragging || thumbDragging || performance.now() < pauseUntil;
      }

      function syncScrollbar() {
        if (!thumb || !scrollTrack) return;
        var viewH = viewport.clientHeight;
        var trackH = scrollTrack.clientHeight;
        if (loopHeight <= 1 || trackH < 6) {
          thumb.style.opacity = '0';
          return;
        }

        var interactive = isInteractive();
        thumb.style.opacity = interactive ? '1' : '0.4';

        var thumbH = Math.max(10, Math.round((viewH / loopHeight) * trackH));
        thumbH = Math.min(thumbH, trackH - 4);
        var maxTop = Math.max(0, trackH - thumbH);
        var phase = (offset % loopHeight) / loopHeight;
        var top = phase * maxTop;
        thumb.style.height = thumbH + 'px';
        thumb.style.transform = 'translate3d(0,' + top + 'px,0)';
      }

      function offsetFromPointer(clientY) {
        if (!scrollTrack || !thumb) return offset;
        var rect = scrollTrack.getBoundingClientRect();
        var thumbH = thumb.offsetHeight;
        var maxTop = Math.max(0, rect.height - thumbH);
        var y = clientY - rect.top - thumbH / 2;
        y = Math.max(0, Math.min(maxTop, y));
        return maxTop > 0 ? (y / maxTop) * loopHeight : 0;
      }

      function shouldCaptureWheel() {
        if (!scrollShell) return false;
        if (!scrollShell.matches(':hover')) return false;
        return performance.now() - shellHoverAt >= SHELL_HOVER_GRACE_MS;
      }

      function autoStep() {
        if (!drumEnabled()) {
          window.requestAnimationFrame(autoStep);
          return;
        }
        var now = performance.now();
        if (!reduceMotion && !dragging && !thumbDragging && !hoverPaused && now >= pauseUntil && loopHeight > 1) {
          setOffset(offset + AUTO_PX);
        }
        window.requestAnimationFrame(autoStep);
      }

      if (scrollShell) {
        scrollShell.addEventListener('mouseenter', function () {
          shellHoverAt = performance.now();
        });
      }

      root.addEventListener('mouseenter', function () {
        hoverPaused = true;
        root.classList.add('is-interactive');
        syncScrollbar();
      });

      root.addEventListener('mouseleave', function () {
        hoverPaused = false;
        root.classList.remove('is-interactive');
        pauseUntil = performance.now() + PAUSE_AFTER_LEAVE_MS;
        syncScrollbar();
      });

      root.addEventListener(
        'wheel',
        function (e) {
          if (!drumEnabled() || loopHeight <= 1) return;
          if (!scrollShell || !scrollShell.contains(e.target)) return;
          if (!shouldCaptureWheel()) return;
          e.preventDefault();
          setOffset(offset + e.deltaY);
          userPause(PAUSE_AFTER_WHEEL_MS);
        },
        { passive: false }
      );

      viewport.addEventListener('pointerdown', function (e) {
        if (!drumEnabled()) return;
        if (e.button !== 0) return;
        if (e.target.closest('[data-mc-case-row]')) return;
        dragging = true;
        dragMoved = false;
        dragStartY = e.clientY;
        dragStartOffset = offset;
        viewport.setPointerCapture(e.pointerId);
        viewport.classList.add('mc-case-log__drum-viewport--dragging');
        root.classList.add('is-interactive');
        userPause(PAUSE_AFTER_DRAG_MS);
      });

      viewport.addEventListener('pointermove', function (e) {
        if (!dragging) return;
        var dy = e.clientY - dragStartY;
        if (Math.abs(dy) > 5) {
          dragMoved = true;
          track.style.pointerEvents = 'none';
        }
        setOffset(dragStartOffset - dy);
      });

      function endViewportDrag(e) {
        if (!dragging) return;
        dragging = false;
        viewport.classList.remove('mc-case-log__drum-viewport--dragging');
        track.style.pointerEvents = '';
        try {
          viewport.releasePointerCapture(e.pointerId);
        } catch (err) {
          /* ignore */
        }
        if (dragMoved) {
          suppressClick = true;
          window.setTimeout(function () {
            suppressClick = false;
          }, 120);
        }
        if (!hoverPaused) root.classList.remove('is-interactive');
        syncScrollbar();
      }

      viewport.addEventListener('pointerup', endViewportDrag);
      viewport.addEventListener('pointercancel', endViewportDrag);

      if (thumb && scrollTrack) {
        thumb.addEventListener('pointerdown', function (e) {
          if (e.button !== 0) return;
          e.preventDefault();
          e.stopPropagation();
          thumbDragging = true;
          dragStartY = e.clientY;
          dragStartOffset = offset;
          thumb.setPointerCapture(e.pointerId);
          thumb.classList.add('mc-case-log__scrollbar-thumb--dragging');
          root.classList.add('is-interactive');
          userPause(PAUSE_AFTER_DRAG_MS);
        });

        thumb.addEventListener('pointermove', function (e) {
          if (!thumbDragging) return;
          var dy = e.clientY - dragStartY;
          var trackH = scrollTrack.clientHeight;
          var thumbH = thumb.offsetHeight;
          var maxTop = Math.max(0, trackH - thumbH);
          var phaseDelta = maxTop > 0 ? dy / maxTop : 0;
          setOffset(dragStartOffset + phaseDelta * loopHeight);
        });

        function endThumbDrag(e) {
          if (!thumbDragging) return;
          thumbDragging = false;
          thumb.classList.remove('mc-case-log__scrollbar-thumb--dragging');
          try {
            thumb.releasePointerCapture(e.pointerId);
          } catch (err) {
            /* ignore */
          }
          if (!hoverPaused) root.classList.remove('is-interactive');
          syncScrollbar();
        }

        thumb.addEventListener('pointerup', endThumbDrag);
        thumb.addEventListener('pointercancel', endThumbDrag);

        scrollTrack.addEventListener('pointerdown', function (e) {
          if (e.button !== 0) return;
          if (e.target.closest('[data-mc-case-thumb]')) return;
          setOffset(offsetFromPointer(e.clientY));
          userPause(PAUSE_AFTER_DRAG_MS);
        });
      }

      track.addEventListener(
        'click',
        function (e) {
          if (suppressClick) {
            e.preventDefault();
            e.stopPropagation();
          }
        },
        true
      );

      viewport.addEventListener('keydown', function (e) {
        if (!drumEnabled() || loopHeight <= 1) return;
        var step = 48;
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          setOffset(offset + step);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          setOffset(offset - step);
        } else if (e.key === 'PageDown') {
          e.preventDefault();
          setOffset(offset + viewport.clientHeight * 0.85);
        } else if (e.key === 'PageUp') {
          e.preventDefault();
          setOffset(offset - viewport.clientHeight * 0.85);
        } else {
          return;
        }
        userPause(PAUSE_AFTER_WHEEL_MS);
      });

      syncDrumMode();
      if (desktopMq) {
        desktopMq.addEventListener('change', syncDrumMode);
      }
      window.addEventListener('resize', syncDrumMode);
      if (typeof ResizeObserver !== 'undefined') {
        var ro = new ResizeObserver(function () {
          measure();
        });
        ro.observe(track);
      }
      window.setTimeout(measure, 80);
      window.setTimeout(measure, 400);
      window.setTimeout(measure, 1200);
      if (!reduceMotion) autoStep();
    });
  });
</script>
