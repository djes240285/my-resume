---
interface Props {
  slug: string;
  title: string;
}

const { slug, title } = Astro.props;
const uid = slug.replace(/[^a-z0-9-]/gi, '-');
---

<div class="case-card__schema">
  <p class="case-card__schema-title">{title}</p>
  <svg
    class="case-card__schema-svg"
    viewBox="0 0 240 168"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={title}
  >
    <defs>
      <linearGradient id={`schema-neon-${uid}`} x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="rgba(56,189,248,0.85)" />
        <stop offset="50%" stop-color="rgba(167,139,250,0.75)" />
        <stop offset="100%" stop-color="rgba(74,222,128,0.8)" />
      </linearGradient>
      <filter id={`schema-glow-${uid}`} x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="2" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <g opacity="0.35" stroke="rgba(56,189,248,0.25)" stroke-width="0.6">
      <line x1="0" y1="42" x2="240" y2="42" />
      <line x1="0" y1="84" x2="240" y2="84" />
      <line x1="0" y1="126" x2="240" y2="126" />
      <line x1="60" y1="0" x2="60" y2="168" />
      <line x1="120" y1="0" x2="120" y2="168" />
      <line x1="180" y1="0" x2="180" y2="168" />
    </g>

    <g class="case-schema__links" fill="none" stroke={`url(#schema-neon-${uid})`} stroke-width="1.1" filter={`url(#schema-glow-${uid})`}>
      <path id={`schema-path-a-${uid}`} d="M44 118 L88 92 L120 48" stroke-dasharray="4 3" opacity="0.7" />
      <path id={`schema-path-b-${uid}`} d="M120 48 L168 56 L196 88" stroke-dasharray="4 3" opacity="0.7" />
      <path id={`schema-path-c-${uid}`} d="M88 92 L120 128 L168 120" stroke-dasharray="4 3" opacity="0.55" />
      <path id={`schema-path-d-${uid}`} d="M196 88 L196 132" stroke-dasharray="3 4" opacity="0.5" />
    </g>

    <g class="case-schema__flow" fill="#38bdf8">
      <circle r="2.2" opacity="0.95">
        <animateMotion dur="2.8s" repeatCount="indefinite" path="M44 118 L88 92 L120 48" />
      </circle>
      <circle r="2" opacity="0.85">
        <animateMotion dur="3.2s" repeatCount="indefinite" begin="0.6s" path="M120 48 L168 56 L196 88" />
      </circle>
      <circle r="1.8" fill="#4ade80" opacity="0.8">
        <animateMotion dur="2.6s" repeatCount="indefinite" begin="1.1s" path="M88 92 L120 128 L168 120" />
      </circle>
    </g>

    <g class="case-schema__nodes" font-family="JetBrains Mono, ui-monospace, monospace" font-size="5" font-weight="700" letter-spacing="0.04em">
      <g transform="translate(18, 98)">
        <polygon points="0,20 26,10 26,30 0,40" fill="rgba(15,23,42,0.9)" stroke={`url(#schema-neon-${uid})`} stroke-width="1" />
        <text x="4" y="27" fill="#94a3b8">LEGACY</text>
        <text x="4" y="34" fill="#64748b">CORE</text>
      </g>
      <g transform="translate(96, 28)">
        <rect x="0" y="0" width="48" height="36" rx="3" fill="rgba(15,23,42,0.95)" stroke={`url(#schema-neon-${uid})`} stroke-width="1.2" />
        <rect x="6" y="6" width="36" height="8" rx="1" fill="rgba(56,189,248,0.15)" stroke="rgba(56,189,248,0.35)" stroke-width="0.6" />
        <rect x="6" y="18" width="22" height="6" rx="1" fill="rgba(167,139,250,0.12)" />
        <rect x="6" y="26" width="30" height="5" rx="1" fill="rgba(74,222,128,0.1)" />
        <text x="8" y="13" fill="#7dd3fc">AI AGENTS</text>
      </g>
      <g transform="translate(152, 44)">
        <rect x="0" y="0" width="44" height="28" rx="2" fill="rgba(15,23,42,0.88)" stroke="rgba(56,189,248,0.5)" stroke-width="0.9" />
        <text x="6" y="12" fill="#bae6fd">INTEG</text>
        <text x="6" y="20" fill="#64748b">API</text>
      </g>
      <g transform="translate(172, 108)">
        <rect x="0" y="0" width="40" height="32" rx="2" fill="rgba(15,23,42,0.88)" stroke="rgba(74,222,128,0.45)" stroke-width="0.9" />
        <text x="5" y="14" fill="#86efac">DATA</text>
        <text x="5" y="24" fill="#64748b">STORE</text>
      </g>
      <g transform="translate(88, 118)">
        <rect x="0" y="0" width="52" height="28" rx="2" fill="rgba(15,23,42,0.9)" stroke="rgba(167,139,250,0.5)" stroke-width="0.9" />
        <text x="6" y="13" fill="#c4b5fd">TRAFFIC</text>
        <text x="6" y="22" fill="#64748b">EDGE</text>
      </g>
      <g transform="translate(178, 72)">
        <circle cx="10" cy="10" r="10" fill="rgba(34,197,94,0.12)" stroke="#4ade80" stroke-width="1" />
        <circle cx="10" cy="10" r="4" fill="#4ade80" opacity="0.85" />
        <text x="22" y="13" fill="#bbf7d0">PROD</text>
      </g>
    </g>
  </svg>
</div>
