---
import type { Lang } from '../i18n/cv-data';
import { getCv } from '../i18n/cv-data';
import { showMaxContact } from '../config/contact-links';
import { getMissionControl } from '../i18n/mission-control-data';
import MissionAvatarTerminal from './MissionAvatarTerminal.astro';
import MissionMindsetPath from './MissionMindsetPath.astro';
import MissionEngineerPassport from './MissionEngineerPassport.astro';
import MissionCaseLog from './MissionCaseLog.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getCv(lang);
const m = getMissionControl(lang);
const portfolioHref = `/${lang}/portfolio`;
const resumeHref = `/${lang}/`;
const bridgeMailHref = `mailto:${t.contact.emails[0]}?subject=${encodeURIComponent(m.bridge.mailtoSubject)}`;
const showMax = showMaxContact(lang);
---

<div class="mc-page">
  <header class="mc-hero-primary" aria-labelledby="mc-hero-title">
    <div class="mc-surface mc-module mc-hero-primary__card reveal-2026" style="--reveal-delay: 0ms">
      <div class="mc-hero-primary__pitch">
        <h1 id="mc-hero-title" class="mc-hero-primary__title mc-hero-primary__title--single retro-heading-soft">
          {m.hero.headline}
        </h1>

        <p class="mc-hero-primary__lead">{m.hero.lead}</p>
      </div>

      <div class="mc-hero-deck">
        <div class="mc-hero-deck__left">
          <div class="mc-hero-primary__photo">
            <MissionAvatarTerminal lang={lang} alt={m.hero.avatarAlt} />
          </div>
          <div class="mc-hero-deck__actions">
            <a
              class="mission-btn mission-btn--primary mission-btn--icon mission-btn--glow mission-btn--attention"
              href={`mailto:${t.contact.emails[0]}`}
            >
              <img class="mission-btn__icon" src="/logo-mail.svg" alt="" width="18" height="18" loading="lazy" decoding="async" aria-hidden="true" />
              <span>{m.cta.email}</span>
            </a>
            <a
              class="mission-btn mission-btn--ghost mission-btn--ghost-thin mission-btn--icon"
              href={t.contact.telegramHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img class="mission-btn__icon" src="/logo-telegram.svg" alt="" width="18" height="18" loading="lazy" decoding="async" aria-hidden="true" />
              <span>{m.cta.telegram}</span>
            </a>
            {showMax && (
              <a
                class="mission-btn mission-btn--ghost mission-btn--ghost-thin mission-btn--icon"
                href={t.contact.maxHref}
                target="_blank"
                rel="noopener noreferrer"
              >
                <img class="mission-btn__icon mission-btn__icon--max" src="/logo-max.svg" alt="" width="18" height="18" loading="lazy" decoding="async" aria-hidden="true" />
                <span>{m.cta.max}</span>
              </a>
            )}
          </div>
        </div>

        <div class="mc-hero-deck__right">
          <MissionEngineerPassport lang={lang} passport={m.engineerPassport} />
        </div>
      </div>
    </div>
  </header>

  <MissionMindsetPath title={m.mindset.title} badge={m.mindset.badge} steps={m.mindset.steps} />

  <MissionCaseLog lang={lang} caseLog={m.caseLog} portfolioHref={portfolioHref} />

  <section class="mc-bridge mc-tier-1 mc-surface mc-module reveal-2026" style="--reveal-delay: 240ms" aria-labelledby="mc-bridge-title">
    <h2 id="mc-bridge-title" class="mc-bridge__title mc-section-title--prose">{m.bridge.title}</h2>
    <p class="mc-bridge__body">{m.bridge.body}</p>
    <div class="mc-bridge__actions">
      <a
        class="mission-btn mission-btn--primary mission-btn--glow mission-btn--attention mc-bridge__btn"
        href={bridgeMailHref}
      >
        {m.bridge.cta}
      </a>
      <a class="mission-btn mission-btn--ghost mission-btn--ghost-thin mc-bridge__btn-secondary" href={t.contact.telegramHref} target="_blank" rel="noopener noreferrer">
        {m.cta.telegram}
      </a>
    </div>
  </section>

  <footer class="mc-footer mc-tier-3">
    <p class="mc-ai-line">{m.ai.line}</p>
    <div class="mission-footer">
      <p class="mission-footer__meta">{m.footer.contactsLabel}</p>
      <p class="mission-footer__links">
        <a href={resumeHref} class="mission-footer__link">EZ</a>
        <span class="mission-footer__sep">·</span>
        <a href={`mailto:${t.contact.emails[0]}`} class="mission-footer__link">{t.contact.emails[0]}</a>
        <span class="mission-footer__sep">·</span>
        <a
          href={t.contact.linkedinHref}
          class="mission-footer__link"
          target="_blank"
          rel="noopener noreferrer">{t.contact.linkedinLabel}</a
        >
      </p>
    </div>
  </footer>
</div>
