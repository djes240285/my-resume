---
import type { Lang } from '../i18n/cv-data';
import { getCv } from '../i18n/cv-data';
import { getMissionControl } from '../i18n/mission-control-data';
import MissionAvatarTerminal from './MissionAvatarTerminal.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getCv(lang);
const m = getMissionControl(lang);
const portfolioHref = `/${lang}/portfolio`;
const resumeHref = `/${lang}/`;
const TELEGRAM_URL = 'https://t.me/DJES240285';
---

<main class="mc-page">
  <header class="mc-hero-primary" aria-labelledby="mc-hero-title">
    <div class="mc-live" role="status">
      <span class="mc-live__label">{m.liveStatus.label}</span>
      <span class="mc-live__dot" aria-hidden="true"></span>
      <span class="mc-live__value">{m.liveStatus.value}</span>
    </div>

    <div class="mc-surface mc-module mc-hero-primary__card">
      <div class="mc-hero-primary__pitch">
        <h1 id="mc-hero-title" class="mc-hero-primary__title">
          <span class="mc-hero-primary__line">{m.hero.headlineLine1}</span>
          <span class="mc-hero-primary__line mc-hero-primary__line--accent">{m.hero.headlineLine2}</span>
        </h1>

        <p class="mc-hero-primary__lead">{m.hero.lead}</p>

        <ul class="mc-hero-primary__subheads">
          {m.hero.subheadLines.map((line) => <li>{line}</li>)}
        </ul>
      </div>

      <div class="mc-hero-primary__profile">
        <div class="mc-hero-primary__photo">
          <MissionAvatarTerminal lang={lang} alt={m.hero.identityName} />
        </div>
        <div class="mc-hero-primary__identity">
          <p class="mc-hero-primary__name">{m.hero.identityName}</p>
          <p class="mc-hero-primary__role">{m.hero.identityRole}</p>
          <p class="mc-hero-primary__focus">
            <span class="mc-hero-primary__focus-k">{m.liveStatus.focusLabel}</span>
            {m.liveStatus.focusValue}
          </p>
        </div>
      </div>

      <div class="mc-hero-primary__actions">
        <a class="mission-btn mission-btn--primary mission-btn--icon mission-btn--glow" href={`mailto:${t.contact.emails[0]}`}>
          <img class="mission-btn__icon" src="/logo-mail.svg" alt="" width="18" height="18" loading="lazy" decoding="async" aria-hidden="true" />
          <span>{m.cta.email}</span>
        </a>
        <a
          class="mission-btn mission-btn--ghost mission-btn--ghost-thin mission-btn--icon"
          href={TELEGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          <img class="mission-btn__icon" src="/logo-telegram.svg" alt="" width="18" height="18" loading="lazy" decoding="async" aria-hidden="true" />
          <span>{m.cta.telegram}</span>
        </a>
        <a
          class="mission-btn mission-btn--ghost mission-btn--ghost-thin mission-btn--icon"
          href={t.contact.maxHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          <img class="mission-btn__icon mission-btn__icon--max" src="/logo-max.svg" alt="" width="18" height="18" loading="lazy" decoding="async" aria-hidden="true" />
          <span>{m.cta.max}</span>
        </a>
      </div>
    </div>
  </header>

  <blockquote class="mc-narrative mc-surface mc-module mc-tier-2">
    <p>{m.narrative.body}</p>
  </blockquote>

  <section class="mc-mindset mc-surface mc-module mc-tier-2" aria-labelledby="mc-mindset-title">
    <h2 id="mc-mindset-title" class="mc-section-title">{m.mindset.title}</h2>
    <ul class="mc-mindset__list">
      {m.mindset.lines.map((line) => <li>{line}</li>)}
    </ul>
  </section>

  <section class="mc-failures mc-surface mc-module mc-tier-2" aria-labelledby="mc-failures">
    <h2 id="mc-failures" class="mc-section-title">{m.failures.title}</h2>
    <div class="mc-failures__table" role="table">
      <div class="mc-failures__head" role="row">
        <span role="columnheader">{m.failures.colFailure}</span>
        <span class="mc-failures__head-gap" aria-hidden="true"></span>
        <span role="columnheader">{m.failures.colResolution}</span>
      </div>
      {
        m.failures.rows.map((row) => (
          <div class="mc-failures__row" role="row">
            <span class="mc-failures__failure" role="cell">{row.failure}</span>
            <span class="mc-failures__arrow" aria-hidden="true">→</span>
            <span class="mc-failures__resolution" role="cell">{row.resolution}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mc-case-log mc-surface mc-module mc-tier-2" aria-labelledby="mc-case-log-title">
    <h2 id="mc-case-log-title" class="mc-section-title">{m.caseLog.title}</h2>
    <p class="mc-case-log__lead">{m.caseLog.lead}</p>
    <div class="mc-case-log__table" role="table">
      <div class="mc-case-log__head" role="row">
        <span role="columnheader">{m.caseLog.colId}</span>
        <span role="columnheader">{m.caseLog.colTarget}</span>
        <span class="mc-case-log__arrow-head" aria-hidden="true">→</span>
        <span role="columnheader">{m.caseLog.colOperation}</span>
        <span role="columnheader">{m.caseLog.colStatus}</span>
      </div>
      {
        m.caseLog.entries.map((entry) => (
          <a
            class="mc-case-log__row"
            role="row"
            href={`${portfolioHref}#case-${entry.slug}`}
          >
            <span class="mc-case-log__id" role="cell">{entry.id}</span>
            <span class="mc-case-log__name" role="cell">{entry.name}</span>
            <span class="mc-case-log__arrow" aria-hidden="true">→</span>
            <span class="mc-case-log__op" role="cell">{entry.operation}</span>
            <span class="mc-case-log__status" role="cell">{entry.status}</span>
          </a>
        ))
      }
    </div>
    <p class="mc-case-log__footer">
      <span class="mc-case-log__prompt" aria-hidden="true">&gt;</span>
      <a class="mc-case-log__cta" href={portfolioHref}>{m.caseLog.portfolioCta}</a>
    </p>
  </section>

  <section class="mc-bridge mc-tier-1 mc-surface mc-module" aria-labelledby="mc-bridge-title">
    <h2 id="mc-bridge-title" class="mc-bridge__title">{m.bridge.title}</h2>
    <p class="mc-bridge__body">{m.bridge.body}</p>
    <a class="mission-btn mission-btn--primary mc-bridge__btn" href={portfolioHref}>{m.bridge.cta}</a>
  </section>

  <footer class="mc-footer mc-tier-3">
    <p class="mc-ai-line">{m.ai.line}</p>
    <div class="mission-footer">
      <p>
        <a href={resumeHref} class="mission-footer__link">EZ</a>
        <span class="mission-footer__sep">·</span>
        <a href={`mailto:${t.contact.emails[0]}`} class="mission-footer__link">{t.contact.emails[0]}</a>
        <span class="mission-footer__sep">·</span>
        <a
          href={t.contact.linkedinHref}
          class="mission-footer__link"
          target="_blank"
          rel="noopener noreferrer">{t.contact.linkedinLabel}</a
        >
      </p>
    </div>
  </footer>
</main>
