---
import type { Lang, ProjectOutboundKind } from '../i18n/cv-data';
import { getCv } from '../i18n/cv-data';
import { resolveProjectCaseLinks } from '../lib/resolve-project-case-links';
import {
  AVATAR_SHUTTER_MP3,
  AVATAR_SHUTTER_PLAY_MS,
  AVATAR_STACK_SLIDES,
  avatarSlideLabel,
} from '../config/avatar-experience';
import AvatarViewfinderOverlay from './AvatarViewfinderOverlay.astro';
import ContactCopyIcon from './ContactCopyIcon.astro';
import TechRoadmap from './TechRoadmap.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getCv(lang);
const s = t.sections;
const projectGroupsWithCaseLink = await resolveProjectCaseLinks(s.experience.projectGroups);
const L = t.terminalLabels;
/** Точки polyline в viewBox 0 0 64 22 — разный рисунок для каждого блока */
const SUCCESS_PATH_SPARKS: readonly string[] = [
  '2,18 8,6 14,15 21,5 28,14 36,4 44,12 52,7 60,3',
  '2,5 10,16 20,19 30,8 40,13 50,5 58,3 62,2',
  '2,19 12,16 24,8 34,12 45,3 55,9 62,2',
  '2,12 11,3 20,17 30,6 40,14 50,5 58,11 62,2',
  '2,20 16,16 30,10 42,6 52,4 58,2 62,1',
];
const SUCCESS_PATH_SPARK_STROKES: readonly string[] = [
  '#38bdf8',
  '#2dd4bf',
  '#4ade80',
  '#a78bfa',
  '#fbbf24',
];
function successPathSparkPoints(i: number): string {
  return SUCCESS_PATH_SPARKS[i % SUCCESS_PATH_SPARKS.length] ?? SUCCESS_PATH_SPARKS[0];
}
function successPathSparkStroke(i: number): string {
  return SUCCESS_PATH_SPARK_STROKES[i % SUCCESS_PATH_SPARK_STROKES.length] ?? SUCCESS_PATH_SPARK_STROKES[0];
}

function projectLinkLabel(kind: ProjectOutboundKind, L: typeof t.terminalLabels): string {
  switch (kind) {
    case 'partner':
      return L.projectLinkPartner;
    case 'customer':
      return L.projectLinkCustomer;
    default:
      return L.projectLinkWebsite;
  }
}

function projectLinkClass(kind: ProjectOutboundKind): string {
  const base =
    'project-outbound-link inline-flex items-center gap-1.5 rounded border px-2.5 py-1 font-mono text-xs leading-snug underline-offset-4 transition-colors hover:underline';
  switch (kind) {
    case 'partner':
      return `${base} border-amber-500/40 text-amber-300/95 hover:border-amber-400/55 hover:bg-amber-500/10 hover:text-amber-200`;
    case 'customer':
      return `${base} border-cyan-500/40 text-cyan-300/95 hover:border-cyan-400/55 hover:bg-cyan-500/10 hover:text-cyan-200`;
    default:
      return `${base} border-slate-600/55 text-slate-300 hover:border-slate-500/70 hover:bg-slate-800/40 hover:text-slate-100`;
  }
}
const boot = t.bootLines;
const stackSlides = AVATAR_STACK_SLIDES.map((slide) => ({
  id: slide.id,
  src: slide.src,
  label: avatarSlideLabel(slide, lang),
}));
const TELEGRAM_HANDLE = '@DJES240285';
const TELEGRAM_URL = 'https://t.me/DJES240285';
const treeRowId = (i: number) => `contact-tree-row-${i}`;
const emailRowCount = t.contact.emails.length;
const idxTelegram = emailRowCount;
const idxMaxPhone = emailRowCount + 1;
const idxMaxProfile = emailRowCount + 2;
const idxLinkedin = emailRowCount + 3;
---

<main class="terminal-page-root mx-auto px-4 pb-16 pt-8 sm:px-6 sm:pt-12">
  <section class="terminal-module terminal-module--window reveal-2026" style="--reveal-delay: 80ms">
    <header class="terminal-module-windowbar">
      <p class="terminal-module-windowbar__title" aria-hidden="true">{L.heroWindowTitle}</p>
      <div class="terminal-window-controls" role="group" aria-label={lang === 'ru' ? 'Декор окна' : 'Window decoration'}>
        <span class="terminal-window-btn terminal-window-btn--min" aria-hidden="true"></span>
        <span class="terminal-window-btn terminal-window-btn--max" aria-hidden="true"></span>
        <button
          type="button"
          class="terminal-window-btn terminal-window-btn--close"
          data-hero-terminal-close
          aria-label={
            lang === 'ru'
              ? 'Закрыть вкладку или вернуться назад'
              : 'Close tab or go back to the previous page'
          }></button>
      </div>
    </header>
    <div class="terminal-module__shell p-5 sm:p-7">
    {
      boot.map((line, i) => (
        <p class="boot-line">
          {line}
          {i === boot.length - 1 ? <span class="terminal-caret" aria-hidden="true" /> : null}
        </p>
      ))
    }
    <div class="hero-terminal-grid mt-6">
      <div class="hero-terminal-avatar flex flex-col items-center lg:items-start">
        <div
          class="avatar-terminal-group"
          role="button"
          tabindex="0"
          data-avatar-stack
          aria-label={
            lang === 'ru'
              ? 'Фото профиля: кадр стека. Наведите — видоискатель. Клик или Enter — следующий кадр; после клика прицел скрывается, пока курсор над блоком, чтобы был виден кадр.'
              : 'Profile stack: hover for viewfinder. Click or Enter for next frame; after click the overlay hides while the pointer stays so the new frame is visible.'
          }
        >
          <div class="avatar-terminal-frame">
            <div class="avatar-terminal-inner hud-frame">
              <div class="avatar-terminal-deco" aria-hidden="true" />
              <div class="avatar-terminal-slot-window">
                <img
                  class="avatar-terminal-slot-img avatar-terminal-film-img--retro"
                  data-avatar-slot
                  src={AVATAR_STACK_SLIDES[0].src}
                  alt=""
                  width="256"
                  height="256"
                  loading="eager"
                  decoding="async"
                />
                <AvatarViewfinderOverlay />
                <div class="avatar-terminal-crt" aria-hidden="true" />
              </div>
            </div>
          </div>
          <p class="avatar-stack-hint mt-2 font-mono text-[0.7rem] leading-snug text-slate-500">
            {
              lang === 'ru'
                ? 'Наведите — видоискатель · клик — кадр; прицел после клика скрывается над картинкой'
                : 'Hover — viewfinder · click — frame; overlay clears after click so you see the shot'
            }
          </p>
          <p class="avatar-stack-chip" data-avatar-chip aria-live="polite">
            {avatarSlideLabel(AVATAR_STACK_SLIDES[0], lang)}
          </p>
        </div>
        <div class="hero-terminal-avatar-hud mt-4 w-full max-w-[320px]">
          <div class="contact-terminal-card hero-hud-card hud-mini">
            <div class="hero-hud-fact">
              <p class="hero-hud-fact__label">{L.hudStatus}</p>
              <p class="hero-hud-fact__value" aria-live="polite">
                <span class="hero-hud-fact__prompt">&gt;</span>
                <span class="hero-live-status-row">
                  <span class="hero-live-status__dot" id="hero-live-status-dot" aria-hidden="true"></span>
                  <span id="hero-live-status">—</span>
                </span>
              </p>
            </div>
            {
              t.heroHudFacts.map((row) => (
                <div class="hero-hud-fact">
                  <p class="hero-hud-fact__label">{row.label}</p>
                  <p class="hero-hud-fact__value">
                    <span class="hero-hud-fact__prompt">&gt;</span>
                    <span id="hero-hud-fact-value">{row.value}</span>
                  </p>
                </div>
              ))
            }
            <div class="hero-hud-card__meter" aria-hidden="true" />
          </div>
        </div>
      </div>
      <div class="hero-terminal-intro min-w-0">
        <h1 class="retro-heading-soft text-2xl font-bold uppercase leading-snug text-slate-100 sm:text-3xl">
          {t.name}
        </h1>
        <p class="mt-2 font-mono text-base uppercase tracking-wide text-cyan-300 sm:text-lg">{t.role}</p>
        <div
          class="hero-console mt-4"
          data-hero-console
          data-booting
          aria-label={t.summary}
        >
          <div class="hero-console__title-line" data-hero-console-title></div>
          <div class="hero-console__viewport" data-hero-console-viewport aria-live="polite"></div>
        </div>
      </div>
      <div class="hero-terminal-contacts min-w-0" data-contact-root>
        <div
          id="contact-window-panel"
          class="contact-window-frame"
          data-contact-window
          role="group"
          aria-label={
            lang === 'ru'
              ? 'Каналы связи: email, мессенджеры, LinkedIn'
              : 'Contact channels: email, messengers, LinkedIn'
          }
        >
          <div
            class="contact-window-titlebar"
            role="toolbar"
            aria-label={lang === 'ru' ? 'Управление окном контактов' : 'Contact window controls'}
          >
            <p class="contact-window-title" aria-hidden="true">{L.contactWindowTitle}</p>
            <div class="terminal-window-controls">
              <button
                type="button"
                class="terminal-window-btn terminal-window-btn--min"
                aria-label={L.contactWinMinAria}
                data-contact-win-min></button>
              <button
                type="button"
                class="terminal-window-btn terminal-window-btn--max"
                aria-label={L.contactWinMaxAria}
                data-contact-win-max></button>
              <button
                type="button"
                class="terminal-window-btn terminal-window-btn--close"
                aria-label={L.contactWinCloseAria}
                data-contact-win-close></button>
            </div>
          </div>
          <div class="contact-window-body" data-contact-window-body>
        <div class="contact-terminal-stack">
          <div
            class="contact-file-tree contact-terminal-card contact-terminal-card--concept hud-mini"
            data-contact-file-tree
            role="region"
            tabindex="0"
            aria-label={
              lang === 'ru'
                ? 'Контакты: стрелки вверх и вниз для перехода по строкам'
                : 'Contacts: Up and Down arrows move between rows'
            }
          >
            <div class="contact-file-tree__section">
              <div class="contact-concept-head">
                <img
                  class="contact-concept-icon"
                  src="/logo-mail.svg"
                  alt=""
                  width="20"
                  height="20"
                  loading="lazy"
                  decoding="async"
                  aria-hidden="true"
                />
                <p class="contact-concept-tag">{L.email}</p>
              </div>
              <div class="contact-file-tree__panel contact-terminal-email-body">
                <ul class="contact-file-tree__list" role="list">
                  {
                    t.contact.emails.map((email, i) => (
                      <li
                        class:list={['contact-file-tree__row', { 'contact-file-tree__row--active': i === 0 }]}
                        data-tree-row
                        id={treeRowId(i)}
                        aria-current={i === 0 ? 'true' : 'false'}
                      >
                        <a href={`mailto:${email}`} class="contact-file-tree__primary contact-terminal-email-link">
                          {email}
                        </a>
                        <button
                          type="button"
                          class="contact-copy-btn"
                          data-copy-value={email}
                          aria-label={L.contactCopyEmailAria}
                          title={email}
                          tabindex="0"
                        >
                          <ContactCopyIcon class="contact-copy-btn__glyph" />
                        </button>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>

            <div class="contact-file-tree__section">
              <div class="contact-concept-head contact-file-tree__section-head">
                <img
                  class="contact-concept-icon"
                  src="/logo-telegram.svg"
                  alt=""
                  width="20"
                  height="20"
                  loading="lazy"
                  decoding="async"
                  aria-hidden="true"
                />
                <p class="contact-concept-tag">{L.telegram}</p>
              </div>
              <div class="contact-file-tree__panel contact-terminal-email-body">
                <ul class="contact-file-tree__list" role="list">
                  <li
                    class="contact-file-tree__row"
                    data-tree-row
                    id={treeRowId(idxTelegram)}
                    aria-current="false"
                  >
                    <a
                      class="contact-file-tree__primary"
                      href={TELEGRAM_URL}
                      target="_blank"
                      rel="noreferrer noopener"
                    >
                      {TELEGRAM_HANDLE}
                    </a>
                    <button
                      type="button"
                      class="contact-copy-btn"
                      data-copy-value={TELEGRAM_URL}
                      aria-label={L.contactCopyLinkAria}
                      title={TELEGRAM_URL}
                      tabindex="0"
                    >
                      <ContactCopyIcon class="contact-copy-btn__glyph" />
                    </button>
                  </li>
                </ul>
              </div>
            </div>

            <div class="contact-file-tree__section">
              <div class="contact-concept-head contact-file-tree__section-head">
                <img
                  class="contact-concept-icon contact-concept-icon--max"
                  src="/logo-max.svg"
                  alt=""
                  width="20"
                  height="20"
                  loading="lazy"
                  decoding="async"
                  aria-hidden="true"
                />
                <p class="contact-concept-tag">{L.max}</p>
              </div>
              <div class="contact-file-tree__panel contact-terminal-email-body">
                <ul class="contact-file-tree__list" role="list">
                  <li
                    class="contact-file-tree__row"
                    data-tree-row
                    id={treeRowId(idxMaxPhone)}
                    aria-current="false"
                  >
                    <a
                      class="contact-file-tree__primary"
                      href={`tel:${t.contact.maxTel}`}
                    >
                      {t.contact.maxInvite}
                    </a>
                    <button
                      type="button"
                      class="contact-copy-btn"
                      data-copy-value={t.contact.maxTel}
                      aria-label={L.contactCopyPhoneAria}
                      title={t.contact.maxTel}
                      tabindex="0"
                    >
                      <ContactCopyIcon class="contact-copy-btn__glyph" />
                    </button>
                  </li>
                  <li
                    class="contact-file-tree__row"
                    data-tree-row
                    id={treeRowId(idxMaxProfile)}
                    aria-current="false"
                  >
                    <a
                      class="contact-file-tree__primary contact-file-tree__primary--link"
                      href={t.contact.maxHref}
                      target="_blank"
                      rel="noreferrer noopener"
                    >
                      {L.maxProfileLink}
                    </a>
                    <button
                      type="button"
                      class="contact-copy-btn"
                      data-copy-value={t.contact.maxHref}
                      aria-label={L.contactCopyLinkAria}
                      title={t.contact.maxHref}
                      tabindex="0"
                    >
                      <ContactCopyIcon class="contact-copy-btn__glyph" />
                    </button>
                  </li>
                </ul>
              </div>
            </div>

            <div class="contact-file-tree__section">
              <div class="contact-concept-head contact-file-tree__section-head">
                <img
                  class="contact-concept-icon"
                  src="/logo-linkedin.svg"
                  alt=""
                  width="20"
                  height="20"
                  loading="lazy"
                  decoding="async"
                  aria-hidden="true"
                />
                <p class="contact-concept-tag">{L.linkedin}</p>
              </div>
              <div class="contact-file-tree__panel contact-terminal-email-body">
                <ul class="contact-file-tree__list" role="list">
                  <li
                    class="contact-file-tree__row"
                    data-tree-row
                    id={treeRowId(idxLinkedin)}
                    aria-current="false"
                  >
                    <a
                      class="contact-file-tree__primary contact-file-tree__primary--link"
                      href={t.contact.linkedinHref}
                      target="_blank"
                      rel="noreferrer noopener"
                    >
                      {t.contact.linkedinLabel}
                    </a>
                    <button
                      type="button"
                      class="contact-copy-btn"
                      data-copy-value={t.contact.linkedinHref}
                      aria-label={L.contactCopyLinkAria}
                      title={t.contact.linkedinHref}
                      tabindex="0"
                    >
                      <ContactCopyIcon class="contact-copy-btn__glyph" />
                    </button>
                  </li>
                </ul>
              </div>
              <div class="contact-terminal-linkedin-meter mt-2" aria-hidden="true" />
            </div>
          </div>
        </div>
          </div>
        </div>
        <button
          type="button"
          class="contact-window-restore-btn"
          hidden
          data-contact-restore
          aria-label={L.contactRestore}
        >
          {L.contactRestore}
        </button>
      </div>
    </div>
    </div>
  </section>

  <div class="terminal-stack mt-[22px] grid gap-[22px] lg:grid-cols-3">
    <div class="space-y-[22px] lg:col-span-2">
      <article class="terminal-module reveal-2026 p-5 sm:p-6" style="--reveal-delay: 100ms">
        <h2 class="terminal-label">{L.about}</h2>
        <p class="mt-3 text-pretty text-slate-300">{s.about.body}</p>
      </article>

      <article class="terminal-module reveal-2026 p-5 sm:p-6" style="--reveal-delay: 110ms">
        <h2 class="terminal-label">{L.collaboration}</h2>
        <p class="mt-3 text-pretty text-slate-300">{s.collaboration.body}</p>
      </article>

      <article class="terminal-module reveal-2026 p-5 sm:p-6" style="--reveal-delay: 120ms">
        <h2 class="terminal-label">{L.help}</h2>
        <ul class="mt-3 space-y-2 text-slate-300">
          {s.help.items.map((item) => (
            <li class="terminal-list-item text-pretty">{item}</li>
          ))}
        </ul>
      </article>

      <article
        class="terminal-module terminal-module--success-path reveal-2026 p-5 sm:p-6"
        style="--reveal-delay: 130ms"
      >
        <header class="success-path-module__head">
          <span class="success-path-module__folder" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path
                fill="rgba(34, 211, 238, 0.95)"
                d="M10 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V8a2 2 0 00-2-2h-8l-2-2z"
              />
              <path fill="rgba(6, 182, 212, 0.75)" d="M10 4h10v4H8l2-4z" />
            </svg>
          </span>
          <h2 class="terminal-label success-path-module__title">{L.successPath}</h2>
        </header>
        <ol class="success-path mt-4">
          {
            t.careerPath.map((m, idx, arr) => (
              <li class:list={['success-path__item', { 'success-path__item--last': idx === arr.length - 1 }]}>
                <div class="success-path__marker" aria-hidden="true" />
                <div class="success-path__row">
                  <div class="success-path__body">
                    <p class="success-path__phase">{m.phase}</p>
                    <p class="success-path__title">{m.title}</p>
                    <p class="success-path__detail">{m.detail}</p>
                  </div>
                  <div class="success-path__aside" aria-hidden="true">
                    <span class="success-path__status-chip">{L.successPathBadge}</span>
                    <svg
                      class:list={['success-path__spark', `success-path__spark--glow-${idx % 5}`]}
                      viewBox="0 0 64 22"
                      xmlns="http://www.w3.org/2000/svg"
                      overflow="visible"
                      aria-hidden="true"
                    >
                      <polyline
                        fill="none"
                        stroke={successPathSparkStroke(idx)}
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        points={successPathSparkPoints(idx)}
                      />
                    </svg>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
      </article>

      <article class="terminal-module reveal-2026 p-5 sm:p-6" style="--reveal-delay: 140ms">
        <h2 class="terminal-label">{L.highlights}</h2>
        <ul class="mt-3 space-y-2 text-slate-300">
          {s.experience.highlights.map((h) => (
            <li class="terminal-list-item text-pretty">{h}</li>
          ))}
        </ul>
      </article>

      <article class="terminal-module reveal-2026 p-5 sm:p-6" style="--reveal-delay: 145ms">
        <h2 class="terminal-label">{L.partnerNote}</h2>
        <p class="mt-3 text-pretty text-sm text-slate-400">{s.experience.partnerNote}</p>
        {
          s.experience.partnerShowcase ? (
            <p class="mt-4">
              <a
                href={s.experience.partnerShowcase.href}
                class="partner-showcase-link inline-flex max-w-full flex-wrap items-center gap-x-2 gap-y-1 wrap-break-word rounded-lg border border-emerald-500/35 bg-emerald-500/[0.07] px-3 py-2 font-mono text-sm font-semibold text-emerald-200/95 underline-offset-2 ring-1 ring-emerald-400/10 transition-colors hover:border-emerald-400/55 hover:bg-emerald-500/15 hover:text-emerald-100 hover:underline hover:ring-emerald-300/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-400/70"
                target="_blank"
                rel="noreferrer noopener"
                aria-label={`${L.partnerShowcaseLinkAria}: ${s.experience.partnerShowcase.label}`}
              >
                <span class="text-emerald-400/90" aria-hidden="true">
                  →
                </span>
                <span class="font-sans text-xs font-semibold uppercase tracking-[0.12em] text-emerald-100/90 sm:text-[13px]">
                  {L.partnerShowcaseCta}
                </span>
                <span class="break-all text-[13px] text-emerald-50 sm:text-sm">{s.experience.partnerShowcase.label}</span>
              </a>
            </p>
          ) : null
        }
      </article>

      <article class="terminal-module reveal-2026 p-5 sm:p-6" style="--reveal-delay: 150ms">
        <h2 class="terminal-label">{L.projects}</h2>
        <p class="mt-1 text-xs font-mono uppercase tracking-wider text-slate-500">{s.experience.selectedTitle}</p>
        {s.experience.timelineLead ? (
          <p class="mt-2 max-w-prose text-pretty text-xs leading-relaxed text-slate-500">{s.experience.timelineLead}</p>
        ) : null}
        <div class="project-timeline">
          {
            projectGroupsWithCaseLink.map((group, eraIdx) => (
              <section
                class:list={['project-era', { 'project-era--active': eraIdx === 0 }]}
                data-project-era
                style={{ '--era-index': String(eraIdx) }}
                aria-labelledby={`project-era-${eraIdx}`}
              >
                <span class="project-era__node" aria-hidden="true" />
                <div class="project-era__body">
                  <header class="border-l-2 border-cyan-500/35 pl-3">
                    <p class="text-[10px] font-medium uppercase tracking-[0.22em] text-slate-600">{L.projectEraBadge}</p>
                    <p id={`project-era-${eraIdx}`} class="mt-1 font-mono text-sm font-semibold tracking-wide text-cyan-200/95">
                      {group.period}
                    </p>
                    {group.context ? (
                      <p class="mt-1.5 text-pretty text-xs leading-relaxed text-slate-500">{group.context}</p>
                    ) : null}
                  </header>
                  <div class="mt-3 space-y-3">
                    {group.projects.map((p) => (
                      <div class="terminal-log terminal-log--project">
                        <p class="font-semibold text-cyan-300">{p.name}</p>
                        {p.log ? (
                          <dl class="project-log-dl mt-2 space-y-1.5 text-sm">
                            <div class="project-log-row">
                              <dt class="project-log-dt">{L.logStatus}</dt>
                              <dd class="project-log-dd font-mono text-emerald-300/95">{p.log.status}</dd>
                            </div>
                            <div class="project-log-row">
                              <dt class="project-log-dt">{L.logAction}</dt>
                              <dd class="project-log-dd text-slate-300">{p.log.action}</dd>
                            </div>
                            <div class="project-log-row">
                              <dt class="project-log-dt">{L.logResult}</dt>
                              <dd class="project-log-dd text-slate-400">{p.log.result}</dd>
                            </div>
                          </dl>
                        ) : null}
                        <p class:list={['text-pretty text-slate-300', p.log ? 'mt-2 text-sm' : 'mt-1']}>{p.detail}</p>
                        {
                          p.resolvedLinks.filter((l) => l.show).length ? (
                            <div class="project-outbound-row mt-2.5 flex flex-wrap gap-2">
                              {p.resolvedLinks
                                .filter((l) => l.show)
                                .map((l) => (
                                  <a
                                    href={l.href}
                                    class={projectLinkClass(l.kind)}
                                    target="_blank"
                                    rel="noreferrer noopener"
                                  >
                                    <span class="opacity-75" aria-hidden="true">
                                      →
                                    </span>
                                    <span>{projectLinkLabel(l.kind, L)}</span>
                                  </a>
                                ))}
                            </div>
                          ) : null
                        }
                      </div>
                    ))}
                  </div>
                </div>
              </section>
            ))
          }
        </div>
      </article>
    </div>

    <aside class="space-y-[22px]">
      <article class="terminal-module reveal-2026 p-5 sm:p-6 tech-focus-zone" data-tech-focus-zone style="--reveal-delay: 125ms">
        <h2 class="terminal-label">{L.tech}</h2>
        <p class="mt-1 text-xs text-slate-500">{s.tech.title}</p>
        <div class="tech-roadmap-wrap mt-4">
          <TechRoadmap lanes={s.tech.lanes} lang={lang} />
        </div>
      </article>

      <article class="terminal-module reveal-2026 p-5 sm:p-6" style="--reveal-delay: 135ms">
        <h2 class="terminal-label">{L.coreStats}</h2>
        <ul class="core-stats-grid mt-4">
          {
            t.coreStats.map((c) => (
              <li class="core-stats-cell">
                <p class="core-stats-cell__label">{c.label}</p>
                <p class="core-stats-cell__value">{c.value}</p>
              </li>
            ))
          }
        </ul>
      </article>
    </aside>
  </div>

  <section class="terminal-module reveal-2026 mt-[22px] p-5 sm:p-6" style="--reveal-delay: 170ms">
    <h2 class="terminal-label">{L.approach}</h2>
    <p class="mt-1 text-xs text-slate-500">{s.approach.title}</p>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        s.approach.pillars.map((p) => (
          <div class="terminal-log">
            <p class="text-emerald-300">{p.title}</p>
            <p class="mt-2 text-sm text-pretty text-slate-300">{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>
</main>

<script define:vars={{
  stackSlides,
  shutterSrc: AVATAR_SHUTTER_MP3,
  shutterCutMs: AVATAR_SHUTTER_PLAY_MS,
  heroLiveStatus: t.heroLiveStatus,
  heroConsole: t.heroConsole,
  contactCopied: L.contactCopied,
  contactCopyToast: L.contactCopyToast,
}}>
  document.addEventListener('DOMContentLoaded', function () {
    var heroTerminalClose = document.querySelector('[data-hero-terminal-close]');
    if (heroTerminalClose) {
      heroTerminalClose.addEventListener('click', function () {
        window.close();
        /* Обычная вкладка: close() почти всегда игнорируется — даём рабочий запасной ход */
        window.setTimeout(function () {
          try {
            if (window.history.length > 1) {
              window.history.back();
              return;
            }
            var ref = document.referrer;
            if (ref) {
              window.location.assign(ref);
            }
          } catch (e) {
            /* ignore */
          }
        }, 150);
      });
    }

    (function initHeroLiveAndTypewriter() {
      var msgs = heroLiveStatus;
      function mskTotalMinutes() {
        var parts = new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Europe/Moscow',
          hour: 'numeric',
          minute: 'numeric',
          hour12: false,
        }).formatToParts(new Date());
        var h = 0;
        var m = 0;
        for (var i = 0; i < parts.length; i++) {
          if (parts[i].type === 'hour') h = parseInt(parts[i].value, 10) || 0;
          if (parts[i].type === 'minute') m = parseInt(parts[i].value, 10) || 0;
        }
        return h * 60 + m;
      }
      function liveStatusKey() {
        var t = mskTotalMinutes();
        if (t >= 22 * 60 || t < 7 * 60) return 'unavailable';
        if (t >= 12 * 60 && t < 14 * 60) return 'lunch';
        return 'available';
      }
      function paintLiveStatus() {
        var el = document.getElementById('hero-live-status');
        var dot = document.getElementById('hero-live-status-dot');
        if (!el || !msgs) return;
        var k = liveStatusKey();
        el.textContent = msgs[k] || msgs.available;
        if (dot) {
          dot.className = 'hero-live-status__dot hero-live-status__dot--' + k;
        }
      }
      paintLiveStatus();
      window.setInterval(paintLiveStatus, 60000);

      var hc = heroConsole;
      var con = document.querySelector('[data-hero-console]');
      var conTitle = con && con.querySelector('[data-hero-console-title]');
      var conView = con && con.querySelector('[data-hero-console-viewport]');
      if (hc && con && conTitle && conView && hc.commands && hc.title) {
        var motionOk = !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
        function revealConsole() {
          con.removeAttribute('data-booting');
        }
        function makeCaret() {
          var c = document.createElement('span');
          c.className = 'hero-console__caret';
          c.setAttribute('aria-hidden', 'true');
          return c;
        }
        function typeInto(parent, text, keepCaret, onDone) {
          var i = 0;
          var caret = makeCaret();
          parent.appendChild(caret);
          function tick() {
            if (i >= text.length) {
              if (!keepCaret) {
                parent.removeChild(caret);
              }
              if (onDone) onDone();
              return;
            }
            caret.insertAdjacentText('beforebegin', text.charAt(i++));
            window.setTimeout(tick, 8 + Math.random() * 34);
          }
          window.setTimeout(tick, 40);
        }
        if (!motionOk) {
          conTitle.textContent = hc.title;
          hc.commands.forEach(function (line) {
            var row = document.createElement('div');
            row.className = 'hero-console__row';
            var gt = document.createElement('span');
            gt.className = 'hero-console__gt';
            gt.textContent = '>';
            var txt = document.createElement('span');
            txt.className = 'hero-console__txt';
            txt.textContent = line;
            row.appendChild(gt);
            row.appendChild(txt);
            conView.appendChild(row);
          });
          revealConsole();
        } else {
          typeInto(conTitle, hc.title, false, function () {
            var li = 0;
            function nextRow() {
              if (li >= hc.commands.length) {
                con.classList.add('hero-console--done');
                revealConsole();
                return;
              }
              var row = document.createElement('div');
              row.className = 'hero-console__row';
              var gt = document.createElement('span');
              gt.className = 'hero-console__gt';
              gt.textContent = '>';
              var txt = document.createElement('span');
              txt.className = 'hero-console__txt';
              row.appendChild(gt);
              row.appendChild(txt);
              conView.appendChild(row);
              var isLast = li === hc.commands.length - 1;
              typeInto(txt, hc.commands[li], isLast, function () {
                li++;
                window.setTimeout(nextRow, 120 + Math.random() * 140);
              });
            }
            window.setTimeout(nextRow, 160);
          });
          window.setTimeout(revealConsole, 80);
        }
      } else if (con) {
        con.removeAttribute('data-booting');
      }
    })();

    var group = document.querySelector('[data-avatar-stack]');
    var slot = document.querySelector('[data-avatar-slot]');
    var chip = document.querySelector('[data-avatar-chip]');
    if (!group || !slot || !(slot instanceof HTMLImageElement) || !stackSlides.length) return;

    var vfSuppressTimer = null;
    var idx = 0;

    function clearVfSuppressTimer() {
      if (vfSuppressTimer) {
        clearTimeout(vfSuppressTimer);
        vfSuppressTimer = null;
      }
    }

    function scheduleViewfinderSuppress() {
      clearVfSuppressTimer();
      vfSuppressTimer = window.setTimeout(function () {
        vfSuppressTimer = null;
        if (group.matches(':hover')) {
          group.classList.add('avatar-terminal-group--vf-suppressed');
        }
      }, 1000);
    }

    group.addEventListener('mouseleave', function () {
      clearVfSuppressTimer();
      group.classList.remove('avatar-terminal-group--vf-suppressed');
    });

    /** Один плеер + таймер обрезки: длинный MP3 не играет до конца после одного клика */
    var shutterAudio = null;
    var shutterCutTimer = null;
    var shutterPlayingHandler = null;

    function applyRetroClass() {
      var id = stackSlides[idx] && stackSlides[idx].id;
      slot.classList.toggle('avatar-terminal-film-img--retro', id === 'retro');
    }

    function render() {
      var s = stackSlides[idx];
      if (!s) return;
      slot.src = s.src;
      slot.dataset.stackId = s.id;
      if (chip) chip.textContent = s.label;
      applyRetroClass();
    }

    function clearShutterCutTimer() {
      if (shutterCutTimer) {
        clearTimeout(shutterCutTimer);
        shutterCutTimer = null;
      }
    }

    function playShutterSound() {
      if (!shutterSrc) return;
      try {
        if (!shutterAudio) {
          shutterAudio = new Audio(shutterSrc);
          shutterAudio.preload = 'auto';
          shutterAudio.volume = 0.95;
        }
        clearShutterCutTimer();
        if (shutterPlayingHandler && shutterAudio) {
          shutterAudio.removeEventListener('playing', shutterPlayingHandler);
          shutterPlayingHandler = null;
        }
        shutterAudio.pause();
        shutterAudio.currentTime = 0;

        var ms = Number(shutterCutMs);
        if (!(ms > 0)) ms = 900;

        function armCutAfterPlaying() {
          clearShutterCutTimer();
          shutterCutTimer = window.setTimeout(function () {
            shutterCutTimer = null;
            if (!shutterAudio) return;
            shutterAudio.pause();
            shutterAudio.currentTime = 0;
          }, ms);
        }

        shutterPlayingHandler = function () {
          if (!shutterAudio || !shutterPlayingHandler) return;
          shutterAudio.removeEventListener('playing', shutterPlayingHandler);
          shutterPlayingHandler = null;
          armCutAfterPlaying();
        };
        shutterAudio.addEventListener('playing', shutterPlayingHandler);

        var p = shutterAudio.play();
        if (p && typeof p.then === 'function') {
          void p.catch(function () {
            if (shutterAudio && shutterPlayingHandler) {
              shutterAudio.removeEventListener('playing', shutterPlayingHandler);
              shutterPlayingHandler = null;
            }
            clearShutterCutTimer();
          });
        }
      } catch (e) {
        /* ignore */
      }
    }

    function bump() {
      group.classList.add('avatar-terminal-group--switching');
      window.setTimeout(function () {
        group.classList.remove('avatar-terminal-group--switching');
      }, 140);
    }

    function nextSlide() {
      group.classList.remove('avatar-terminal-group--vf-suppressed');
      idx = (idx + 1) % stackSlides.length;
      bump();
      render();
      playShutterSound();
      scheduleViewfinderSuppress();
    }

    group.addEventListener('click', function (ev) {
      if (ev.target.closest('a, button')) return;
      nextSlide();
    });

    group.addEventListener('keydown', function (ev) {
      if (ev.key === 'Enter' || ev.key === ' ') {
        ev.preventDefault();
        nextSlide();
      }
    });

    render();

    (function initContactFileTree() {
      var tree = document.querySelector('[data-contact-file-tree]');
      if (!tree) return;
      var rows = Array.from(tree.querySelectorAll('[data-tree-row]'));
      if (!rows.length) return;
      var active = 0;

      function applyActive(i) {
        if (i < 0 || i >= rows.length) return;
        active = i;
        rows.forEach(function (r, j) {
          var on = j === i;
          r.classList.toggle('contact-file-tree__row--active', on);
          r.setAttribute('aria-current', on ? 'true' : 'false');
        });
      }

      function focusPrimary(idx) {
        var link = rows[idx].querySelector('.contact-file-tree__primary');
        if (link && link.focus) link.focus();
      }

      tree.addEventListener('keydown', function (ev) {
        var key = ev.key;
        if (key !== 'ArrowUp' && key !== 'ArrowDown' && key !== 'Home' && key !== 'End') return;
        var el = document.activeElement;
        if (!tree.contains(el)) return;
        var insideRow = el.closest('[data-tree-row]');
        if (!insideRow && el !== tree) return;
        ev.preventDefault();
        var idx = insideRow ? rows.indexOf(insideRow) : active;
        if (key === 'ArrowDown') idx = Math.min(rows.length - 1, idx + 1);
        else if (key === 'ArrowUp') idx = Math.max(0, idx - 1);
        else if (key === 'Home') idx = 0;
        else if (key === 'End') idx = rows.length - 1;
        applyActive(idx);
        focusPrimary(idx);
      });

      tree.addEventListener('focus', function (ev) {
        if (ev.target !== tree) return;
        window.requestAnimationFrame(function () {
          applyActive(active);
          focusPrimary(active);
        });
      });

      rows.forEach(function (row, j) {
        row.addEventListener('click', function (ev) {
          if (ev.target.closest('.contact-copy-btn')) return;
          applyActive(j);
        });
        row.addEventListener('focusin', function (ev) {
          if (ev.target.closest('.contact-copy-btn')) return;
          applyActive(j);
        });
      });
    })();

    (function initContactCopyButtons() {
      var bubbleEl = null;
      var bubbleTAuto = null;
      var bubbleTRemove = null;

      function clearBubbleHard() {
        if (bubbleTAuto) {
          window.clearTimeout(bubbleTAuto);
          bubbleTAuto = null;
        }
        if (bubbleTRemove) {
          window.clearTimeout(bubbleTRemove);
          bubbleTRemove = null;
        }
        if (bubbleEl && bubbleEl.parentNode) {
          bubbleEl.parentNode.removeChild(bubbleEl);
        }
        bubbleEl = null;
      }

      function hideBubbleAnimate() {
        if (!bubbleEl) return;
        bubbleEl.classList.remove('contact-copy-bubble--visible');
        if (bubbleTRemove) {
          window.clearTimeout(bubbleTRemove);
          bubbleTRemove = null;
        }
        bubbleTRemove = window.setTimeout(function () {
          if (bubbleEl && bubbleEl.parentNode) {
            bubbleEl.parentNode.removeChild(bubbleEl);
          }
          bubbleEl = null;
          bubbleTRemove = null;
        }, 220);
      }

      function showCopyBubble(anchorBtn, text) {
        clearBubbleHard();
        var bubble = document.createElement('div');
        bubble.className = 'contact-copy-bubble';
        bubble.textContent = text;
        bubble.setAttribute('role', 'status');
        bubble.style.visibility = 'hidden';
        document.body.appendChild(bubble);
        var r = anchorBtn.getBoundingClientRect();
        var bw = bubble.offsetWidth;
        var bh = bubble.offsetHeight;
        var pad = 8;
        var left = r.left + r.width / 2 - bw / 2;
        left = Math.max(pad, Math.min(left, window.innerWidth - bw - pad));
        var top = r.top - bh - pad;
        if (top < pad) {
          top = r.bottom + pad;
        }
        if (top + bh > window.innerHeight - pad) {
          top = Math.max(pad, r.top - bh - pad);
        }
        bubble.style.left = left + 'px';
        bubble.style.top = top + 'px';
        bubble.style.visibility = '';
        bubbleEl = bubble;
        window.requestAnimationFrame(function () {
          bubble.classList.add('contact-copy-bubble--visible');
        });
        bubbleTAuto = window.setTimeout(hideBubbleAnimate, 2400);
      }

      function writeClipboard(text) {
        if (navigator.clipboard && window.isSecureContext) {
          return navigator.clipboard.writeText(text);
        }
        return new Promise(function (resolve, reject) {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try {
            if (document.execCommand('copy')) resolve();
            else reject(new Error('execCommand'));
          } catch (e) {
            reject(e);
          } finally {
            document.body.removeChild(ta);
          }
        });
      }

      document.addEventListener('click', function (ev) {
        var t = ev.target;
        if (!t || !t.closest) return;
        var btn = t.closest('button[data-copy-value]');
        if (!btn) return;
        var text = btn.getAttribute('data-copy-value');
        if (!text) return;
        ev.preventDefault();
        ev.stopPropagation();
        writeClipboard(text)
          .then(function () {
            showCopyBubble(btn, contactCopyToast);
            btn.classList.add('contact-copy-btn--ok');
            if (!btn.dataset.copyAriaDefault) {
              btn.dataset.copyAriaDefault = btn.getAttribute('aria-label') || '';
            }
            btn.setAttribute('aria-label', contactCopied);
            window.setTimeout(function () {
              btn.classList.remove('contact-copy-btn--ok');
              var d = btn.dataset.copyAriaDefault;
              if (d !== undefined) btn.setAttribute('aria-label', d);
            }, 1600);
          })
          .catch(function () {
            /* ignore */
          });
      });
    })();

    (function initContactWindowChrome() {
      var root = document.querySelector('[data-contact-root]');
      var panel = document.getElementById('contact-window-panel');
      var restore = document.querySelector('[data-contact-restore]');
      var minBtn = document.querySelector('[data-contact-win-min]');
      var maxBtn = document.querySelector('[data-contact-win-max]');
      var closeBtn = document.querySelector('[data-contact-win-close]');
      if (!root || !panel || !restore || !minBtn || !maxBtn || !closeBtn) return;

      function isMax() {
        return panel.classList.contains('contact-window-frame--max');
      }
      function clearLayoutModes() {
        panel.classList.remove('contact-window-frame--min', 'contact-window-frame--max');
        root.classList.remove('hero-terminal-contacts--contact-max');
      }

      minBtn.addEventListener('click', function () {
        if (panel.hasAttribute('hidden')) return;
        if (isMax()) {
          root.classList.remove('hero-terminal-contacts--contact-max');
          panel.classList.remove('contact-window-frame--max');
        }
        panel.classList.toggle('contact-window-frame--min');
      });

      maxBtn.addEventListener('click', function () {
        if (panel.hasAttribute('hidden')) return;
        panel.classList.remove('contact-window-frame--min');
        if (isMax()) {
          panel.classList.remove('contact-window-frame--max');
          root.classList.remove('hero-terminal-contacts--contact-max');
        } else {
          panel.classList.add('contact-window-frame--max');
          root.classList.add('hero-terminal-contacts--contact-max');
        }
      });

      closeBtn.addEventListener('click', function () {
        clearLayoutModes();
        panel.classList.remove('contact-window-frame--min');
        panel.setAttribute('hidden', '');
        restore.removeAttribute('hidden');
        try {
          restore.focus();
        } catch (e) {
          /* ignore */
        }
      });

      restore.addEventListener('click', function () {
        panel.removeAttribute('hidden');
        restore.setAttribute('hidden', '');
        clearLayoutModes();
      });
    })();
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var eras = document.querySelectorAll('[data-project-era]');
    if (!eras.length || !('IntersectionObserver' in window)) return;
    var AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
    var audioCtx = AudioCtx ? new AudioCtx() : null;
    var audioUnlocked = false;
    var activeEra = null as Element | null;
    var hadFirstActivation = false;
    var eraNoiseBuffer: AudioBuffer | null = null;

    function unlockTimelineAudio() {
      if (!audioCtx || audioUnlocked) return;
      if (audioCtx.state === 'suspended') {
        audioCtx.resume().catch(function () {
          /* ignore */
        });
      }
      audioUnlocked = true;
    }

    function eraIndex(el: Element | null): number {
      if (!el) return -1;
      for (var i = 0; i < eras.length; i++) {
        if (eras[i] === el) return i;
      }
      return -1;
    }

    function ensureEraNoiseBuffer() {
      if (!audioCtx || eraNoiseBuffer) return;
      var samples = Math.floor(audioCtx.sampleRate * 0.09);
      var buf = audioCtx.createBuffer(1, samples, audioCtx.sampleRate);
      var ch = buf.getChannelData(0);
      for (var i = 0; i < samples; i++) {
        ch[i] = Math.random() * 2 - 1;
      }
      eraNoiseBuffer = buf;
    }

    /** Механика ленты: короткий щелчок + приглушённая прокрутка; ниже — уход в прошлое (индекс ↑), выше — к «настоящему». */
    function playMechanicalEraTransition(fromIdx: number, toIdx: number) {
      if (!audioCtx || !audioUnlocked) return;
      if (audioCtx.state === 'suspended') return;
      ensureEraNoiseBuffer();
      if (!eraNoiseBuffer) return;

      var dir = 0;
      if (fromIdx >= 0 && toIdx >= 0) {
        if (toIdx > fromIdx) dir = 1;
        else if (toIdx < fromIdx) dir = -1;
      }

      var toneMul = dir === 1 ? 0.88 : dir === -1 ? 1.12 : 1;
      var tapeGainMul = dir === 1 ? 1 : dir === -1 ? 0.92 : 0.85;

      var t0 = audioCtx.currentTime;

      var clickOsc = audioCtx.createOscillator();
      clickOsc.type = 'square';
      var clickGain = audioCtx.createGain();
      var clickHp = audioCtx.createBiquadFilter();
      clickHp.type = 'highpass';
      clickHp.frequency.value = 380;
      clickOsc.frequency.setValueAtTime(145 * toneMul, t0);
      clickOsc.frequency.exponentialRampToValueAtTime(62 * toneMul, t0 + 0.022);
      clickGain.gain.setValueAtTime(0.0001, t0);
      clickGain.gain.linearRampToValueAtTime(0.038 * toneMul, t0 + 0.003);
      clickGain.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.028);
      clickOsc.connect(clickHp);
      clickHp.connect(clickGain);
      clickGain.connect(audioCtx.destination);
      clickOsc.start(t0);
      clickOsc.stop(t0 + 0.032);

      var tapeT = t0 + 0.006;
      var tapeSrc = audioCtx.createBufferSource();
      tapeSrc.buffer = eraNoiseBuffer;
      var tapeBp = audioCtx.createBiquadFilter();
      tapeBp.type = 'bandpass';
      tapeBp.frequency.setValueAtTime(1650 * toneMul, tapeT);
      tapeBp.frequency.linearRampToValueAtTime(1180 * toneMul, tapeT + 0.078);
      tapeBp.Q.value = 2.1;
      var tapeGain = audioCtx.createGain();
      tapeGain.gain.setValueAtTime(0.0001, tapeT);
      tapeGain.gain.linearRampToValueAtTime(0.015 * tapeGainMul, tapeT + 0.018);
      tapeGain.gain.exponentialRampToValueAtTime(0.0001, tapeT + 0.088);
      tapeSrc.connect(tapeBp);
      tapeBp.connect(tapeGain);
      tapeGain.connect(audioCtx.destination);
      tapeSrc.start(tapeT);
      tapeSrc.stop(tapeT + 0.092);
    }

    document.addEventListener('pointerdown', unlockTimelineAudio, { once: true, passive: true });
    document.addEventListener('keydown', unlockTimelineAudio, { once: true });

    var ratios = new Map();
    for (var i = 0; i < eras.length; i++) {
      ratios.set(eras[i], 0);
    }
    var thresholds = [0, 0.08, 0.16, 0.28, 0.42, 0.58, 0.75, 0.92, 1];
    var io = new IntersectionObserver(
      function (entries) {
        for (var j = 0; j < entries.length; j++) {
          ratios.set(entries[j].target, entries[j].intersectionRatio);
        }
        var best = null;
        var max = -1;
        for (var k = 0; k < eras.length; k++) {
          var el = eras[k];
          var r = ratios.get(el) || 0;
          if (r > max) {
            max = r;
            best = el;
          }
        }
        for (var m = 0; m < eras.length; m++) {
          eras[m].classList.toggle('project-era--active', eras[m] === best && max > 0.05);
        }
        var nextActive = max > 0.05 ? best : null;
        if (nextActive !== activeEra) {
          var prevIdx = eraIndex(activeEra);
          var nextIdx = eraIndex(nextActive);
          if (hadFirstActivation && nextIdx >= 0 && prevIdx >= 0) {
            playMechanicalEraTransition(prevIdx, nextIdx);
          } else if (hadFirstActivation && nextIdx >= 0 && prevIdx < 0) {
            playMechanicalEraTransition(-1, nextIdx);
          }
          activeEra = nextActive;
          hadFirstActivation = true;
        }
      },
      { threshold: thresholds, rootMargin: '-12% 0px -24% 0px' }
    );
    for (var n = 0; n < eras.length; n++) {
      io.observe(eras[n]);
    }
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var selectors = [
      '.terminal-log--project',
      '.project-outbound-link',
      '.partner-showcase-link',
      '.tech-road__lane',
      '.tech-file-row',
    ];
    var targets = document.querySelectorAll(selectors.join(','));
    if (!targets.length) return;

    var AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
    if (!AudioCtx) return;

    var ctx = new AudioCtx();
    var unlocked = false;
    var lastPlayedAt = 0;

    function unlockAudioOnce() {
      if (unlocked) return;
      if (ctx.state === 'suspended') {
        ctx.resume().catch(function () {
          /* ignore */
        });
      }
      unlocked = true;
    }

    document.addEventListener('pointerdown', unlockAudioOnce, { once: true, passive: true });
    document.addEventListener('keydown', unlockAudioOnce, { once: true });

    function playHoverTone() {
      if (!unlocked) return;
      if (ctx.state === 'suspended') return;

      var nowMs = performance.now();
      if (nowMs - lastPlayedAt < 90) return;
      lastPlayedAt = nowMs;

      var now = ctx.currentTime;
      var osc = ctx.createOscillator();
      var gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(980, now);
      osc.frequency.exponentialRampToValueAtTime(740, now + 0.06);
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(0.028, now + 0.008);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.07);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.075);
    }

    targets.forEach(function (el) {
      el.addEventListener('pointerenter', playHoverTone, { passive: true });
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var zone = document.querySelector('[data-tech-focus-zone]');
    if (!zone) return;
    var techZone = zone as HTMLElement;

    function setActive(value: boolean) {
      techZone.classList.toggle('is-active', value);
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setActive(true);
      return;
    }

    techZone.addEventListener('mouseenter', function () {
      setActive(true);
    });
    techZone.addEventListener('mouseleave', function () {
      setActive(false);
    });
    techZone.addEventListener('focusin', function () {
      setActive(true);
    });
    techZone.addEventListener('focusout', function () {
      setActive(false);
    });

    if (!('IntersectionObserver' in window)) {
      setActive(true);
      return;
    }

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.target === techZone) {
            setActive(entry.intersectionRatio > 0.32);
          }
        });
      },
      { threshold: [0, 0.16, 0.32, 0.55, 0.8], rootMargin: '-12% 0px -12% 0px' }
    );
    io.observe(techZone);
  });
</script>
