---
import type { Lang } from '../i18n/cv-data';
import { getCv } from '../i18n/cv-data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getCv(lang);
const s = t.sections;
const L = t.terminalLabels;
const boot = t.bootLines;
---

<main
  class="terminal-page-root mx-auto max-w-6xl px-4 pb-16 pt-8 sm:px-6 sm:pt-12"
>
  <section class="terminal-module reveal-2026 p-5 sm:p-7" style="--reveal-delay: 80ms">
    {
      boot.map((line, i) => (
        <p class="boot-line">
          {line}
          {i === boot.length - 1 ? <span class="terminal-caret" aria-hidden="true" /> : null}
        </p>
      ))
    }
    <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,280px)_1fr] lg:gap-x-8">
      <div class="flex justify-center lg:justify-start">
        <div class="avatar-terminal-group">
          <div class="avatar-terminal-frame">
            <div class="avatar-terminal-rotator" aria-hidden="true" />
            <div class="avatar-terminal-inner">
              <img
                src="/profile.png"
                alt=""
                width="256"
                height="256"
                class="avatar-terminal-photo h-full w-full object-cover object-center"
                loading="eager"
              />
            </div>
          </div>
        </div>
      </div>
      <div class="min-w-0">
        <h1 class="retro-heading-soft text-2xl font-bold uppercase leading-snug text-slate-100 sm:text-3xl">
          {t.name}
        </h1>
        <p class="mt-2 font-mono text-base uppercase tracking-wide text-cyan-300 sm:text-lg">{t.role}</p>
        <p class="mt-4 max-w-3xl text-pretty text-slate-300">{t.summary}</p>
        <div class="contact-terminal-grid mt-6">
          <div class="contact-terminal-card">
            <p class="contact-terminal-tag">{L.email}</p>
            <ul class="contact-terminal-emails mt-2 space-y-1.5">
              {
                t.contact.emails.map((email) => (
                  <li>
                    <a href={`mailto:${email}`} class="contact-terminal-link">
                      {email}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <a
            class="contact-terminal-card contact-terminal-card--telegram"
            href="https://t.me/DJES240285"
            target="_blank"
            rel="noreferrer noopener"
          >
            <div class="contact-terminal-card-main">
              <p class="contact-terminal-tag">{L.telegram}</p>
              <p class="contact-terminal-handle mt-2 font-mono text-sm font-semibold text-cyan-200">@DJES240285</p>
            </div>
            <div class="contact-terminal-qr">
              <img src="/telegram-qr.png" alt="" width="64" height="64" class="h-16 w-16 object-cover" loading="lazy" />
            </div>
          </a>
          <a
            class="contact-terminal-card"
            href={t.contact.linkedinHref}
            target="_blank"
            rel="noreferrer noopener"
          >
            <p class="contact-terminal-tag">{L.linkedin}</p>
            <p class="contact-terminal-handle mt-2 font-mono text-xs font-medium leading-relaxed text-slate-200 sm:text-sm">
              {t.contact.linkedinLabel}
            </p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="terminal-stack mt-[22px] grid gap-[22px] lg:grid-cols-3">
    <div class="space-y-[22px] lg:col-span-2">
      <article class="terminal-module reveal-2026 p-5 sm:p-6" style="--reveal-delay: 100ms">
        <h2 class="terminal-label">{L.about}</h2>
        <p class="mt-3 text-pretty text-slate-300">{s.about.body}</p>
      </article>

      <article class="terminal-module reveal-2026 p-5 sm:p-6" style="--reveal-delay: 110ms">
        <h2 class="terminal-label">{L.collaboration}</h2>
        <p class="mt-3 text-pretty text-slate-300">{s.collaboration.body}</p>
      </article>

      <article class="terminal-module reveal-2026 p-5 sm:p-6" style="--reveal-delay: 120ms">
        <h2 class="terminal-label">{L.help}</h2>
        <ul class="mt-3 space-y-2 text-slate-300">
          {s.help.items.map((item) => (
            <li class="terminal-list-item text-pretty">{item}</li>
          ))}
        </ul>
      </article>

      <article class="terminal-module reveal-2026 p-5 sm:p-6" style="--reveal-delay: 130ms">
        <h2 class="terminal-label">{L.successPath}</h2>
        <ol class="success-path mt-4">
          {
            t.careerPath.map((m) => (
              <li class="success-path__item">
                <div class="success-path__marker" aria-hidden="true" />
                <div class="success-path__body">
                  <p class="success-path__phase font-mono text-xs text-emerald-400">{m.phase}</p>
                  <p class="success-path__title mt-0.5 text-sm font-semibold text-cyan-200">{m.title}</p>
                  <p class="success-path__detail mt-1 text-sm text-pretty text-slate-400">{m.detail}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </article>

      <article class="terminal-module reveal-2026 p-5 sm:p-6" style="--reveal-delay: 140ms">
        <h2 class="terminal-label">{L.highlights}</h2>
        <ul class="mt-3 space-y-2 text-slate-300">
          {s.experience.highlights.map((h) => (
            <li class="terminal-list-item text-pretty">{h}</li>
          ))}
        </ul>
      </article>

      <article class="terminal-module reveal-2026 p-5 sm:p-6" style="--reveal-delay: 145ms">
        <h2 class="terminal-label">{L.partnerNote}</h2>
        <p class="mt-3 text-pretty text-sm text-slate-400">{s.experience.partnerNote}</p>
      </article>

      <article class="terminal-module reveal-2026 p-5 sm:p-6" style="--reveal-delay: 150ms">
        <h2 class="terminal-label">{L.projects}</h2>
        <p class="mt-1 text-xs font-mono uppercase tracking-wider text-slate-500">{s.experience.selectedTitle}</p>
        <div class="mt-4 space-y-3">
          {
            s.experience.projects.map((p) => (
              <div class="terminal-log terminal-log--project">
                <p class="font-semibold text-cyan-300">{p.name}</p>
                {p.log ? (
                  <dl class="project-log-dl mt-2 space-y-1.5 text-sm">
                    <div class="project-log-row">
                      <dt class="project-log-dt">{L.logStatus}</dt>
                      <dd class="project-log-dd font-mono text-emerald-300/95">{p.log.status}</dd>
                    </div>
                    <div class="project-log-row">
                      <dt class="project-log-dt">{L.logAction}</dt>
                      <dd class="project-log-dd text-slate-300">{p.log.action}</dd>
                    </div>
                    <div class="project-log-row">
                      <dt class="project-log-dt">{L.logResult}</dt>
                      <dd class="project-log-dd text-slate-400">{p.log.result}</dd>
                    </div>
                  </dl>
                ) : null}
                <p class:list={['text-pretty text-slate-300', p.log ? 'mt-2 text-sm' : 'mt-1']}>{p.detail}</p>
                {p.href ? (
                  <a
                    href={p.href}
                    class="project-log-link mt-2 inline-flex font-mono text-xs text-cyan-400 underline-offset-2 hover:text-cyan-300 hover:underline"
                    target="_blank"
                    rel="noreferrer noopener"
                  >
                    {lang === 'ru' ? '→ страница кейса' : '→ case page'}
                  </a>
                ) : null}
              </div>
            ))
          }
        </div>
      </article>
    </div>

    <aside class="space-y-[22px]">
      <article class="terminal-module reveal-2026 p-5 sm:p-6" style="--reveal-delay: 125ms">
        <h2 class="terminal-label">{L.tech}</h2>
        <p class="mt-1 text-xs text-slate-500">{s.tech.title}</p>
        <div class="mt-4 space-y-3">
          {
            s.tech.groups.map((g) => (
              <div class="tech-stack-card">
                <p class="tech-stack-card__label">{g.label}</p>
                <p class="tech-stack-card__value">{g.value}</p>
              </div>
            ))
          }
        </div>
      </article>

      <article class="terminal-module reveal-2026 p-5 sm:p-6" style="--reveal-delay: 135ms">
        <h2 class="terminal-label">{L.coreStats}</h2>
        <ul class="core-stats-grid mt-4">
          {
            t.coreStats.map((c) => (
              <li class="core-stats-cell">
                <p class="core-stats-cell__label">{c.label}</p>
                <p class="core-stats-cell__value">{c.value}</p>
              </li>
            ))
          }
        </ul>
      </article>
    </aside>
  </div>

  <section class="terminal-module reveal-2026 mt-[22px] p-5 sm:p-6" style="--reveal-delay: 170ms">
    <h2 class="terminal-label">{L.approach}</h2>
    <p class="mt-1 text-xs text-slate-500">{s.approach.title}</p>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        s.approach.pillars.map((p) => (
          <div class="terminal-log">
            <p class="text-emerald-300">{p.title}</p>
            <p class="mt-2 text-sm text-pretty text-slate-300">{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>
</main>
