<script define:vars={{ audienceMode }}>
  (function initAudienceModeEarly() {
    if (!audienceMode || !audienceMode.modes) return;
    var roleEl = document.querySelector('[data-audience-role]');
    var taglineEl = document.querySelector('[data-audience-tagline]');
    var aboutEl = document.querySelector('[data-audience-about]');
    var collaborationEl = document.querySelector('[data-audience-collaboration]');
    var helpEl = document.querySelector('[data-audience-help]');
    var highlightsEl = document.querySelector('[data-audience-highlights]');
    var approachTitleEl = document.querySelector('[data-audience-approach-title]');
    var approachBodies = Array.from(document.querySelectorAll('[data-audience-approach-body]'));
    var modeBtns = Array.from(document.querySelectorAll('[data-audience-mode-btn]'));
    if (
      !roleEl ||
      !aboutEl ||
      !collaborationEl ||
      !helpEl ||
      !highlightsEl ||
      !approachTitleEl ||
      !modeBtns.length
    )
      return;

    var onboarding = document.querySelector('[data-audience-onboarding]');
    var key = audienceMode.storageKey || 'audience-mode-v1';
    var modes = audienceMode.modes;
    var rootEl = document.documentElement;

    var cards = Array.from(document.querySelectorAll('[data-audience-card]'));
    var base = {
      role: roleEl.textContent || '',
      tagline: taglineEl ? taglineEl.textContent || '' : '',
      about: aboutEl.textContent || '',
      collaboration: collaborationEl.textContent || '',
      help: Array.from(helpEl.querySelectorAll('li')).map(function (li) {
        return li.textContent || '';
      }),
      highlights: Array.from(highlightsEl.querySelectorAll('li')).map(function (li) {
        return li.textContent || '';
      }),
      approachTitle: approachTitleEl.textContent || '',
      approachBodies: approachBodies.map(function (el) {
        return el.textContent || '';
      }),
    };
    var activeMode = audienceMode.defaultMode || 'default';

    function isKnownMode(m) {
      return m === 'default' || m === 'client';
    }

    function paintList(ul, items) {
      if (!ul || !Array.isArray(items)) return;
      ul.innerHTML = '';
      items.forEach(function (item) {
        var li = document.createElement('li');
        li.className = 'terminal-list-item text-pretty';
        li.textContent = item;
        ul.appendChild(li);
      });
    }

    function animateCards() {
      cards.forEach(function (card) {
        card.classList.remove('audience-card--flip');
        window.requestAnimationFrame(function () {
          card.classList.add('audience-card--flip');
          window.setTimeout(function () {
            card.classList.remove('audience-card--flip');
          }, 520);
        });
      });
    }

    function applyMode(mode, persist) {
      if (!isKnownMode(mode)) return;
      var payload = mode === 'client' ? modes.client : base;
      roleEl.textContent = payload.role;
      if (taglineEl && typeof payload.tagline === 'string') taglineEl.textContent = payload.tagline;
      aboutEl.textContent = payload.about;
      collaborationEl.textContent = payload.collaboration;
      paintList(helpEl, payload.help);
      paintList(highlightsEl, payload.highlights);
      approachTitleEl.textContent = payload.approachTitle;
      if (Array.isArray(payload.approachBodies)) {
        approachBodies.forEach(function (el) {
          var idx = Number(el.getAttribute('data-audience-approach-body'));
          if (!(idx >= 0)) return;
          var text = payload.approachBodies[idx];
          if (typeof text === 'string' && text.length) el.textContent = text;
        });
      }
      modeBtns.forEach(function (btn) {
        var on = btn.getAttribute('data-audience-mode-btn') === mode;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      rootEl.setAttribute('data-audience-mode', mode);
      activeMode = mode;
      if (mode === 'client') animateCards();
      document.dispatchEvent(
        new CustomEvent('audience-mode-change', {
          detail: {
            mode: mode,
            avatarId: mode === 'client' ? modes.client.avatarId : 'retro',
            animateAvatar: !!persist,
          },
        })
      );
      if (persist) {
        try {
          localStorage.setItem(key, mode);
        } catch (e) {
          /* ignore */
        }
        document.cookie = key + '=' + encodeURIComponent(mode) + '; path=/; max-age=31536000; samesite=lax';
      }
    }

    var saved = rootEl.getAttribute('data-audience-mode');
    try {
      if (saved !== 'default' && saved !== 'client') saved = localStorage.getItem(key);
    } catch (e) {
      /* ignore */
    }
    applyMode(isKnownMode(saved) ? saved : activeMode, false);

    modeBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var mode = btn.getAttribute('data-audience-mode-btn');
        if (mode === activeMode) return;
        applyMode(mode, true);
      });
    });

    if (onboarding) {
      window.requestAnimationFrame(function () {
        onboarding.classList.add('is-ready');
      });
    }
    rootEl.classList.remove('audience-mode-pending');
  })();
</script>

<script define:vars={{
  stackSlides,
  shutterSrc: AVATAR_SHUTTER_MP3,
  shutterCutMs: AVATAR_SHUTTER_PLAY_MS,
  heroConsole: t.heroConsole,
  contactCopied: L.contactCopied,
  contactCopyToast: L.contactCopyToast,
  audienceMode,
}}>
  document.addEventListener('DOMContentLoaded', function () {
    var heroTerminalClose = document.querySelector('[data-hero-terminal-close]');
    if (heroTerminalClose) {
      heroTerminalClose.addEventListener('click', function () {
        window.close();
        /* Обычная вкладка: close() почти всегда игнорируется — даём рабочий запасной ход */
        window.setTimeout(function () {
          try {
            if (window.history.length > 1) {
              window.history.back();
              return;
            }
            var ref = document.referrer;
            if (ref) {
              window.location.assign(ref);
            }
          } catch (e) {
            /* ignore */
          }
        }, 150);
      });
    }

    (function initHeroTypewriter() {
      var hc = heroConsole;
      var con = document.querySelector('[data-hero-console]');
      var conTitle = con && con.querySelector('[data-hero-console-title]');
      var conView = con && con.querySelector('[data-hero-console-viewport]');
      if (hc && con && conTitle && conView && hc.commands && hc.title) {
        var motionOk = !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
        function revealConsole() {
          con.removeAttribute('data-booting');
        }
        function makeCaret() {
          var c = document.createElement('span');
          c.className = 'hero-console__caret';
          c.setAttribute('aria-hidden', 'true');
          return c;
        }
        function typeInto(parent, text, keepCaret, onDone) {
          var i = 0;
          var caret = makeCaret();
          parent.appendChild(caret);
          function tick() {
            if (i >= text.length) {
              if (!keepCaret) {
                parent.removeChild(caret);
              }
              if (onDone) onDone();
              return;
            }
            caret.insertAdjacentText('beforebegin', text.charAt(i++));
            window.setTimeout(tick, 8 + Math.random() * 34);
          }
          window.setTimeout(tick, 40);
        }
        if (!motionOk) {
          conTitle.textContent = hc.title;
          hc.commands.forEach(function (line) {
            var row = document.createElement('div');
            row.className = 'hero-console__row';
            var gt = document.createElement('span');
            gt.className = 'hero-console__gt';
            gt.textContent = '>';
            var txt = document.createElement('span');
            txt.className = 'hero-console__txt';
            txt.textContent = line;
            row.appendChild(gt);
            row.appendChild(txt);
            conView.appendChild(row);
          });
          revealConsole();
        } else {
          typeInto(conTitle, hc.title, false, function () {
            var li = 0;
            function nextRow() {
              if (li >= hc.commands.length) {
                con.classList.add('hero-console--done');
                revealConsole();
                return;
              }
              var row = document.createElement('div');
              row.className = 'hero-console__row';
              var gt = document.createElement('span');
              gt.className = 'hero-console__gt';
              gt.textContent = '>';
              var txt = document.createElement('span');
              txt.className = 'hero-console__txt';
              row.appendChild(gt);
              row.appendChild(txt);
              conView.appendChild(row);
              var isLast = li === hc.commands.length - 1;
              typeInto(txt, hc.commands[li], isLast, function () {
                li++;
                window.setTimeout(nextRow, 120 + Math.random() * 140);
              });
            }
            window.setTimeout(nextRow, 160);
          });
          window.setTimeout(revealConsole, 80);
        }
      } else if (con) {
        con.removeAttribute('data-booting');
      }
    })();

    var group = document.querySelector('[data-avatar-stack]');
    var slot = document.querySelector('[data-avatar-slot]');
    var slotWindow = document.querySelector('.avatar-terminal-slot-window');
    var chip = document.querySelector('[data-avatar-chip]');
    if (!group || !slot || !(slot instanceof HTMLImageElement) || !stackSlides.length) return;

    var vfSuppressTimer = null;
    var idx = 0;
    var avatarSwapBusy = false;
    var motionOkAvatar = !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

    function clearVfSuppressTimer() {
      if (vfSuppressTimer) {
        clearTimeout(vfSuppressTimer);
        vfSuppressTimer = null;
      }
    }

    function scheduleViewfinderSuppress() {
      clearVfSuppressTimer();
      vfSuppressTimer = window.setTimeout(function () {
        vfSuppressTimer = null;
        if (group.matches(':hover')) {
          group.classList.add('avatar-terminal-group--vf-suppressed');
        }
      }, 1000);
    }

    group.addEventListener('mouseleave', function () {
      clearVfSuppressTimer();
      group.classList.remove('avatar-terminal-group--vf-suppressed');
    });

    /** Один плеер + таймер обрезки: длинный MP3 не играет до конца после одного клика */
    var shutterAudio = null;
    var shutterCutTimer = null;
    var shutterPlayingHandler = null;

    function applyRetroClass() {
      var id = stackSlides[idx] && stackSlides[idx].id;
      slot.classList.toggle('avatar-terminal-film-img--retro', id === 'retro');
    }

    function render() {
      var s = stackSlides[idx];
      if (!s) return;
      var pic = slot.closest('picture');
      var webpEl = pic && pic.querySelector('[data-avatar-webp-source]');
      if (webpEl instanceof HTMLSourceElement) {
        var w = s.webpSrc;
        if (w) webpEl.setAttribute('srcset', w);
        else webpEl.removeAttribute('srcset');
      }
      slot.src = s.src;
      slot.dataset.stackId = s.id;
      if (chip) chip.textContent = s.label;
      applyRetroClass();
    }

    function setAvatarById(id, instant, withFlip) {
      if (!id) return;
      var next = -1;
      for (var i = 0; i < stackSlides.length; i++) {
        if (stackSlides[i] && stackSlides[i].id === id) {
          next = i;
          break;
        }
      }
      if (next < 0 || next === idx) return;
      if (withFlip) {
        slot.classList.remove('avatar-terminal-slot-img--mode-flip');
        window.requestAnimationFrame(function () {
          slot.classList.add('avatar-terminal-slot-img--mode-flip');
        });
        window.setTimeout(function () {
          idx = next;
          if (instant) slot.classList.remove('avatar-terminal-slot-img--swap-out');
          render();
        }, 170);
        window.setTimeout(function () {
          slot.classList.remove('avatar-terminal-slot-img--mode-flip');
        }, 380);
        return;
      }
      idx = next;
      if (instant) {
        slot.classList.remove('avatar-terminal-slot-img--swap-out');
      }
      render();
    }

    function clearShutterCutTimer() {
      if (shutterCutTimer) {
        clearTimeout(shutterCutTimer);
        shutterCutTimer = null;
      }
    }

    function playShutterSound() {
      if (!shutterSrc) return;
      try {
        if (!shutterAudio) {
          shutterAudio = new Audio(shutterSrc);
          shutterAudio.preload = 'auto';
          shutterAudio.volume = 0.95;
        }
        clearShutterCutTimer();
        if (shutterPlayingHandler && shutterAudio) {
          shutterAudio.removeEventListener('playing', shutterPlayingHandler);
          shutterPlayingHandler = null;
        }
        shutterAudio.pause();
        shutterAudio.currentTime = 0;

        var ms = Number(shutterCutMs);
        if (!(ms > 0)) ms = 900;

        function armCutAfterPlaying() {
          clearShutterCutTimer();
          shutterCutTimer = window.setTimeout(function () {
            shutterCutTimer = null;
            if (!shutterAudio) return;
            shutterAudio.pause();
            shutterAudio.currentTime = 0;
          }, ms);
        }

        shutterPlayingHandler = function () {
          if (!shutterAudio || !shutterPlayingHandler) return;
          shutterAudio.removeEventListener('playing', shutterPlayingHandler);
          shutterPlayingHandler = null;
          armCutAfterPlaying();
        };
        shutterAudio.addEventListener('playing', shutterPlayingHandler);

        var p = shutterAudio.play();
        if (p && typeof p.then === 'function') {
          void p.catch(function () {
            if (shutterAudio && shutterPlayingHandler) {
              shutterAudio.removeEventListener('playing', shutterPlayingHandler);
              shutterPlayingHandler = null;
            }
            clearShutterCutTimer();
          });
        }
      } catch (e) {
        /* ignore */
      }
    }

    function nextSlide() {
      group.classList.remove('avatar-terminal-group--vf-suppressed');
      playShutterSound();
      scheduleViewfinderSuppress();

      if (!motionOkAvatar) {
        idx = (idx + 1) % stackSlides.length;
        render();
        return;
      }

      if (avatarSwapBusy) return;
      avatarSwapBusy = true;

      var fadeCommitted = false;
      var fadeOutFallbackId = 0;
      var imgWaitId = 0;

      function releaseBusy() {
        avatarSwapBusy = false;
      }

      function commitFadeOut() {
        if (fadeCommitted) return;
        fadeCommitted = true;
        if (fadeOutFallbackId) window.clearTimeout(fadeOutFallbackId);
        if (imgWaitId) window.clearTimeout(imgWaitId);
        slot.removeEventListener('transitionend', onFadeOut);
        idx = (idx + 1) % stackSlides.length;
        render();

        function reveal() {
          if (imgWaitId) window.clearTimeout(imgWaitId);
          slot.classList.remove('avatar-terminal-slot-img--swap-out');
          if (slotWindow) slotWindow.classList.remove('avatar-terminal-slot-window--show-ez');
          window.setTimeout(releaseBusy, 440);
        }

        if (slot.decode && typeof slot.decode === 'function') {
          slot
            .decode()
            .then(reveal)
            .catch(reveal);
        } else if (slot.complete && slot.naturalWidth > 0) {
          window.requestAnimationFrame(reveal);
        } else {
          var onImg = function () {
            slot.removeEventListener('load', onImg);
            slot.removeEventListener('error', onImg);
            window.requestAnimationFrame(reveal);
          };
          slot.addEventListener('load', onImg, { once: true });
          slot.addEventListener('error', onImg, { once: true });
          imgWaitId = window.setTimeout(function () {
            window.requestAnimationFrame(reveal);
          }, 900);
        }
      }

      function onFadeOut(ev) {
        if (ev.target !== slot || ev.propertyName !== 'opacity') return;
        commitFadeOut();
      }

      slot.addEventListener('transitionend', onFadeOut);
      if (slotWindow) slotWindow.classList.add('avatar-terminal-slot-window--show-ez');
      slot.classList.add('avatar-terminal-slot-img--swap-out');
      fadeOutFallbackId = window.setTimeout(commitFadeOut, 400);
    }

    group.addEventListener('click', function (ev) {
      if (ev.target.closest('a, button')) return;
      nextSlide();
    });

    group.addEventListener('keydown', function (ev) {
      if (ev.key === 'Enter' || ev.key === ' ') {
        ev.preventDefault();
        nextSlide();
      }
    });

    render();
    document.addEventListener('audience-mode-change', function (ev) {
      var detail = ev && ev.detail ? ev.detail : null;
      if (!detail) return;
      var avatarId = detail.avatarId;
      if (typeof avatarId === 'string' && avatarId.length) {
        setAvatarById(avatarId, true, !!detail.animateAvatar);
      }
    });

    (function initContactFileTree() {
      var tree = document.querySelector('[data-contact-file-tree]');
      if (!tree) return;
      var rows = Array.from(tree.querySelectorAll('[data-tree-row]'));
      if (!rows.length) return;
      var active = 0;

      function applyActive(i) {
        if (i < 0 || i >= rows.length) return;
        active = i;
        rows.forEach(function (r, j) {
          var on = j === i;
          r.classList.toggle('contact-file-tree__row--active', on);
          r.setAttribute('aria-current', on ? 'true' : 'false');
        });
      }

      function focusPrimary(idx) {
        var link = rows[idx].querySelector('.contact-file-tree__primary');
        if (link && link.focus) link.focus();
      }

      tree.addEventListener('keydown', function (ev) {
        var key = ev.key;
        if (key !== 'ArrowUp' && key !== 'ArrowDown' && key !== 'Home' && key !== 'End') return;
        var el = document.activeElement;
        if (!tree.contains(el)) return;
        var insideRow = el.closest('[data-tree-row]');
        if (!insideRow && el !== tree) return;
        ev.preventDefault();
        var idx = insideRow ? rows.indexOf(insideRow) : active;
        if (key === 'ArrowDown') idx = Math.min(rows.length - 1, idx + 1);
        else if (key === 'ArrowUp') idx = Math.max(0, idx - 1);
        else if (key === 'Home') idx = 0;
        else if (key === 'End') idx = rows.length - 1;
        applyActive(idx);
        focusPrimary(idx);
      });

      tree.addEventListener('focus', function (ev) {
        if (ev.target !== tree) return;
        window.requestAnimationFrame(function () {
          applyActive(active);
          focusPrimary(active);
        });
      });

      rows.forEach(function (row, j) {
        row.addEventListener('click', function (ev) {
          if (ev.target.closest('.contact-copy-btn')) return;
          applyActive(j);
        });
        row.addEventListener('focusin', function (ev) {
          if (ev.target.closest('.contact-copy-btn')) return;
          applyActive(j);
        });
      });
    })();

    (function initContactCopyButtons() {
      var bubbleEl = null;
      var bubbleTAuto = null;
      var bubbleTRemove = null;

      function clearBubbleHard() {
        if (bubbleTAuto) {
          window.clearTimeout(bubbleTAuto);
          bubbleTAuto = null;
        }
        if (bubbleTRemove) {
          window.clearTimeout(bubbleTRemove);
          bubbleTRemove = null;
        }
        if (bubbleEl && bubbleEl.parentNode) {
          bubbleEl.parentNode.removeChild(bubbleEl);
        }
        bubbleEl = null;
      }

      function hideBubbleAnimate() {
        if (!bubbleEl) return;
        bubbleEl.classList.remove('contact-copy-bubble--visible');
        if (bubbleTRemove) {
          window.clearTimeout(bubbleTRemove);
          bubbleTRemove = null;
        }
        bubbleTRemove = window.setTimeout(function () {
          if (bubbleEl && bubbleEl.parentNode) {
            bubbleEl.parentNode.removeChild(bubbleEl);
          }
          bubbleEl = null;
          bubbleTRemove = null;
        }, 220);
      }

      function showCopyBubble(anchorBtn, text) {
        clearBubbleHard();
        var bubble = document.createElement('div');
        bubble.className = 'contact-copy-bubble';
        bubble.textContent = text;
        bubble.setAttribute('role', 'status');
        bubble.style.visibility = 'hidden';
        document.body.appendChild(bubble);
        var r = anchorBtn.getBoundingClientRect();
        var bw = bubble.offsetWidth;
        var bh = bubble.offsetHeight;
        var pad = 8;
        var left = r.left + r.width / 2 - bw / 2;
        left = Math.max(pad, Math.min(left, window.innerWidth - bw - pad));
        var top = r.top - bh - pad;
        if (top < pad) {
          top = r.bottom + pad;
        }
        if (top + bh > window.innerHeight - pad) {
          top = Math.max(pad, r.top - bh - pad);
        }
        bubble.style.left = left + 'px';
        bubble.style.top = top + 'px';
        bubble.style.visibility = '';
        bubbleEl = bubble;
        window.requestAnimationFrame(function () {
          bubble.classList.add('contact-copy-bubble--visible');
        });
        bubbleTAuto = window.setTimeout(hideBubbleAnimate, 2400);
      }

      function writeClipboard(text) {
        if (navigator.clipboard && window.isSecureContext) {
          return navigator.clipboard.writeText(text);
        }
        return new Promise(function (resolve, reject) {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try {
            if (document.execCommand('copy')) resolve();
            else reject(new Error('execCommand'));
          } catch (e) {
            reject(e);
          } finally {
            document.body.removeChild(ta);
          }
        });
      }

      document.addEventListener('click', function (ev) {
        var t = ev.target;
        if (!t || !t.closest) return;
        var btn = t.closest('button[data-copy-value]');
        if (!btn) return;
        var text = btn.getAttribute('data-copy-value');
        if (!text) return;
        ev.preventDefault();
        ev.stopPropagation();
        writeClipboard(text)
          .then(function () {
            showCopyBubble(btn, contactCopyToast);
            btn.classList.add('contact-copy-btn--ok');
            if (!btn.dataset.copyAriaDefault) {
              btn.dataset.copyAriaDefault = btn.getAttribute('aria-label') || '';
            }
            btn.setAttribute('aria-label', contactCopied);
            window.setTimeout(function () {
              btn.classList.remove('contact-copy-btn--ok');
              var d = btn.dataset.copyAriaDefault;
              if (d !== undefined) btn.setAttribute('aria-label', d);
            }, 1600);
          })
          .catch(function () {
            /* ignore */
          });
      });
    })();

    (function initContactWindowChrome() {
      var root = document.querySelector('[data-contact-root]');
      var panel = document.getElementById('contact-window-panel');
      var restore = document.querySelector('[data-contact-restore]');
      var minBtn = document.querySelector('[data-contact-win-min]');
      var maxBtn = document.querySelector('[data-contact-win-max]');
      var closeBtn = document.querySelector('[data-contact-win-close]');
      if (!root || !panel || !restore || !minBtn || !maxBtn || !closeBtn) return;

      function isMax() {
        return panel.classList.contains('contact-window-frame--max');
      }
      function clearLayoutModes() {
        panel.classList.remove('contact-window-frame--min', 'contact-window-frame--max');
        root.classList.remove('hero-terminal-contacts--contact-max');
      }

      minBtn.addEventListener('click', function () {
        if (panel.hasAttribute('hidden')) return;
        if (isMax()) {
          root.classList.remove('hero-terminal-contacts--contact-max');
          panel.classList.remove('contact-window-frame--max');
        }
        panel.classList.toggle('contact-window-frame--min');
      });

      maxBtn.addEventListener('click', function () {
        if (panel.hasAttribute('hidden')) return;
        panel.classList.remove('contact-window-frame--min');
        if (isMax()) {
          panel.classList.remove('contact-window-frame--max');
          root.classList.remove('hero-terminal-contacts--contact-max');
        } else {
          panel.classList.add('contact-window-frame--max');
          root.classList.add('hero-terminal-contacts--contact-max');
        }
      });

      closeBtn.addEventListener('click', function () {
        clearLayoutModes();
        panel.classList.remove('contact-window-frame--min');
        panel.setAttribute('hidden', '');
        restore.removeAttribute('hidden');
        try {
          restore.focus();
        } catch (e) {
          /* ignore */
        }
      });

      restore.addEventListener('click', function () {
        panel.removeAttribute('hidden');
        restore.setAttribute('hidden', '');
        clearLayoutModes();
      });
    })();
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var eras = document.querySelectorAll('[data-project-era]');
    if (!eras.length || !('IntersectionObserver' in window)) return;
    var AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
    var audioCtx = AudioCtx ? new AudioCtx() : null;
    var audioUnlocked = false;
    var activeEra = null as Element | null;
    var hadFirstActivation = false;
    var eraNoiseBuffer: AudioBuffer | null = null;

    function unlockTimelineAudio() {
      if (!audioCtx || audioUnlocked) return;
      if (audioCtx.state === 'suspended') {
        audioCtx.resume().catch(function () {
          /* ignore */
        });
      }
      audioUnlocked = true;
    }

    function eraIndex(el: Element | null): number {
      if (!el) return -1;
      for (var i = 0; i < eras.length; i++) {
        if (eras[i] === el) return i;
      }
      return -1;
    }

    function ensureEraNoiseBuffer() {
      if (!audioCtx || eraNoiseBuffer) return;
      var samples = Math.floor(audioCtx.sampleRate * 0.09);
      var buf = audioCtx.createBuffer(1, samples, audioCtx.sampleRate);
      var ch = buf.getChannelData(0);
      for (var i = 0; i < samples; i++) {
        ch[i] = Math.random() * 2 - 1;
      }
      eraNoiseBuffer = buf;
    }

    /** Механика ленты: короткий щелчок + приглушённая прокрутка; ниже — уход в прошлое (индекс ↑), выше — к «настоящему». */
    function playMechanicalEraTransition(fromIdx: number, toIdx: number) {
      if (!audioCtx || !audioUnlocked) return;
      if (audioCtx.state === 'suspended') return;
      ensureEraNoiseBuffer();
      if (!eraNoiseBuffer) return;

      var dir = 0;
      if (fromIdx >= 0 && toIdx >= 0) {
        if (toIdx > fromIdx) dir = 1;
        else if (toIdx < fromIdx) dir = -1;
      }

      var toneMul = dir === 1 ? 0.88 : dir === -1 ? 1.12 : 1;
      var tapeGainMul = dir === 1 ? 1 : dir === -1 ? 0.92 : 0.85;

      var t0 = audioCtx.currentTime;

      var clickOsc = audioCtx.createOscillator();
      clickOsc.type = 'square';
      var clickGain = audioCtx.createGain();
      var clickHp = audioCtx.createBiquadFilter();
      clickHp.type = 'highpass';
      clickHp.frequency.value = 380;
      clickOsc.frequency.setValueAtTime(145 * toneMul, t0);
      clickOsc.frequency.exponentialRampToValueAtTime(62 * toneMul, t0 + 0.022);
      clickGain.gain.setValueAtTime(0.0001, t0);
      clickGain.gain.linearRampToValueAtTime(0.038 * toneMul, t0 + 0.003);
      clickGain.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.028);
      clickOsc.connect(clickHp);
      clickHp.connect(clickGain);
      clickGain.connect(audioCtx.destination);
      clickOsc.start(t0);
      clickOsc.stop(t0 + 0.032);

      var tapeT = t0 + 0.006;
      var tapeSrc = audioCtx.createBufferSource();
      tapeSrc.buffer = eraNoiseBuffer;
      var tapeBp = audioCtx.createBiquadFilter();
      tapeBp.type = 'bandpass';
      tapeBp.frequency.setValueAtTime(1650 * toneMul, tapeT);
      tapeBp.frequency.linearRampToValueAtTime(1180 * toneMul, tapeT + 0.078);
      tapeBp.Q.value = 2.1;
      var tapeGain = audioCtx.createGain();
      tapeGain.gain.setValueAtTime(0.0001, tapeT);
      tapeGain.gain.linearRampToValueAtTime(0.015 * tapeGainMul, tapeT + 0.018);
      tapeGain.gain.exponentialRampToValueAtTime(0.0001, tapeT + 0.088);
      tapeSrc.connect(tapeBp);
      tapeBp.connect(tapeGain);
      tapeGain.connect(audioCtx.destination);
      tapeSrc.start(tapeT);
      tapeSrc.stop(tapeT + 0.092);
    }

    document.addEventListener('pointerdown', unlockTimelineAudio, { once: true, passive: true });
    document.addEventListener('keydown', unlockTimelineAudio, { once: true });

    var ratios = new Map();
    for (var i = 0; i < eras.length; i++) {
      ratios.set(eras[i], 0);
    }
    var thresholds = [0, 0.08, 0.16, 0.28, 0.42, 0.58, 0.75, 0.92, 1];
    var narrow =
      typeof window.matchMedia !== 'undefined' && window.matchMedia('(max-width: 1023px)').matches;
    var rootMargin = narrow ? '-2% 0px -6% 0px' : '-12% 0px -24% 0px';
    var io = new IntersectionObserver(
      function (entries) {
        for (var j = 0; j < entries.length; j++) {
          ratios.set(entries[j].target, entries[j].intersectionRatio);
        }
        var best = null;
        var max = -1;
        for (var k = 0; k < eras.length; k++) {
          var el = eras[k];
          var r = ratios.get(el) || 0;
          if (r > max) {
            max = r;
            best = el;
          }
        }
        if (narrow && max <= 0.05 && eras.length) {
          best = eras[0];
          max = 0.06;
        }
        for (var m = 0; m < eras.length; m++) {
          eras[m].classList.toggle('project-era--active', eras[m] === best && max > 0.05);
        }
        var nextActive = max > 0.05 ? best : null;
        if (nextActive !== activeEra) {
          var prevIdx = eraIndex(activeEra);
          var nextIdx = eraIndex(nextActive);
          if (hadFirstActivation && nextIdx >= 0 && prevIdx >= 0) {
            playMechanicalEraTransition(prevIdx, nextIdx);
          } else if (hadFirstActivation && nextIdx >= 0 && prevIdx < 0) {
            playMechanicalEraTransition(-1, nextIdx);
          }
          activeEra = nextActive;
          hadFirstActivation = true;
        }
      },
      { threshold: thresholds, rootMargin: rootMargin }
    );
    for (var n = 0; n < eras.length; n++) {
      io.observe(eras[n]);
    }
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var selectors = [
      '.terminal-log--project',
      '.project-outbound-link',
      '.partner-showcase-link',
      '.tech-road__lane',
      '.tech-file-row',
    ];
    var targets = document.querySelectorAll(selectors.join(','));
    if (!targets.length) return;

    var AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
    if (!AudioCtx) return;

    var ctx = new AudioCtx();
    var unlocked = false;
    var lastPlayedAt = 0;

    function unlockAudioOnce() {
      if (unlocked) return;
      if (ctx.state === 'suspended') {
        ctx.resume().catch(function () {
          /* ignore */
        });
      }
      unlocked = true;
    }

    document.addEventListener('pointerdown', unlockAudioOnce, { once: true, passive: true });
    document.addEventListener('keydown', unlockAudioOnce, { once: true });

    function playHoverTone() {
      if (!unlocked) return;
      if (ctx.state === 'suspended') return;

      var nowMs = performance.now();
      if (nowMs - lastPlayedAt < 90) return;
      lastPlayedAt = nowMs;

      var now = ctx.currentTime;
      var osc = ctx.createOscillator();
      var gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(980, now);
      osc.frequency.exponentialRampToValueAtTime(740, now + 0.06);
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(0.028, now + 0.008);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.07);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.075);
    }

    targets.forEach(function (el) {
      el.addEventListener('pointerenter', playHoverTone, { passive: true });
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var zone = document.querySelector('[data-tech-focus-zone]');
    if (!zone) return;
    var techZone = zone as HTMLElement;

    function setActive(value: boolean) {
      techZone.classList.toggle('is-active', value);
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setActive(true);
      return;
    }

    techZone.addEventListener('mouseenter', function () {
      setActive(true);
    });
    techZone.addEventListener('mouseleave', function () {
      setActive(false);
    });
    techZone.addEventListener('focusin', function () {
      setActive(true);
    });
    techZone.addEventListener('focusout', function () {
      setActive(false);
    });

    if (!('IntersectionObserver' in window)) {
      setActive(true);
      return;
    }

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.target === techZone) {
            setActive(entry.intersectionRatio > 0.32);
          }
        });
      },
      { threshold: [0, 0.16, 0.32, 0.55, 0.8], rootMargin: '-12% 0px -12% 0px' }
    );
    io.observe(techZone);
  });
</script>
