---
import type { Lang, ProjectOutboundKind } from '../i18n/cv-data';
import { getCv } from '../i18n/cv-data';
import { resolveProjectCaseLinks } from '../lib/resolve-project-case-links';
import {
  AVATAR_SHUTTER_MP3,
  AVATAR_SHUTTER_PLAY_MS,
  AVATAR_STACK_SLIDES,
  avatarSlideLabel,
} from '../config/avatar-experience';
import AvatarViewfinderOverlay from './AvatarViewfinderOverlay.astro';
import ContactCopyIcon from './ContactCopyIcon.astro';
import LiveStatusInit from './LiveStatusInit.astro';
import TechRoadmap from './TechRoadmap.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getCv(lang);
const s = t.sections;
const projectGroupsWithCaseLink = await resolveProjectCaseLinks(s.experience.projectGroups);
const L = t.terminalLabels;
/** Точки polyline в viewBox 0 0 64 22 — разный рисунок для каждого блока */
const SUCCESS_PATH_SPARKS: readonly string[] = [
  '2,18 8,6 14,15 21,5 28,14 36,4 44,12 52,7 60,3',
  '2,5 10,16 20,19 30,8 40,13 50,5 58,3 62,2',
  '2,19 12,16 24,8 34,12 45,3 55,9 62,2',
  '2,12 11,3 20,17 30,6 40,14 50,5 58,11 62,2',
  '2,20 16,16 30,10 42,6 52,4 58,2 62,1',
];
const SUCCESS_PATH_SPARK_STROKES: readonly string[] = [
  '#38bdf8',
  '#2dd4bf',
  '#4ade80',
  '#a78bfa',
  '#fbbf24',
];
function successPathSparkPoints(i: number): string {
  return SUCCESS_PATH_SPARKS[i % SUCCESS_PATH_SPARKS.length] ?? SUCCESS_PATH_SPARKS[0];
}
function successPathSparkStroke(i: number): string {
  return SUCCESS_PATH_SPARK_STROKES[i % SUCCESS_PATH_SPARK_STROKES.length] ?? SUCCESS_PATH_SPARK_STROKES[0];
}

function projectLinkLabel(kind: ProjectOutboundKind, L: typeof t.terminalLabels): string {
  switch (kind) {
    case 'partner':
      return L.projectLinkPartner;
    case 'customer':
      return L.projectLinkCustomer;
    default:
      return L.projectLinkWebsite;
  }
}

function projectLinkClass(kind: ProjectOutboundKind): string {
  const base =
    'project-outbound-link inline-flex items-center gap-1.5 rounded border px-2.5 py-1 font-mono text-xs leading-snug underline-offset-4 transition-colors hover:underline';
  switch (kind) {
    case 'partner':
      return `${base} border-amber-500/40 text-amber-300/95 hover:border-amber-400/55 hover:bg-amber-500/10 hover:text-amber-200`;
    case 'customer':
      return `${base} border-cyan-500/40 text-cyan-300/95 hover:border-cyan-400/55 hover:bg-cyan-500/10 hover:text-cyan-200`;
    default:
      return `${base} border-slate-600/55 text-slate-300 hover:border-slate-500/70 hover:bg-slate-800/40 hover:text-slate-100`;
  }
}
const boot = t.bootLines;
const stackSlides = AVATAR_STACK_SLIDES.map((slide) => ({
  id: slide.id,
  src: slide.src,
  webpSrc: slide.webpSrc,
  label: avatarSlideLabel(slide, lang),
}));
const TELEGRAM_HANDLE = '@DJES240285';
const TELEGRAM_URL = 'https://t.me/DJES240285';
const treeRowId = (i: number) => `contact-tree-row-${i}`;
const emailRowCount = t.contact.emails.length;
const idxTelegram = emailRowCount;
const idxMaxPhone = emailRowCount + 1;
const idxMaxProfile = emailRowCount + 2;
const idxLinkedin = emailRowCount + 3;
const audienceConsoleTitle = lang === 'ru' ? 'ПРОФИЛЬНЫЙ КОНТЕКСТ' : 'PROFILE CONTEXT';
const techLegend =
  lang === 'ru'
    ? 'Роадмап моей практики: стек, с которым работаю в реальных проектах — от платформ и backend до данных, инфраструктуры и delivery.'
    : 'A roadmap of my practical stack: tools I use in real projects, from platforms and backend to data, infrastructure, and delivery.';
const audienceMode = {
  storageKey: 'audience-mode-v1',
  defaultMode: 'default',
  modes:
    lang === 'ru'
      ? {
          default: { label: 'По умолчанию' },
          client: {
            label: 'Я клиент',
            role: 'Инженер восстановления систем · fullstack · архитектор',
            tagline:
              'Беру контур под ответственность: меньше риска в релизах, понятный план, измеримый эффект для бизнеса.',
            about:
              'Вам нужен не набор “фич”, а предсказуемость: когда прод уже в бою, а каждое изменение — лотерея. Подключаюсь за диагностикой, планом и внедрением, которое переживёт следующий релиз.',
            collaboration:
              'До старта — цель, ограничения, критерии успеха; в работе — короткие статусы про риски, сроки и эффект, без лишней бюрократии. Договор и отчётность — через партнёра при необходимости; инженерная ответственность остаётся на мне.',
            help: [
              'Пожары в легаси → релизный ритм, который можно планировать',
              'Миграция платформы → этапы без остановки витрины и критичных процессов',
              'Медленные сценарии → ускорение там, где бьёт по конверсии и операциям',
              'Один ответственный контур: от архитектуры до мониторинга в проде',
            ],
            highlights: [
              'Кейсы, где простой стоит денег — e-commerce, кабинеты, интеграции',
              'Честные trade-off: что делаем сейчас, что откладываем и почему',
              'Результат в метриках бизнеса, а не в объёме закрытых тикетов',
            ],
            approachTitle: 'Для заказчика: сначала снять риск, потом ускорить рост.',
            approachBodies: [
              'Диагностика симптомов и корневых причин до масштабных переделок.',
              'План с этапами: быстрые стабилизирующие шаги и долгосрочная архитектура.',
              'Прозрачные варианты: срок, стоимость, риск — выбор осознанный.',
              'После релиза система остаётся вашим активом, а не чёрным ящиком подрядчика.',
            ],
            avatarId: 'clean',
          },
        }
      : {
          default: { label: 'Default' },
          client: {
            label: 'I am a client',
            role: 'System rescue engineer · fullstack · architect',
            tagline:
              'I own the contur end to end: less release risk, a clear plan, measurable business impact.',
            about:
              'You need predictability—not feature noise—when production is live and every deploy feels like a bet. I step in for triage, a staged plan, and delivery that survives the next release.',
            collaboration:
              'Up front: goals, constraints, success criteria; in flight: short updates on risk, timing, and impact. Contracts can run through a partner; engineering ownership stays with me.',
            help: [
              'Legacy firefighting → a release cadence you can plan around',
              'Platform migration → phased moves without pausing critical sales',
              'Slow paths → speed where it hits conversion and operations',
              'One ownership thread: architecture through production monitoring',
            ],
            highlights: [
              'Engagements where downtime has a price tag',
              'Explicit trade-offs: what we do now, defer, and why',
              'Outcomes in business metrics—not ticket volume',
            ],
            approachTitle: 'For clients: de-risk first, then accelerate growth.',
            approachBodies: [
              'Triage symptoms and root causes before large rewrites.',
              'Staged plan: quick stabilizers plus longer-term architecture.',
              'Transparent options: time, cost, risk—decisions stay explicit.',
              'After release the system remains your asset, not a contractor black box.',
            ],
            avatarId: 'clean',
          },
        },
} as const;
---

<main class="terminal-page-root mx-auto px-4 pb-16 pt-8 sm:px-6 sm:pt-12">
  <section class="terminal-module terminal-module--window reveal-2026" style="--reveal-delay: 80ms">
    <header class="terminal-module-windowbar">
      <p class="terminal-module-windowbar__title" aria-hidden="true">{L.heroWindowTitle}</p>
      <div class="terminal-window-controls" role="group" aria-label={lang === 'ru' ? 'Декор окна' : 'Window decoration'}>
        <span class="terminal-window-btn terminal-window-btn--min" aria-hidden="true"></span>
        <span class="terminal-window-btn terminal-window-btn--max" aria-hidden="true"></span>
        <button
          type="button"
          class="terminal-window-btn terminal-window-btn--close"
          data-hero-terminal-close
          aria-label={
            lang === 'ru'
              ? 'Закрыть вкладку или вернуться назад'
              : 'Close tab or go back to the previous page'
          }></button>
      </div>
    </header>
    <div class="terminal-module__shell p-5 sm:p-7">
    <section class="audience-console w-full" data-audience-switch data-audience-onboarding>
      <div class="audience-console__title-line">{audienceConsoleTitle}</div>
      <div class="audience-console__viewport" aria-live="polite">
        {
          boot.map((line, i) => (
            <p class="boot-line audience-console__line">
              {line}
              {i === boot.length - 1 ? <span class="terminal-caret" aria-hidden="true" /> : null}
            </p>
          ))
        }
        <p class="audience-console__line audience-console__line--question audience-onboarding__prompt">
          {lang === 'ru' ? '> кто вы?' : '> who are you?'}
        </p>
        <div class="audience-mode-switch" role="group" aria-label={lang === 'ru' ? 'Выбор сценария просмотра' : 'Select viewing scenario'}>
          <button type="button" class="audience-mode-btn" data-audience-mode-btn="default">
            {audienceMode.modes.default.label}
          </button>
          <button type="button" class="audience-mode-btn" data-audience-mode-btn="client">
            {audienceMode.modes.client.label}
          </button>
        </div>
      </div>
    </section>
    <div class="hero-terminal-grid mt-6">
      <div class="hero-terminal-avatar flex flex-col items-center lg:items-start">
        <div
          class="avatar-terminal-group"
          role="button"
          tabindex="0"
          data-avatar-stack
          aria-label={
            lang === 'ru'
              ? 'Фото профиля: кадр стека. Наведите — видоискатель. Клик или Enter — следующий кадр; после клика прицел скрывается, пока курсор над блоком, чтобы был виден кадр.'
              : 'Profile stack: hover for viewfinder. Click or Enter for next frame; after click the overlay hides while the pointer stays so the new frame is visible.'
          }
        >
          <div class="avatar-terminal-frame">
            <div class="avatar-terminal-inner hud-frame">
              <div class="avatar-terminal-deco" aria-hidden="true" />
              <div class="avatar-terminal-slot-window">
                <picture data-avatar-picture>
                  <source type="image/webp" srcset={AVATAR_STACK_SLIDES[0].webpSrc} data-avatar-webp-source />
                  <img
                    class="avatar-terminal-slot-img"
                    data-avatar-slot
                    src={AVATAR_STACK_SLIDES[0].src}
                    alt=""
                    width="256"
                    height="256"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                  />
                </picture>
                <AvatarViewfinderOverlay />
                <div class="avatar-terminal-crt" aria-hidden="true" />
              </div>
            </div>
          </div>
          <p class="avatar-stack-chip" data-avatar-chip aria-live="polite">
            {avatarSlideLabel(AVATAR_STACK_SLIDES[0], lang)}
          </p>
        </div>
        <div class="hero-terminal-avatar-hud mt-4 w-full max-w-[320px]">
          <div class="contact-terminal-card hero-hud-card hud-mini">
            <div class="hero-hud-fact">
              <p class="hero-hud-fact__label">{L.hudStatus}</p>
              <p class="hero-hud-fact__value" aria-live="polite">
                <span class="hero-hud-fact__prompt">&gt;</span>
                <span class="hero-live-status-row">
                  <span class="hero-live-status__dot" id="hero-live-status-dot" aria-hidden="true"></span>
                  <span id="hero-live-status">—</span>
                </span>
              </p>
            </div>
            {
              t.heroHudFacts.map((row) => (
                <div class="hero-hud-fact">
                  <p class="hero-hud-fact__label">{row.label}</p>
                  <p class="hero-hud-fact__value">
                    <span class="hero-hud-fact__prompt">&gt;</span>
                    <span id="hero-hud-fact-value">{row.value}</span>
                  </p>
                </div>
              ))
            }
            <div class="hero-hud-card__meter" aria-hidden="true" />
          </div>
        </div>
      </div>
      <div class="hero-terminal-intro min-w-0">
        <h1 class="retro-heading-soft text-2xl font-bold uppercase leading-snug text-slate-100 sm:text-3xl">
          {t.name}
        </h1>
        <p class="mt-2 font-mono text-base uppercase tracking-wide text-cyan-300 sm:text-lg" data-audience-role>{t.role}</p>
        <p class="hero-tagline mt-2 text-pretty text-sm leading-relaxed text-slate-400 sm:text-base" data-audience-tagline>
          {t.summary}
        </p>
        <div
          class="hero-console mt-4"
          data-hero-console
          data-booting
          aria-label={t.summary}
        >
          <div class="hero-console__title-line" data-hero-console-title></div>
          <div class="hero-console__viewport" data-hero-console-viewport aria-live="polite"></div>
        </div>
      </div>
      <div class="hero-terminal-contacts min-w-0" data-contact-root>
        <div
          id="contact-window-panel"
          class="contact-window-frame"
          data-contact-window
          role="group"
          aria-label={
            lang === 'ru'
              ? 'Каналы связи: email, мессенджеры, LinkedIn'
              : 'Contact channels: email, messengers, LinkedIn'
          }
        >
          <div
            class="contact-window-titlebar"
            role="toolbar"
            aria-label={lang === 'ru' ? 'Управление окном контактов' : 'Contact window controls'}
          >
            <p class="contact-window-title" aria-hidden="true">{L.contactWindowTitle}</p>
            <div class="terminal-window-controls">
              <button
                type="button"
                class="terminal-window-btn terminal-window-btn--min"
                aria-label={L.contactWinMinAria}
                data-contact-win-min></button>
              <button
                type="button"
                class="terminal-window-btn terminal-window-btn--max"
                aria-label={L.contactWinMaxAria}
                data-contact-win-max></button>
              <button
                type="button"
                class="terminal-window-btn terminal-window-btn--close"
                aria-label={L.contactWinCloseAria}
                data-contact-win-close></button>
            </div>
          </div>
          <div class="contact-window-body" data-contact-window-body>
        <div class="contact-terminal-stack">
          <div
            class="contact-file-tree contact-terminal-card contact-terminal-card--concept hud-mini"
            data-contact-file-tree
            role="region"
            tabindex="0"
            aria-label={
              lang === 'ru'
                ? 'Контакты: стрелки вверх и вниз для перехода по строкам'
                : 'Contacts: Up and Down arrows move between rows'
            }
          >
            <div class="contact-file-tree__section">
              <div class="contact-concept-head">
                <img
                  class="contact-concept-icon"
                  src="/logo-mail.svg"
                  alt=""
                  width="20"
                  height="20"
                  loading="lazy"
                  decoding="async"
                  aria-hidden="true"
                />
                <p class="contact-concept-tag">{L.email}</p>
              </div>
              <div class="contact-file-tree__panel contact-terminal-email-body">
                <ul class="contact-file-tree__list" role="list">
                  {
                    t.contact.emails.map((email, i) => (
                      <li
                        class:list={['contact-file-tree__row', { 'contact-file-tree__row--active': i === 0 }]}
                        data-tree-row
                        id={treeRowId(i)}
                        aria-current={i === 0 ? 'true' : 'false'}
                      >
                        <a href={`mailto:${email}`} class="contact-file-tree__primary contact-terminal-email-link">
                          {email}
                        </a>
                        <button
                          type="button"
                          class="contact-copy-btn"
                          data-copy-value={email}
                          aria-label={L.contactCopyEmailAria}
                          title={email}
                          tabindex="0"
                        >
                          <ContactCopyIcon class="contact-copy-btn__glyph" />
                        </button>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>

            <div class="contact-file-tree__section">
              <div class="contact-concept-head contact-file-tree__section-head">
                <img
                  class="contact-concept-icon"
                  src="/logo-telegram.svg"
                  alt=""
                  width="20"
                  height="20"
                  loading="lazy"
                  decoding="async"
                  aria-hidden="true"
                />
                <p class="contact-concept-tag">{L.telegram}</p>
              </div>
              <div class="contact-file-tree__panel contact-terminal-email-body">
                <ul class="contact-file-tree__list" role="list">
                  <li
                    class="contact-file-tree__row"
                    data-tree-row
                    id={treeRowId(idxTelegram)}
                    aria-current="false"
                  >
                    <a
                      class="contact-file-tree__primary"
                      href={TELEGRAM_URL}
                      target="_blank"
                      rel="noreferrer noopener"
                    >
                      {TELEGRAM_HANDLE}
                    </a>
                    <button
                      type="button"
                      class="contact-copy-btn"
                      data-copy-value={TELEGRAM_URL}
                      aria-label={L.contactCopyLinkAria}
                      title={TELEGRAM_URL}
                      tabindex="0"
                    >
                      <ContactCopyIcon class="contact-copy-btn__glyph" />
                    </button>
                  </li>
                </ul>
              </div>
            </div>

            <div class="contact-file-tree__section">
              <div class="contact-concept-head contact-file-tree__section-head">
                <img
                  class="contact-concept-icon contact-concept-icon--max"
                  src="/logo-max.svg"
                  alt=""
                  width="20"
                  height="20"
                  loading="lazy"
                  decoding="async"
                  aria-hidden="true"
                />
                <p class="contact-concept-tag">{L.max}</p>
              </div>
              <div class="contact-file-tree__panel contact-terminal-email-body">
                <ul class="contact-file-tree__list" role="list">
                  <li
                    class="contact-file-tree__row"
                    data-tree-row
                    id={treeRowId(idxMaxPhone)}
                    aria-current="false"
                  >
                    <a
                      class="contact-file-tree__primary"
                      href={`tel:${t.contact.maxTel}`}
                    >
                      {t.contact.maxInvite}
                    </a>
                    <button
                      type="button"
                      class="contact-copy-btn"
                      data-copy-value={t.contact.maxTel}
                      aria-label={L.contactCopyPhoneAria}
                      title={t.contact.maxTel}
                      tabindex="0"
                    >
                      <ContactCopyIcon class="contact-copy-btn__glyph" />
                    </button>
                  </li>
                  <li
                    class="contact-file-tree__row"
                    data-tree-row
                    id={treeRowId(idxMaxProfile)}
                    aria-current="false"
                  >
                    <a
                      class="contact-file-tree__primary contact-file-tree__primary--link"
                      href={t.contact.maxHref}
                      target="_blank"
                      rel="noreferrer noopener"
                    >
                      {L.maxProfileLink}
                    </a>
                    <button
                      type="button"
                      class="contact-copy-btn"
                      data-copy-value={t.contact.maxHref}
                      aria-label={L.contactCopyLinkAria}
                      title={t.contact.maxHref}
                      tabindex="0"
                    >
                      <ContactCopyIcon class="contact-copy-btn__glyph" />
                    </button>
                  </li>
                </ul>
              </div>
            </div>

            <div class="contact-file-tree__section">
              <div class="contact-concept-head contact-file-tree__section-head">
                <img
                  class="contact-concept-icon"
                  src="/logo-linkedin.svg"
                  alt=""
                  width="20"
                  height="20"
                  loading="lazy"
                  decoding="async"
                  aria-hidden="true"
                />
                <p class="contact-concept-tag">{L.linkedin}</p>
              </div>
              <div class="contact-file-tree__panel contact-terminal-email-body">
                <ul class="contact-file-tree__list" role="list">
                  <li
                    class="contact-file-tree__row"
                    data-tree-row
                    id={treeRowId(idxLinkedin)}
                    aria-current="false"
                  >
                    <a
                      class="contact-file-tree__primary contact-file-tree__primary--link"
                      href={t.contact.linkedinHref}
                      target="_blank"
                      rel="noreferrer noopener"
                    >
                      {t.contact.linkedinLabel}
                    </a>
                    <button
                      type="button"
                      class="contact-copy-btn"
                      data-copy-value={t.contact.linkedinHref}
                      aria-label={L.contactCopyLinkAria}
                      title={t.contact.linkedinHref}
                      tabindex="0"
                    >
                      <ContactCopyIcon class="contact-copy-btn__glyph" />
                    </button>
                  </li>
                </ul>
              </div>
              <div class="contact-terminal-linkedin-meter mt-2" aria-hidden="true" />
            </div>
          </div>
        </div>
          </div>
        </div>
        <button
          type="button"
          class="contact-window-restore-btn"
          hidden
          data-contact-restore
          aria-label={L.contactRestore}
        >
          {L.contactRestore}
        </button>
      </div>
    </div>
    </div>
  </section>

  <div class="terminal-stack mt-[22px] grid gap-[22px] lg:grid-cols-3">
    <div class="space-y-[22px] lg:col-span-2">
      <article class="terminal-module reveal-2026 p-5 sm:p-6" data-audience-card style="--reveal-delay: 100ms">
        <h2 class="terminal-label">{L.about}</h2>
        <p class="mt-3 text-pretty text-slate-300" data-audience-about>{s.about.body}</p>
      </article>

      <article class="terminal-module reveal-2026 p-5 sm:p-6" data-audience-card style="--reveal-delay: 110ms">
        <h2 class="terminal-label">{L.collaboration}</h2>
        <p class="mt-3 text-pretty text-slate-300" data-audience-collaboration>{s.collaboration.body}</p>
      </article>

      <article class="terminal-module reveal-2026 p-5 sm:p-6" data-audience-card style="--reveal-delay: 120ms">
        <h2 class="terminal-label">{L.help}</h2>
        <ul class="mt-3 space-y-2 text-slate-300" data-audience-help>
          {s.help.items.map((item) => (
            <li class="terminal-list-item text-pretty">{item}</li>
          ))}
        </ul>
      </article>

      <article
        class="terminal-module terminal-module--success-path reveal-2026 p-5 sm:p-6"
        style="--reveal-delay: 130ms"
      >
        <header class="success-path-module__head">
          <span class="success-path-module__folder" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path
                fill="rgba(34, 211, 238, 0.95)"
                d="M10 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V8a2 2 0 00-2-2h-8l-2-2z"
              />
              <path fill="rgba(6, 182, 212, 0.75)" d="M10 4h10v4H8l2-4z" />
            </svg>
          </span>
          <h2 class="terminal-label success-path-module__title">{L.successPath}</h2>
        </header>
        <ol class="success-path mt-4">
          {
            t.careerPath.map((m, idx, arr) => (
