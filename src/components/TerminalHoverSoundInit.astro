---
/** Короткий hover-тон (как на резюме); делегирование — работает при прокрутке списка. */
interface Props {
  selectors: string;
  /** Ограничить область (например .mc-case-log) */
  rootSelector?: string;
}

const { selectors, rootSelector } = Astro.props;
---

<script define:vars={{ selectors, rootSelector }}>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var root = rootSelector ? document.querySelector(rootSelector) : document;
    if (!root) return;

    var AudioCtx = window.AudioContext || window.webkitAudioContext;
    if (!AudioCtx) return;

    var ctx = new AudioCtx();
    var unlocked = false;
    var lastPlayedAt = 0;
    var lastRow = null;

    function unlockAudioOnce() {
      if (unlocked) return;
      if (ctx.state === 'suspended') {
        ctx.resume().catch(function () {
          /* ignore */
        });
      }
      unlocked = true;
    }

    document.addEventListener('pointerdown', unlockAudioOnce, { once: true, passive: true });
    document.addEventListener('keydown', unlockAudioOnce, { once: true });

    function playHoverTone() {
      if (!unlocked) return;
      if (ctx.state === 'suspended') return;

      var nowMs = performance.now();
      if (nowMs - lastPlayedAt < 90) return;
      lastPlayedAt = nowMs;

      var now = ctx.currentTime;
      var osc = ctx.createOscillator();
      var gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(980, now);
      osc.frequency.exponentialRampToValueAtTime(740, now + 0.06);
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(0.028, now + 0.008);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.07);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.075);
    }

    root.addEventListener(
      'pointerover',
      function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var row = t.closest(selectors);
        if (!row || row === lastRow) return;
        lastRow = row;
        playHoverTone();
      },
      { passive: true }
    );

    root.addEventListener(
      'pointerout',
      function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var row = t.closest(selectors);
        if (!row) return;
        var rel = e.relatedTarget;
        if (rel && row.contains(rel)) return;
        if (lastRow === row) lastRow = null;
      },
      { passive: true }
    );
  });
</script>
