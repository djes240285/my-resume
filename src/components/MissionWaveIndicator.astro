---
import type { MindsetIndicatorVariant } from '../i18n/mission-control-data';

interface Props {
  variant: MindsetIndicatorVariant;
  label: string;
  waveIndex: number;
}

const { variant, label, waveIndex } = Astro.props;

const WAVE_POINTS: readonly string[] = [
  '2,18 8,6 14,15 21,5 28,14 36,4 44,12 52,7 60,3',
  '2,5 10,16 20,19 30,8 40,13 50,5 58,3 62,2',
  '2,19 12,16 24,8 34,12 45,3 55,9 62,2',
  '2,12 11,3 20,17 30,6 40,14 50,5 58,11 62,2',
];

const WAVE_STROKES: readonly string[] = ['#38bdf8', '#22d3ee', '#4ade80', '#a78bfa'];
const points = WAVE_POINTS[waveIndex % WAVE_POINTS.length];
const stroke = WAVE_STROKES[waveIndex % WAVE_STROKES.length];
---

<div
  class:list={['mc-wave-indicator', `mc-wave-indicator--${variant}`, `mc-wave-indicator--tone-${waveIndex % 4}`]}
  aria-hidden="true"
>
  <p class="mc-wave-indicator__label">{label}</p>
  <div class="mc-wave-indicator__body">
    {
      variant === 'audit' ? (
        <svg class="mc-wave-indicator__glyph" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="3.5" y="5" width="11" height="9" rx="1" fill="none" stroke="currentColor" stroke-width="1.15" />
          <path d="M5.5 8h5M5.5 10.5h3.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
          <circle cx="16.5" cy="16.5" r="3.5" fill="none" stroke="currentColor" stroke-width="1.15" />
          <path d="M19 19l2.5 2.5" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" />
          <path d="M12 11.5l2.2 2.2" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.85" />
        </svg>
      ) : variant === 'regime' ? (
        <svg class="mc-wave-indicator__glyph" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="6" cy="5" r="2" fill="none" stroke="currentColor" stroke-width="1.15" />
          <circle cx="6" cy="19" r="2" fill="none" stroke="currentColor" stroke-width="1.15" />
          <circle cx="18" cy="12" r="2" fill="none" stroke="currentColor" stroke-width="1.15" />
          <path
            d="M6 7v10M8 5h8M8 19h8M16 10v4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.1"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path d="M11 12h5" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.7" />
        </svg>
      ) : variant === 'scale' ? (
        <svg class="mc-wave-indicator__glyph" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="4" y="14" width="5" height="5" rx="0.5" fill="none" stroke="currentColor" stroke-width="1.1" />
          <rect x="10" y="10" width="5" height="9" rx="0.5" fill="none" stroke="currentColor" stroke-width="1.1" />
          <rect x="16" y="6" width="5" height="13" rx="0.5" fill="none" stroke="currentColor" stroke-width="1.1" />
          <path d="M4 20h16" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.55" />
        </svg>
      ) : (
        <svg class="mc-wave-indicator__glyph" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="3" y="4" width="18" height="4.5" rx="0.5" fill="none" stroke="currentColor" stroke-width="1.1" />
          <rect x="3" y="10" width="18" height="4.5" rx="0.5" fill="none" stroke="currentColor" stroke-width="1.1" />
          <rect x="3" y="16" width="18" height="4.5" rx="0.5" fill="none" stroke="currentColor" stroke-width="1.1" />
          <path d="M6 6.2h2M6 12.2h2M6 18.2h2" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" opacity="0.75" />
        </svg>
      )
    }
    <svg
      class="mc-wave-indicator__wave"
      viewBox="0 0 64 22"
      xmlns="http://www.w3.org/2000/svg"
      overflow="visible"
      aria-hidden="true"
    >
      <polyline
        fill="none"
        stroke={stroke}
        stroke-width="1.65"
        stroke-linecap="round"
        stroke-linejoin="round"
        points={points}
      />
    </svg>
  </div>
</div>
