---
import type { CoreStatIcon } from '../i18n/cv-data';

interface Props {
  name: CoreStatIcon;
}

const { name } = Astro.props;
---

<svg class="mission-readout__ico" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
  {
    name === 'target' && (
      <>
        <circle cx="10" cy="10" r="2" fill="currentColor" />
        <circle cx="10" cy="10" r="4.2" fill="none" stroke="currentColor" stroke-width="1.05" />
        <circle cx="10" cy="10" r="6.6" fill="none" stroke="currentColor" stroke-width="1.1" />
        <path
          d="M10 2.8v1.6M10 15.6v1.6M2.8 10h1.6M15.6 10h1.6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.05"
          stroke-linecap="round"
        />
      </>
    )
  }
  {
    name === 'layers' && (
      <>
        <rect x="4.2" y="6.8" width="11.6" height="8.2" rx="0.85" fill="none" stroke="currentColor" stroke-width="1.1" />
        <rect x="5.2" y="4.2" width="11.6" height="8.2" rx="0.85" fill="none" stroke="currentColor" stroke-width="1.1" />
      </>
    )
  }
  {
    name === 'platform' && (
      <>
        <rect x="3.6" y="3.6" width="12.8" height="12.8" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.1" />
        <path
          d="M6.8 14V6.6L10 11.2l3.2-4.6V14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.15"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </>
    )
  }
  {
    name === 'trend' && (
      <>
        <path d="M3 15.5h14" fill="none" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
        <path
          d="M3.5 12.5 L7 9.5 L10.5 10.5 L14 6.5 L16.5 4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.15"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path d="M14.5 6.5h2v2" fill="none" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
      </>
    )
  }
  {
    name === 'junction' && (
      <>
        <circle cx="6.3" cy="10" r="2.1" fill="none" stroke="currentColor" stroke-width="1.1" />
        <circle cx="13.7" cy="10" r="2.1" fill="none" stroke="currentColor" stroke-width="1.1" />
        <path d="M8.45 10h3.1" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
      </>
    )
  }
</svg>
