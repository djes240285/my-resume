---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ResumeMain from '../../components/ResumeMain.astro';
import MissionResume from '../../components/MissionResume.astro';
import { SUPPORTED_LANGS, getCv, isLang } from '../../i18n/cv-data';
import { SITE_SHOW_RESUME } from '../../config/site';

export function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang: raw } = Astro.params;
if (!isLang(raw)) {
  return Astro.redirect('/en/', 302);
}

const lang = raw;
const t = getCv(lang);
const pageTitle = SITE_SHOW_RESUME ? t.metaTitle : t.mission.metaTitle;
const pageDescription = SITE_SHOW_RESUME ? t.metaDescription : t.mission.metaDescription;
---

<SiteLayout lang={lang} title={pageTitle} description={pageDescription}>
  {SITE_SHOW_RESUME ? <ResumeMain lang={lang} /> : <MissionResume lang={lang} />}
</SiteLayout>
