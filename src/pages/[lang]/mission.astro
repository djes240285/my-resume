---
import SiteLayout from '../../layouts/SiteLayout.astro';
import MissionResume from '../../components/MissionResume.astro';
import { SUPPORTED_LANGS, isLang } from '../../i18n/cv-data';
import { getMissionControl } from '../../i18n/mission-control-data';

export function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang: raw } = Astro.params;
if (!isLang(raw)) {
  return Astro.redirect('/en/mission', 302);
}

const lang = raw;
const mc = getMissionControl(lang);
---

<SiteLayout lang={lang} title={mc.metaTitle} description={mc.metaDescription}>
  <MissionResume lang={lang} />
</SiteLayout>
