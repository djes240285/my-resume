---
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>…</title>
    <script is:inline>
      (function () {
        function go(path) {
          try {
            location.replace(path);
          } catch (e) {
            location.href = path;
          }
        }
        function fromCookie() {
          var m = document.cookie.match(/(?:^|; )site_lang=(ru|en)(?:;|$)/);
          return m ? m[1] : null;
        }
        function fromNavigator() {
          var n = (navigator.language || 'en').slice(0, 2).toLowerCase();
          return n === 'ru' ? 'ru' : 'en';
        }
        /** Язык по сайту, с которого пришли (referrer), без блокировки нейтральных источников */
        function fromReferrer() {
          var ref = document.referrer;
          if (!ref) return null;
          var host;
          try {
            host = new URL(ref).hostname.toLowerCase();
          } catch (e) {
            return null;
          }
          if (!host || host === 'localhost' || host.endsWith('.localhost') || host.endsWith('.local')) {
            return null;
          }
          var parts = host.split('.');
          var tld = parts[parts.length - 1];
          var cisTld = {
            ru: 1,
            by: 1,
            kz: 1,
            ua: 1,
            am: 1,
            az: 1,
            ge: 1,
            md: 1,
            tj: 1,
            tm: 1,
            uz: 1,
            kg: 1,
            рф: 1,
            su: 1,
          };
          if (cisTld[tld]) return 'ru';
          var ruHosts = [
            'habr.com',
            'vk.com',
            'ok.ru',
            'mail.ru',
            'ya.ru',
            'yandex.ru',
            'yandex.by',
            'yandex.kz',
            'dzen.ru',
            'vc.ru',
            'pikabu.ru',
            't.me',
            'e.mail.ru',
          ];
          for (var i = 0; i < ruHosts.length; i++) {
            var h = ruHosts[i];
            if (host === h || host.endsWith('.' + h)) return 'ru';
          }
          return null;
        }
        var c = fromCookie();
        if (c === 'ru' || c === 'en') {
          go('/' + c + '/');
          return;
        }
        var refLang = fromReferrer();
        if (refLang === 'ru') {
          go('/ru/');
          return;
        }
        fetch('https://ipapi.co/country_code/', { cache: 'no-store' })
          .then(function (r) {
            return r.text();
          })
          .then(function (text) {
            var cc = (text || '').trim().toUpperCase();
            var cis = {
              RU: 1,
              BY: 1,
              KZ: 1,
              UA: 1,
              AM: 1,
              AZ: 1,
              GE: 1,
              MD: 1,
              TJ: 1,
              TM: 1,
              UZ: 1,
              KG: 1,
            };
            go(cis[cc] ? '/ru/' : '/en/');
          })
          .catch(function () {
            go(fromNavigator() === 'ru' ? '/ru/' : '/en/');
          });
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/en/" />
    </noscript>
  </head>
  <body style="font-family: system-ui; margin: 0; padding: 2rem; background: #f8fafc; color: #0f172a">
    <p style="max-width: 40rem; line-height: 1.6">
      Перенаправление по языку… Если страница не обновилась,
      <a href="/ru/">откройте русскую версию</a>
      или
      <a href="/en/">English version</a>.
    </p>
  </body>
</html>
