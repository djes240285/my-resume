{
  "name": "ezhukov-site",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.1.38",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "node ./scripts/run-dev.mjs",
    "build": "astro build",
    "build:verbose": "astro build --verbose",
    "preview": "astro preview",
    "a11y:check": "npx @axe-core/cli http://127.0.0.1:4321/ru/ http://127.0.0.1:4321/ru/portfolio --tags wcag2a,wcag2aa --save ./a11y-report.json",
    "astro": "astro",
    "previews:fetch": "node ./scripts/fetch-portfolio-previews.mjs",
    "content:seed": "bun run scripts/seed-content-yaml.ts",
    "activity:scan": "node ./scripts/scan-git-contours.mjs",
    "contact-pin:pixelate": "node ./scripts/pixelate-contact-pin.mjs",
    "contact-pin:mario": "node ./scripts/pixelate-contact-pin-mario.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.6",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/press-start-2p": "^5.2.7",
    "@keystatic/astro": "^5.1.0",
    "@keystatic/core": "^0.5.50",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^6.2.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.2.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3"
  }
}
